    "All on-device. Your logs never leave your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All on-device. Your logs never leave your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf deinem Gerät. Deine Einträge verlassen dein iPhone nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて端末内で処理します。記録がiPhoneの外に送信されることはありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en el dispositivo. Tus registros nunca dejan tu teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sul dispositivo. I tuoi registri non lasciano mai il telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko odbywa się na urządzeniu. Twoje wpisy nie opuszczają telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden az eszközödön történik. A bejegyzéseid nem hagyják el a telefonodat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tapahtuu laitteellasi. Kirjaukset eivät poistu puhelimestasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt skjer på enheten. Registreringene dine forlater aldri telefonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt behandles på enheden. Dine registreringer forlader aldrig telefonen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё обрабатывается на устройстве. Твои записи не покидают телефон."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é processado no dispositivo. Os teus registos nunca saem do telemóvel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе обробляється на пристрої. Твої записи не залишають телефон."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est traité sur l’appareil. Vos notes ne quittent jamais votre téléphone."
          }
        }
      }
    },
