    "Are your headaches typically on one side of your head?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are your headaches typically on one side of your head?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du meist auf einer Kopfseite Kopfschmerzen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛は通常、頭の片側に起こりますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Normalmente te duele un solo lado de la cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito il mal di testa si presenta su un solo lato della testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy zwykle boli cię jedna strona głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általában a fejed egyik oldalán fáj?"
          }
        },
        "fi": {
