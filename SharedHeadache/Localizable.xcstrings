    "Pro checks your local forecast and only pings when your logs support the pressure, AQI, or timing pattern behind the alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro checks your local forecast and only pings when your logs support the pressure, AQI, or timing pattern behind the alert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro überprüft Ihre lokale Prognose und pings nur, wenn Ihre Protokolle den Druck, AQI oder das Timingmuster hinter der Warnung unterstützen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロは、ログが圧力、AQI、またはアラートの背後にあるタイミングパターンをサポートしたときに、ローカルの予測とpingsだけをチェックします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro comprueba su pronóstico local y sólo pings cuando sus registros soportan la presión, AQI, o patrón de tiempo detrás de la alerta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro controlla le tue previsioni locali e solo i pings quando i tuoi registri supportano la pressione, AQI, o il modello di temporizzazione dietro l'avviso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro sprawdza lokalne prognozy i tylko pingi, gdy logi wspierają ciśnienie, AQI, lub schemat czasowy za alarmem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ellenőrzi a helyi előrejelzést, és csak pings, ha a naplók támogatják a nyomást, AQI, vagy időzítési mintát mögött a figyelmeztető."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tarkistaa paikallisen ennusteen ja vain pings kun lokit tukevat painetta, AQI, tai ajoitus kuvio takana hälytys."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kontrollerer din lokale prognose og bare pings når loggene støtter trykket, AQI eller timing mønster bak varslingen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kontrollerer din lokale prognose og kun pings, når dine logs understøtter trykket, AQI, eller timing mønster bag alarmen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro проверяет ваш локальный прогноз и пинг только тогда, когда ваши журналы поддерживают давление, AQI или схему времени за оповещением."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro verifica sua previsão local e apenas pings quando seus logs suportam a pressão, AQI, ou padrão de tempo atrás do alerta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про перевіряє ваш локальний прогноз і тільки пінги, коли ваші колоди підтримують тиск, AQI або timing з оповіщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vérifie vos prévisions locales et pings seulement lorsque vos journaux supportent la pression, AQI, ou le schéma de synchronisation derrière l'alerte."
          }
        }
      }
    },
