    "Use the Headache button on the One Tap tab and the app will start building a timeline you can share with your doctor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Headache button on the One Tap tab and the app will start building a timeline you can share with your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Kopfschmerztaste auf der Registerkarte One Tap und die App beginnt mit dem Aufbau einer Zeitleiste, die Sie mit Ihrem Arzt teilen können."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップタブとアプリの頭痛ボタンを使用して、医師と共有できるタイムラインを構築します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el botón Headache en la pestaña One Tap y la aplicación comenzará a crear una línea de tiempo que puede compartir con su médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare il pulsante Headache sulla scheda One Tap e l'applicazione inizierà a costruire una linea temporale che è possibile condividere con il medico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisku Ból głowy w zakładce One Tap, a aplikacja rozpocznie budowę linii czasowej, którą możesz podzielić się z lekarzem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a Fejfájás gombot az One Tap fülén, és az alkalmazás elkezd építeni egy idővonalat, amit megoszthat orvosával."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Päänsärky-painiketta One Tap -välilehdessä ja sovellus alkaa rakentaa aikajanaa, jonka voit jakaa lääkärisi kanssa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk hodepineknappen på fanen One Tap og appen vil begynne å bygge en tidslinje du kan dele med legen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug knappen Hovedpine på fanebladet One Tap, og appen vil begynde at bygge en tidslinje, du kan dele med din læge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте кнопку Headache на вкладке One Tap, и приложение начнет создавать временную шкалу, которой вы можете поделиться со своим врачом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão Cefaleia na aba Um Toque e o aplicativo começará a construir uma linha do tempo que você pode compartilhar com seu médico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте кнопку головного болю на вкладці One Tap і додаток почне будувати часову лінію, яку ви можете поділитися з лікарем."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton Cache-tête de l'onglet One Tap et l'application va commencer à construire une chronologie que vous pouvez partager avec votre médecin."
          }
        }
      }
    },
