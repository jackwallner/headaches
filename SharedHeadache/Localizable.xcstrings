    "A few quick questions help Patterns highlight areas you may want to explore. Take it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few quick questions help Patterns highlight areas you may want to explore. Take it anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar kurze Fragen helfen Patterns, Bereiche hervorzuheben, die Sie möglicherweise erkunden möchten. Nehmen Sie es jederzeit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの簡単な質問は、パターンが探したい領域を強調するのに役立ちます。 お問い合わせ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas preguntas rápidas ayudan a Patterns a destacar áreas que usted puede querer explorar. Tómalo en cualquier momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune domande rapide aiutano Patterns evidenziare le aree che si può desiderare di esplorare. Prendila quando vuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka szybkich pytań pomaga Wzorce podkreślać obszary, które mogą chcieć zbadać. Bierz kiedy chcesz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány gyors kérdés segít a mintáknak kiemelni azokat a területeket, amelyeket érdemes felfedezni. Bármikor beveheted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama nopea kysymys auttaa Kuviot korostaa alueita saatat haluta tutkia. Ota se milloin vain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen raske spørsmål hjelper Mønster markere områder du kanskje vil utforske. Ta det når som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par hurtige spørgsmål hjælpe Mønstre fremhæve områder, du måske ønsker at udforske. Tag den når som helst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько быстрых вопросов помогут Patterns выделить области, которые вы, возможно, захотите изучить. В любое время."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas perguntas rápidas ajudam Padrões destacar áreas que você pode querer explorar. Leve-o quando quiser."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька оперативних питань допоможуть Візерунки виділити ділянки, які ви можете вивчити. В будь-який час."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques questions rapides aident les modèles à mettre en évidence les domaines que vous souhaitez explorer. Prends-le quand tu veux."
          }
        }
      }
    },
