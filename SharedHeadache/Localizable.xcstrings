    "You stay headache-free on %@ of days with %@, the best of any condition tracked. Overall you log a headache on %@ of days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stay headache-free on %@ of days with %@, the best of any condition tracked. Overall you log a headache on %@ of days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben kopfschmerzfrei auf %@ von Tagen mit %@, das Beste aus jedem Zustand verfolgt. Insgesamt protokollieren Sie Kopfschmerzen auf %@ von Tagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では、%@では、任意の条件が追跡された最高の状態で頭痛なし滞在します。 全体的には、%@の日に頭痛を記録します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted permanece sin dolor de cabeza en %@ de días con %@, el mejor de cualquier condición rastreada. En general se registra un dolor de cabeza en %@ de días."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani senza mal di testa su %@ di giorni con %@, il meglio di qualsiasi condizione tracciata. Nel complesso si registra un mal di testa su %@ di giorni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostajesz bez głowy na %@ dni z %@, najlepszy z każdego stanu śledzone. Ogólnie rzecz biorąc, na %@ zanotować ból głowy dni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön marad fej-mentes a %@ napok %@, a legjobb minden feltétel nyomon követése. Összességében a fejfájás a %@ napok."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyt päänsärytön %@ päivät %@, paras tahansa kunnossa seurataan. Kaiken kaikkiaan kirjaat päänsärky %@ päivät."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du forblir hodepine-fri på %@ av dager med %@, det beste av alle betingelser sporet. Generelt logger du en hodepine på %@ av dager."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du forbliver heache- free på %@ dage med %@, den bedste af enhver tilstand spores. Samlet du logger en hovedpine på %@ af dage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы остаетесь без головной боли на %@ дней с %@, лучшим из всех отслеживаемых состояний. В целом вы регистрируете головную боль на %@ дней."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fica sem dor de cabeça em %@ de dias com %@, o melhor de qualquer condição rastreado. No geral, tem uma dor de cabeça no %@ de dias."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви залишаєтеся без головного болю на %@ днів з %@, кращим з будь-якого стану відстежується. У вас є головний біль на %@ днів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous restez sans mal de tête sur %@ de jours avec %@, le meilleur de toute condition suivie. Dans l'ensemble, vous enregistrez une migraine sur %@ de jours."
          }
        }
      }
    },
    "Across %lld days with %@, headaches were logged on %@ of days, below the overall rate of %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
