            "state": "translated",
            "value": "6-hour pressure change (hPa) before each headache"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luftdruckänderung in den 6 Stunden vor jedem Eintrag (hPa)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を記録する前の6時間の気圧変化（hPa）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de presión atmosférica (hPa) en las 6 horas previas a cada dolor de cabeza"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Variazione della pressione atmosferica (hPa) nelle 6 ore prima di ogni mal di testa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana ciśnienia (hPa) w ciągu 6 godzin przed każdym bólem głowy"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Légnyomás-változás (hPa) a fejfájás előtti 6 órában"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmanpaineen muutos (hPa) kutakin päänsärkyä edeltävien 6 tunnin aikana"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endring i lufttrykk (hPa) de siste 6 timene før hver hodepine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring i lufttryk (hPa) i de 6 timer før hver hovedpine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение давления (гПа) за 6 часов до каждой головной боли"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Variação da pressão atmosférica (hPa) nas 6 horas anteriores a cada dor de cabeça"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна атмосферного тиску (hPa) за 6 годин до кожного головного болю"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
