    "# What this file is: one row per time you tapped Headache in the app. Each row is a timestamped snapshot of optional context, not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# What this file is: one row per time you tapped Headache in the app. Each row is a timestamped snapshot of optional context, not a diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Was diese Datei ist: eine Zeile pro Zeit, wenn Sie Kopfschmerz in der App angetippt haben. Jede Zeile ist eine zeitgestempelte Momentaufnahme des optionalen Kontexts, keine Diagnose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# このファイルが何であるか: アプリ内の Headache をタップした時間ごとに 1 列。 各行は、診断ではなく、任意のコンテキストのタイムスタンプされたスナップショットです。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# What this file is: one row per time you tapped Headache in the app. Cada fila es una instantánea atemporal del contexto opcional, no un diagnóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Che cos'è questo file: una riga per volta che hai toccato Headache nell'app. Ogni riga è un'istantanea timestamp di contesto opzionale, non una diagnosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Czym jest ten plik: jeden wiersz na raz, gdy dotknąłeś Headache w aplikacji. Każdy wiersz jest migawką oznaczoną czasem, a nie diagnozą."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Mi ez a fájl: egy sor egy alkalommal koppintottál Fejfájás az alkalmazás. Minden sor egy időbélyegző pillanatfelvétel, nem egy diagnózis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Mitä tämä tiedosto on: yksi rivi per kerta kun nappasit Päänsärky sovellus. Jokainen rivi on aikaleimattu tilannekuva, ei diagnoosi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Hva denne filen er: én rad per gang du trykker hodepine i appen. Hver rad er et tidsstemplet øyeblikksbilde av valgfri kontekst, ikke en diagnose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Hvad denne fil er: en række per gang du tappet Hovedpine i appen. Hver række er et tidsstemplet øjebliksbillede af valgfri kontekst, ikke en diagnose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Что это за файл: один ряд за раз, когда вы нажали Головную боль в приложении. Каждая строка представляет собой временный снимок необязательного контекста, а не диагноза."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# O que este arquivo é: uma linha por vez você tocou Cefaleia no aplicativo. Cada linha é um instantâneo cronometrado de contexto opcional, não um diagnóstico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Який цей файл: один рядок за раз, коли ви торкнулися головного болю в додатку. Кожен ряд - це часовий знімок додаткового контексту, не діагноз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Qu'est-ce que ce fichier : une ligne par fois que vous avez tapé Headache dans l'application. Chaque ligne est un instantané horodaté du contexte optionnel, pas un diagnostic."
          }
        }
      }
    },
    "# Time fields include the UTC timestamp, timezone ID, weekday name, hour and minute, and the stable part_of_day value.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Time fields include the UTC timestamp, timezone ID, weekday name, hour and minute, and the stable part_of_day value."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zeitfelder umfassen den UTC-Zeitstempel, die Zeitzonen-ID, den Wochentagsnamen, Stunde und Minute und den stabilen Wert part of day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# タイムフィールドには、UTCタイムスタンプ、タイムゾーンID、平日名、時間と分、および安定したpart of day値が含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de tiempo incluyen la UTC timetamp, timezone ID, nombre de semana, hora y minuto, y el valor de part of day estable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi del tempo includono il timestamp UTC, l'ID del fuso orario, il nome del giorno della settimana, l'ora e il minuto, e il valore di part of day stabile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola czasowe zawierają znacznik czasu UTC, identyfikator strefy czasowej, nazwę dnia powszedniego, godzinę i minutę oraz stałą wartość części _ of _ day."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Időmezők közé tartozik az UTC időbélyeg, időzóna azonosító, hétköznap neve, óra és perc, és a stabil rész _ of _ day érték."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Aikakentät sisältävät UTC aikaleima, aikavyöhyke ID, arkipäivän nimi, tunti ja minuutti, ja vakaa osa of day arvo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tidsfeltene inkluderer UTC tidsstempel, tidssone-ID, hverdagsnavn, time og minutt og stabil del of day-verdi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tidsfelter omfatter UTC tidsstempel, tidszone ID, ugedag navn, time og minut, og den stabile del _ af _ dag værdi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля времени включают временную метку UTC, идентификатор часовой зоны, имя дня недели, час и минуту и стабильное значение части дня."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de tempo incluem o horário UTC, o ID do fuso horário, o nome do dia da semana, hora e minuto, e o valor estável part of day."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Часові поля включають в себе UTC timestamp, timezone ID, імена тижня, годину і хвилину, і стабільну частину за добу значення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs horaires comprennent l'horodatage UTC, l'ID du fuseau horaire, le nom de la semaine, l'heure et la minute et la valeur de la partie stable de jour."
          }
        }
      }
    },
    "# Health fields include activity, sleep, heart, breathing, audio, mindful minutes, workouts, intake, blood pressure, blood glucose, daylight, and cycle data when Apple Health access is allowed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Health fields include activity, sleep, heart, breathing, audio, mindful minutes, workouts, intake, blood pressure, blood glucose, daylight, and cycle data when Apple Health access is allowed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Gesundheitsfelder umfassen Aktivität, Schlaf, Herz, Atmung, Audio, achtsame Minuten, Workouts, Einnahme, Blutdruck, Blutzucker, Tageslicht und Zyklusdaten, wenn Apple Health Zugang erlaubt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 健康フィールドには、活動、睡眠、心、呼吸、オーディオ、マインドフルな分、ワークアウト、摂取量、血圧、血糖値、日光、およびApple Healthアクセスが許されるときにサイクルデータが含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de salud incluyen actividad, sueño, corazón, respiración, audio, minutos mentales, entrenamientos, ingesta, presión arterial, glucosa en sangre, luz del día y datos del ciclo cuando se permite el acceso Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi di salute includono attività, sonno, cuore, respirazione, audio, minuti consapevoli, allenamenti, assunzione, pressione sanguigna, glucosio nel sangue, luce del giorno e dati del ciclo quando è consentito l'accesso Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola zdrowia obejmują aktywność, sen, serce, oddychanie, audio, pamiętne minuty, treningi, spożycie, ciśnienie krwi, poziom glukozy we krwi, światło dzienne i dane cyklu, gdy dostęp do Apple Health jest dozwolony."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Egészségügyi mezők közé tartozik aktivitás, alvás, szív, légzés, hang, tudatos percek, edzések, bevitel, vérnyomás, vércukorszint, nappal, és ciklus adatok, amikor a Apple Health hozzáférés megengedett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Terveyskentät sisältävät aktiivisuutta, unta, sydäntä, hengitystä, ääntä, harkittuja minuutteja, liikuntaa, saantia, verenpainetta, veren glukoosia, päivänvaloa, ja kierron tietoja, kun Apple Health pääsy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Helsefelt inkluderer aktivitet, søvn, hjerte, puste, lyd, tankefulle minutter, trening, inntak, blodtrykk, blodsukker, dagslys og syklusdata når Apple Health-tilgang er tillatt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Sundhed felter omfatter aktivitet, søvn, hjerte, vejrtrækning, lyd, opmærksomme minutter, træning, indtag, blodtryk, blodglukose, dagslys, og cyklus data, når Apple Health adgang er tilladt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля здоровья включают активность, сон, сердце, дыхание, аудио, осознанные минуты, тренировки, потребление, кровяное давление, глюкозу крови, дневной свет и данные цикла, когда разрешен доступ Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de saúde incluem atividade, sono, coração, respiração, áudio, minutos minuciosos, exercícios, ingestão, pressão arterial, glicemia, luz do dia, e dados de ciclo quando Apple Health acesso é permitido."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля охорони здоров'я включають в себе активність, сон, серце, дихання, аудіо, розумові хвилини, тренування, поглинання, артеріальний тиск, глюкоза крові, денне світло і цикл даних, коли Apple Health доступ допускається."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les domaines de santé comprennent l'activité, le sommeil, le coeur, la respiration, l'audio, les minutes conscientes, les séances d'entraînement, l'apport, la pression artérielle, la glycémie, la lumière du jour et les données du cycle lorsque Apple Health est autorisé."
          }
        }
      }
    },
    "# Environment fields include location, weather, temperature, humidity, pressure, precipitation, wind, cloud cover, UV, dew point, air quality, pollutants, and pollen when available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Environment fields include location, weather, temperature, humidity, pressure, precipitation, wind, cloud cover, UV, dew point, air quality, pollutants, and pollen when available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Umweltfelder umfassen Standort, Wetter, Temperatur, Feuchtigkeit, Druck, Niederschlag, Wind, Wolkendecke, UV, Taupunkt, Luftqualität, Schadstoffe und Pollen, wenn verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 環境分野には、位置、天候、温度、湿度、圧力、降水量、風、雲カバー、UV、露点、空気品質、汚染物質、および花粉が含まれています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de medio ambiente incluyen localización, clima, temperatura, humedad, presión, precipitación, viento, cubierta de la nube, UV, punto de rocío, calidad del aire, contaminantes y polen cuando esté disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi dell'ambiente includono ubicazione, tempo, temperatura, umidità, pressione, precipitazioni, vento, copertura nuvolosa, UV, punto di rugiada, qualità dell'aria, inquinanti e polline quando disponibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola środowiska obejmują lokalizację, pogodę, temperaturę, wilgotność, ciśnienie, opady atmosferyczne, wiatr, pokrywę chmur, UV, punkt rosy, jakość powietrza, zanieczyszczenia i pyłek, jeśli jest dostępny."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Környezeti mezők közé tartozik a hely, időjárás, hőmérséklet, páratartalom, nyomás, csapadék, szél, felhőtakaró, UV, harmatpont, levegőminőség, szennyező anyagok, és pollen, ha rendelkezésre áll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ympäristökenttiä ovat sijainti, sää, lämpötila, kosteus, paine, sademäärä, tuuli, pilvipeite, UV, kastepiste, ilmanlaatu, saasteet ja siitepöly, jos saatavilla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Miljøfeltene inkluderer plassering, vær, temperatur, fuktighet, trykk, nedbør, vind, skydekke, UV, Duggpunkt, luftkvalitet, forurensninger og pollen når det er tilgjengelig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Miljøfelter omfatter placering, vejr, temperatur, fugtighed, tryk, nedbør, vind, skydække, UV, dugpunkt, luftkvalitet, forurenende stoffer, og pollen, når det er muligt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля окружающей среды включают местоположение, погоду, температуру, влажность, давление, осадки, ветер, облачный покров, УФ, точку росы, качество воздуха, загрязняющие вещества и пыльцу, когда они доступны."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Campos ambientais incluem localização, tempo, temperatura, umidade, pressão, precipitação, vento, cobertura de nuvens, UV, ponto de orvalho, qualidade do ar, poluentes e pólen quando disponível."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля навколишнього середовища включають розташування, погода, температура, вологість, тиск, опади, вітер, хмарний покрив, УФ, точка відключення, якість повітря, забруднюючі речовини і пилок при наявності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs d'environnement comprennent l'emplacement, la météo, la température, l'humidité, la pression, les précipitations, le vent, la couverture nuageuse, les UV, le point de rosée, la qualité de l'air, les polluants et le pollen lorsque disponibles."
          }
        }
      }
    },
    "# Device fields include battery level, charging, low power mode, and motion activity captured when you logged the headache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Device fields include battery level, charging, low power mode, and motion activity captured when you logged the headache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Gerätefelder umfassen Batteriestand, Aufladen, Stromsparmodus und Bewegungsaktivität, die erfasst wurden, wenn Sie die Kopfschmerzen protokolliert haben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# デバイスフィールドには、バッテリーレベル、充電、低電力モード、および頭痛を記録したときにキャプチャされたモーションアクティビティが含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de dispositivos incluyen el nivel de batería, la carga, el modo de baja potencia y la actividad de movimiento capturado cuando se registró el dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi dei dispositivi includono il livello della batteria, la ricarica, la modalità di bassa potenza e l'attività di movimento catturata quando hai registrato il mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola urządzeń obejmują poziom baterii, ładowanie, tryb niskiej mocy, i aktywność ruchu przechwytywane podczas logowania ból głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Eszközök mezők közé tartozik az akkumulátor szintje, töltés, alacsony teljesítmény üzemmód, és mozgás aktivitás rögzített, amikor bejelentkezett a fejfájás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Laitekentät sisältävät akun tason, latauksen, alhaisen tehon tilassa, ja liike aktiivisuutta kiinni, kun kirjasit päänsärky."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Enhet feltene inkluderer batterinivå, lading, lav strømmodus, og bevegelse aktivitet fanget når du logget hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Enhedsfelter omfatter batteriniveau, opladning, lav strømtilstand, og bevægelse aktivitet fanget, når du loggede hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля устройств включают уровень батареи, зарядку, режим низкой мощности и активность движения, захваченную при регистрации головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos do dispositivo incluem o nível da bateria, carregamento, modo de baixa potência e atividade de movimento capturado quando você registrou a dor de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля пристроїв включають рівень акумулятора, зарядку, режим низької потужності і активність руху, захоплені при введенні головного болю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs de l'appareil comprennent le niveau de la batterie, la charge, le mode faible puissance, et l'activité de mouvement capturée lorsque vous avez enregistré le mal de tête."
          }
        }
      }
    },
    "# Status fields show whether capture, Health, and environment context was available. Message fields explain missing context or errors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Status fields show whether capture, Health, and environment context was available. Message fields explain missing context or errors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Statusfelder zeigen an, ob der Erfassungs-, Gesundheits- und Umgebungskontext verfügbar war. Nachrichtenfelder erklären fehlenden Kontext oder Fehler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# ステータスフィールドは、キャプチャ、健康、環境のコンテキストが利用可能なかどうかを示します。 メッセージフィールドは、欠如したコンテキストやエラーを説明します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de estado muestran si el contexto de captura, salud y medio ambiente estaba disponible. Los campos de mensajes explican el contexto o errores perdidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi di stato mostrano se il contesto di cattura, salute e ambiente era disponibile. I campi dei messaggi spiegano il contesto o gli errori mancanti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola statusu pokazują, czy kontekst przechwytywania, zdrowia i środowiska był dostępny. Pola wiadomości wyjaśniają brakujący kontekst lub błędy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Status mezők azt mutatják, hogy az elfogás, az egészség és a környezet környezetben állt rendelkezésre. Az üzenetmezők megmagyarázzák a hiányzó szövegkörnyezetet vagy hibákat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tilan kentät osoittavat, oliko kaappaus, terveys ja ympäristö konteksti saatavilla. Viestikentät selittävät puuttuvia kontekstia tai virheitä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Status felter viser om fangst, helse og miljø sammenheng var tilgjengelig. Meldingsfelt forklarer manglende kontekst eller feil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Status felter viser, om fangst, Sundhed, og miljø sammenhæng var tilgængelig. Brevfelter forklarer manglende sammenhæng eller fejl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля статуса показывают, был ли доступен контекст захвата, здоровья и окружающей среды. Поля сообщений объясняют недостающий контекст или ошибки."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de status mostram se o contexto de captura, saúde e ambiente estava disponível. Os campos da mensagem explicam o contexto ou os erros em falta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля стану показують, чи є захоплення, здоров'я та контекст навколишнього середовища. Повідомлення про відсутність контексту або помилок."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs de statut indiquent si le contexte de capture, de santé et d'environnement était disponible. Les champs de message expliquent le contexte manquant ou les erreurs."
          }
        }
      }
    },
