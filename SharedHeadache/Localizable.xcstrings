    "Pressure is forecast to fall by %@ hPa in the next 24 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure is forecast to fall by %@ hPa in the next 24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Druck wird voraussichtlich in den nächsten 24 Stunden um %@ hPa fallen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧力は、次の24時間で%@ hPaによって落下する予報です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prevé que la presión caerá por %@ hPa en las próximas 24 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione è prevista per cadere da %@ hPa nelle prossime 24 ore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewiduje się spadek ciśnienia przez %@ hPa w ciągu najbliższych 24 godzin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ hPa a következő 24 órában csökken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paineen ennustetaan laskevan %@ hPa seuraavan 24 tunnin aikana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk er forventet å falle av %@ hPa i løpet av de neste 24 timene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykket forventes at falde af %@ hPa i de næste 24 timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается, что давление снизится на %@ hPa в ближайшие 24 часа."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevê-se que a pressão caia em %@ hPa nas próximas 24 horas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиск є прогнозом падіння %@ hPa в найближчі 24 години."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression devrait diminuer de %@ hPa dans les 24 prochaines heures."
          }
        }
      }
    },
