    "Notifications are off. Alerts can't be delivered until you enable them in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Alerts can't be delivered until you enable them in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind ausgeschaltet. Warnungen können nicht geliefert werden, bis Sie sie in den Einstellungen aktivieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は消えます。 アラートは、設定を有効にするまで配信できません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay notificaciones. Las alertas no se pueden enviar hasta que las habilita en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono spente. Gli avvisi non possono essere consegnati finché non li si attiva in Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia wyłączone. Wpisy nie mogą być dostarczane, dopóki nie włączysz ich w Ustawieniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentés lefújva. A figyelmeztetéseket nem lehet átadni, amíg a Beállítások nem engedélyezhetők."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitus on peruttu. Hälytyksiä ei voi toimittaa, ennen kuin ne on otettu käyttöön Asetuksissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er av. Varsler kan ikke leveres før du aktiverer dem i Innstillinger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelserne er aflyst. Indberetninger kan ikke leveres, før du aktiverer dem i Indstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Оповещения не могут быть доставлены, пока вы не включите их в настройках."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas. Os alertas não podem ser enviados até que você os habilite em Configurações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення вимкнено. Поставки не можуть бути доставлені до тих пір, поки ви не зможете їх у налаштуваннях."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont éteintes. Les alertes ne peuvent pas être livrées tant que vous ne les activez pas dans Paramètres."
          }
        }
      }
    },
    "Notification permission hasn't been granted yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission hasn't been granted yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigungsberechtigung wurde noch nicht erteilt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知権限はまだ付与されていません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha concedido el permiso de notificación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso di notifica non è ancora stato concesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie nie zostało jeszcze udzielone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítési engedélyt még nem adták meg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituslupaa ei ole vielä myönnetty."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingsgodkjennelse er ikke gitt ennå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelse er ikke givet endnu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на уведомление еще не предоставлено."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autorização de notificação ainda não foi concedida."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не наданий дозвіл на виправлення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La notification n'a pas encore été accordée."
          }
        }
      }
    },
    "Location is off. Without it the app can't fetch your local forecast.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off. Without it the app can't fetch your local forecast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist ausgeschaltet. Ohne sie kann die app ihre lokale prognose nicht abrufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所在地がオフです。 アプリがローカルの予報を得ることができません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está fuera. Sin ella la aplicación no puede conseguir su pronóstico local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è spenta. Senza di esso l'applicazione non può prendere le vostre previsioni locali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja wyłączona. Bez niej aplikacja nie może pobrać lokalnych prognoz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyszín rossz. Enélkül az alkalmazás nem tudja megszerezni a helyi előrejelzést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijainti on pielessä. Ilman sitä sovellus ei voi hakea paikallista ennustetta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stedet er av. Uten den kan appen ikke hente din lokale prognoser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeringen er aflyst. Uden det kan app 'en ikke hente din lokale prognose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месторасположение отключено. Без него приложение не сможет получить ваш местный прогноз."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização está desligada. Sem ele, o aplicativo não pode obter sua previsão local."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташування вимкнено. Не пропустіть своє локальне прогнозування."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement est arrêté. Sans elle, l'application ne peut pas récupérer vos prévisions locales."
          }
        }
      }
    },
    "Notifications are not enabled. Open iPhone Settings and allow notifications for One Tap Headache Tracker.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not enabled. Open iPhone Settings and allow notifications for One Tap Headache Tracker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind nicht aktiviert. Öffnen Sie die iPhone-Einstellungen und erlauben Sie Benachrichtigungen für One Tap Headache Tracker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は有効ではありません。 iPhone設定を開き、One Tap Headache Trackerの通知を許可します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
