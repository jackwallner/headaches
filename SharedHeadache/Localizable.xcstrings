    "Couldn't load purchase options. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load purchase options. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte Kaufoptionen nicht laden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入オプションをロードできません。 接続を確認してもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podía cargar opciones de compra. Comprueba tu conexión e intenta de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ho potuto caricare le opzioni di acquisto. Controlla la connessione e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogłem załadować opcji zakupu. Sprawdź połączenie i spróbuj jeszcze raz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtam megtölteni a vásárlási lehetőségeket. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "En voinut ladata ostovaihtoehtoja. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn kjøpsalternativer. Sjekk tilkoblingen din og prøv igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke indlæse købsmuligheder. Tjek din forbindelse og prøv igen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не смог загрузить варианты покупки. Проверьте свою связь и попробуйте еще раз."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar opções de compra. Verifique sua conexão e tente novamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не завантажуйте опції покупки. Перевірити підключення і спробувати знову."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les options d'achat. Vérifiez votre connexion et essayez à nouveau."
          }
        }
      }
    },
    "Couldn't refresh your subscription status. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
