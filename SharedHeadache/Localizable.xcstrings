    "Free for %@, then %@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings → Apple ID → Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %@, then %@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings → Apple ID → Subscriptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos für %@, dann %@. Auto-Erneuerung, sofern nicht mindestens 24 Stunden vor dem Ende des laufenden Zeitraums storniert. Verwalten oder abbrechen in Einstellungen → Apple ID → Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、そして%@のために放して下さい。 現在の期間の最後に24時間前にキャンセルされない限り、自動更新。 設定 → Apple ID → サブスクリプションの管理またはキャンセル。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis para %@, luego %@. Auto-renovaciones a menos que se cancele al menos 24 horas antes del final del período actual. Administrar o cancelar en Ajustes → Apple ID → Suscripciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %@, poi %@. Rinnovi auto a meno che non siano annullati almeno 24 ore prima della fine del periodo corrente. Gestire o cancellare in Impostazioni → Apple ID → Abbonamenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za darmo dla %@, a następnie %@. Auto- renews chyba, że anulowane co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzanie lub anulować w Ustawienia → Apple ID → Subskrypcje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingyenes %@, majd %@. Auto-news, kivéve, ha az aktuális időszak vége előtt legalább 24 órával lemondják. A beállítások kezelése vagy törlése → Apple ID → Feliratkozások."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen %@, sitten %@. Automaattiset renews-päivitykset, ellei niitä peruuteta vähintään 24 tuntia ennen kuluvan kauden päättymistä. Hallitse tai peruuta Asetukset → Apple ID → Tilaukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for %@, deretter %@. Auto-renews med mindre det kanselleres minst 24 timer før utgangen av gjeldende periode. Administrer eller avbryt i innstillinger → Apple ID → Abonnementer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for %@, derefter %@. Auto-nyheder, medmindre de er aflyst mindst 24 timer før udløbet af denne periode. Administrer eller annuller i Indstillinger → Apple ID → Abonnementer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно для %@, затем %@. Автообновление, если оно не отменено по крайней мере за 24 часа до окончания текущего периода. Управлять или отменять в Настройках → Apple ID → Подписки."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Livre para %@, depois %@. Renova automaticamente a menos que tenha sido cancelada pelo menos 24 horas antes do final do período atual. Gerencie ou cancele em Configurações → Apple ID → Subscrições."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно для %@, потім %@. Автоновини, якщо скасовано принаймні 24 години до закінчення поточного періоду. Керування або скасування в налаштуваннях → Apple ID → Абонементи."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour %@, puis %@. Auto-renews sauf annulation au moins 24 heures avant la fin de la période en cours. Gérer ou annuler dans Paramètres → Apple ID → Abonnements."
          }
        }
      }
    },
