    "Use a test alert to confirm notifications are working before relying on a forecast alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a test alert to confirm notifications are working before relying on a forecast alert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen Testalarm, um zu bestätigen, dass Benachrichtigungen funktionieren, bevor Sie sich auf einen Prognosealarm verlassen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測アラートに依存する前に通知が動作していることを確認するためにテストアラートを使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una alerta de prueba para confirmar las notificaciones están funcionando antes de confiar en una alerta de pronóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare un avviso di prova per confermare le notifiche stanno lavorando prima di affidarsi a un avviso di previsione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W celu potwierdzenia powiadomień należy zastosować wpis testowy, zanim będzie on oparty na ostrzeżeniu prognozowanym."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon vizsgálati figyelmeztetést annak megerősítésére, hogy az értesítések működnek, mielőtt előrejelzésre hivatkoznának."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testaushälytyksen avulla voidaan vahvistaa, että ilmoitukset toimivat ennen kuin ne perustuvat ennustettuun kuulutukseen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en testvarsel for å bekrefte varsler fungerer før du er avhengig av en prognosevarsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en prøvningsalarm til at bekræfte, at meddelelserne fungerer, før den er baseret på en forventet indberetning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте тестовое оповещение для подтверждения того, что уведомления работают, прежде чем полагаться на прогнозное оповещение."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizar um alerta de teste para confirmar que as notificações estão funcionando antes de confiar em um alerta de previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте тестову оповіщення, щоб підтвердити повідомлення, які працюють перед тим, як відновитися на прогнозі повідомлення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une alerte de test pour confirmer que les notifications fonctionnent avant de compter sur une alerte de prévision."
          }
        }
      }
    },
    "Enable Proactive Alerts first, then send a test notification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Proactive Alerts first, then send a test notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie zuerst proaktive Alarme und senden Sie dann eine Testbenachrichtigung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロアクティブなアラートを最初に有効化し、テスト通知を送信します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar Alertas Proactivas primero, luego enviar una notificación de prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare avvisi proattivi prima, quindi inviare una notifica di prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz najpierw proaktywne alarmy, a następnie wyślij zgłoszenie testowe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először a Proactive Alerts engedélyezése, majd a teszt bejelentése."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota käyttöön ennakoivat hälytykset ensin ja lähetä sitten testausilmoitus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver Proactive Alerts først og send deretter et testvarsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér Proactive Alerts først og send derefter en testmeddelelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите проактивные оповещения, затем отправьте тестовое уведомление."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar Alertas Proativos primeiro, em seguida, envie uma notificação de teste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Proactive Alerts першим, після надсилання тестового повідомлення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les alertes proactives d'abord, puis envoyer une notification de test."
          }
        }
      }
    },
