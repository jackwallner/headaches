    "Use a CSV exported from this app. Other CSVs are not guaranteed to match the columns we expect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a CSV exported from this app. Other CSVs are not guaranteed to match the columns we expect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein CSV, das aus dieser App exportiert wurde. Andere CSVs entsprechen nicht garantiert den von uns erwarteten Spalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリからエクスポートしたCSVを使用します。 その他のCSVは、期待する列にマッチする保証はありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un CSV exportado de esta aplicación. Otros CSVs no están garantizados para coincidir con las columnas que esperamos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare un CSV esportato da questa applicazione. Altri CSV non sono garantiti per abbinare le colonne che ci aspettiamo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj CSV wywożonego z tej aplikacji. Inne CSV nie są gwarantowane do dopasowania do kolumn, których oczekujemy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon ebből az alkalmazásból exportált CSV-t. Más CSV nem garantált, hogy megfeleljen a kívánt oszlopok."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä tästä sovelluksesta vietyä CSV:ää. Muut CSV:t eivät ole taattuja vastaamaan sarakkeita odotamme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en CSV eksportert fra denne appen. Andre CSV er ikke garantert til å matche kolonnene vi forventer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en CSV eksporteret fra denne app. Andre CSVs er ikke garanteret at matche kolonnerne vi forventer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте CSV, экспортированный из этого приложения. Другие CSV не гарантируют соответствие колонкам, которые мы ожидаем."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um CSV exportado deste aplicativo. Outros CSVs não são garantidos para corresponder às colunas que esperamos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте CSV, що експортується з цього додатка. Інше CSVs не гарантує, що ми очікуємо."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un CSV exporté depuis cette application. Les autres CSV ne sont pas garantis pour correspondre aux colonnes attendues."
          }
        }
      }
    },
    "Nothing happens until you confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing happens until you confirm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts passiert, bis Sie bestätigen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認まで何も起こらない"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada hasta que confirmes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non succede niente finché non confermi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie dzieje, dopóki nie potwierdzisz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem történik, amíg meg nem erősíted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei tapahdu ennen kuin vahvistat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting skjer før du bekrefter"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet sker før du bekræfter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не происходит, пока вы не подтвердите"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não acontece nada até confirmares."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо відбувається до підтвердження"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne se passe tant que vous n'avez pas confirmé"
          }
        }
      }
    },
    "You can cancel at any step before the final confirmation. Existing entries are never changed without your approval.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel at any step before the final confirmation. Existing entries are never changed without your approval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jederzeit vor der endgültigen Bestätigung absagen. Bestehende Einträge werden niemals ohne Ihre Zustimmung geändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終確認の前のキャンセルは可能です。 応募作品は、承認なく変更されることはありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede cancelar en cualquier paso antes de la confirmación final. Las entradas existentes nunca se cambian sin su aprobación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile annullare in qualsiasi momento prima della conferma finale. Le voci esistenti non sono mai cambiate senza la vostra approvazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz anulować na każdym etapie przed ostatecznym potwierdzeniem. Istniejące wpisy nigdy nie ulegają zmianie bez Twojej zgody."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A végső megerősítés előtt bármikor lemondhatja. A meglévő bejegyzések sosem változnak az engedélyed nélkül."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit peruuttaa milloin tahansa ennen lopullista vahvistusta. Olemassa olevat merkinnät eivät koskaan muutu ilman hyväksyntääsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kansellere når som helst før siste bekreftelse. Eksisterende oppføringer endres aldri uten din godkjenning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan annullere hvert skridt før den endelige bekræftelse. Eksisterende poster ændres aldrig uden din godkendelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить можно на любом этапе до окончательного подтверждения. Существующие записи никогда не меняются без вашего одобрения."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode cancelar a qualquer passo antes da confirmação final. As entradas existentes nunca são alteradas sem a sua aprovação."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете скасувати будь-який крок до остаточного підтвердження. Випробування записів не змінюється без узгодження."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
