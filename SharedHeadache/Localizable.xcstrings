    "Get a notification when forecast signals match your logged patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification when forecast signals match your logged patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie eine Benachrichtigung, wenn Prognosesignale Ihren protokollierten Mustern entsprechen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測信号が記録されたパターンに一致するときに通知を取得します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga una notificación cuando las señales de pronóstico coincidan con sus patrones registrados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando i segnali di previsione corrispondono ai tuoi modelli registrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj powiadomienie, gdy sygnały prognostyczne pasują do zapisanych wzorców."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítse, ha az előrejelzési jelek egyeznek a naplózott mintákkal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun ennustesignaalit vastaavat kirjautuneita kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få et varsel når prognosesignaler samsvarer med loggede mønstre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en meddelelse når prognosesignaler matcher dine loggede mønstre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите уведомление, когда прогнозные сигналы соответствуют вашим зарегистрированным шаблонам."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
