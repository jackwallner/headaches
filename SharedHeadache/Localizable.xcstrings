    "See patterns in your logs and get alerts based on your history, free for eligible new subscribers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See patterns in your logs and get alerts based on your history, free for eligible new subscribers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Muster in deinen Einträgen und erhalte darauf abgestimmte Hinweise. Für berechtigte neue Abonnenten kostenlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のパターンを確認し、履歴に基づく通知を受け取れます。対象となる新規登録者は無料です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta patrones en tus registros y recibe avisos basados en tu historial. Gratis para nuevos suscriptores que cumplan los requisitos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta gli andamenti nei tuoi registri e ricevi avvisi basati sul tuo storico. Gratis per i nuovi abbonati idonei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj wzorce w swoich wpisach i otrzymuj powiadomienia na podstawie historii. Bezpłatnie dla nowych subskrybentów spełniających warunki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerd meg a bejegyzéseid mintázatait, és kapj értesítéseket az előzmények alapján. Jogosult új előfizetőknek ingyenes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutki kirjauksiesi kuvioita ja saa historiaasi perustuvia ilmoituksia. Maksuton kelpoisille uusille tilaajille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i registreringene dine og få varsler basert på historikken. Gratis for kvalifiserte nye abonnenter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i dine registreringer, og få varsler baseret på din historik. Gratis for nye abonnenter, der opfylder betingelserne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучай закономерности в записях и получай уведомления на основе истории. Бесплатно для новых подписчиков, соответствующих условиям."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê padrões nos teus registos e recebe alertas com base no teu histórico. Gratuito para novos assinantes elegíveis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядай закономірності у своїх записах і отримуй сповіщення на їхній основі. Безкоштовно для відповідних нових підписників."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les tendances de vos notes et recevez des alertes basées sur votre historique. Gratuit pour les nouveaux abonnés éligibles."
          }
        }
      }
    },
    "See patterns in your logs and get weather alerts when your data supports them. Free until the trial ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See patterns in your logs and get weather alerts when your data supports them. Free until the trial ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Muster in deinen Einträgen und erhalte Wetterhinweise, wenn deine Daten sie stützen. Bis zum Ende des Probezeitraums kostenlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録からパターンを確認し、記録で裏付けられる場合に天気の通知を受け取れます。無料トライアル終了まで無料です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta patrones en tus registros y recibe avisos meteorológicos cuando tus datos los respalden. Gratis hasta que termine la prueba gratuita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta gli andamenti nei tuoi registri e ricevi avvisi meteo quando i dati li supportano. Gratis fino al termine della prova gratuita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj wzorce w swoich wpisach i otrzymuj powiadomienia pogodowe, gdy potwierdzają je dane. Bezpłatnie do końca okresu próbnego."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerd meg a bejegyzéseid mintázatait, és kapj időjárási értesítést, ha az adataid ezt alátámasztják. A próbaidőszak végéig ingyenes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutki kirjauksiesi kuvioita ja saa sääilmoituksia, kun tietosi tukevat niitä. Maksuton kokeilujakson loppuun asti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i registreringene dine og få værvarsler når dataene støtter dem. Gratis til prøveperioden er over."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i dine registreringer, og få vejrvarsler, når dine data understøtter dem. Gratis indtil prøveperioden slutter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучай закономерности в записях и получай погодные уведомления, когда это подтверждают данные. Бесплатно до конца пробного периода."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê padrões nos teus registos e recebe alertas meteorológicos quando os teus dados os sustentarem. Gratuito até ao fim do período experimental."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядай закономірності у своїх записах і отримуй сповіщення про погоду, якщо дані це підтверджують. Безкоштовно до завершення пробного періоду."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les tendances de vos notes et recevez des alertes météo lorsque vos données le justifient. Gratuit jusqu’à la fin de l’essai."
          }
        }
      }
    },
    "See what time, sleep, and weather patterns emerge from your %lld logged headache%@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what time, sleep, and weather patterns emerge from your %lld logged headache%@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, welche Muster aus %lld Kopfschmerz-Log%@ zu Uhrzeit, Schlaf und Wetter hervorgehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を%lld件記録しました%@。記録から時間帯、睡眠、天気に見られるパターンを確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre los patrones de horario, sueño y tiempo que aparecen en tus %lld registro%@ de dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri gli andamenti di orari, sonno e meteo nei tuoi %lld mal di testa registrat%@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj wzorce dotyczące pory dnia, snu i pogody na podstawie %lld zapisanych bólów głowy%@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerd meg, milyen időbeli, alvási és időjárási mintázatok rajzolódnak ki a %lld rögzített fejfájásodból%@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, millaisia ajankohta-, uni- ja sääkuvioita %lld kirjattua päänsärkyä%@ paljastavat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvilke mønstre for tidspunkt, søvn og vær som viser seg i de %lld registrerte hodepinene%@ dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvilke mønstre for tidspunkt, søvn og vejr der tegner sig ud fra dine %lld registrerede hovedpiner%@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономерности времени, сна и погоды по записям о головной боли: %lld (%@)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões de horário, sono e meteorologia nos registos de dores de cabeça: %lld (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономірності часу, сну й погоди у записах про головний біль: %lld (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendances d’horaire, de sommeil et de météo dans vos %lld notes (%@)."
          }
        }
      }
    },
