      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are working. Real alerts fire only when a forecast matches a supported personal signal from your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen funktionieren. Echte Alarme feuern nur, wenn eine Prognose mit einem unterstützten persönlichen Signal aus Ihren Protokollen übereinstimmt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が機能しています。 実際のアラートは、予測がログからサポートされている個人的な信号と一致する場合にのみ消火します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están funcionando. Alertas reales disparan sólo cuando un pronóstico coincide con una señal personal soportada de sus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche funzionano. Il reale avvisa il fuoco solo quando una previsione corrisponde a un segnale personale supportato dai vostri registri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia działają. Prawdziwe alarmy strzelać tylko wtedy, gdy prognoza pasuje do obsługiwanego sygnału osobistego z dzienników."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Működik a bejelentés. Valódi figyelmeztető jelzések csak akkor tüzelnek, ha az előrejelzés megegyezik a naplóban szereplő, támogatott személyes jelekkel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset toimivat. Oikea hälytys ampua vain, kun ennuste vastaa tuettua henkilökohtaista signaalia lokit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler fungerer. Ekte varsler brann bare når en prognose matcher et støttet personlig signal fra loggene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelelser virker. Rigtige advarsler brand kun, når en prognose matcher et understøttet personligt signal fra dine logfiler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления работают. Реальные оповещения загораются только тогда, когда прогноз соответствует поддерживаемому личному сигналу из ваших журналов."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão a funcionar. Alertas reais disparam apenas quando uma previsão corresponde a um sinal pessoal suportado de seus registros."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення про роботу. Реальні сповіщення про пожежу тільки тоді, коли прогноз відповідає підтримці особистого сигналу з вашого журналу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications fonctionnent. De vraies alertes ne font feu que lorsqu'une prévision correspond à un signal personnel pris en charge de vos journaux."
          }
        }
      }
    },
