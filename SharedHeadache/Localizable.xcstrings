    "Computed locally from your logged events. Descriptive only, not a clinical diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed locally from your logged events. Descriptive only, not a clinical diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Muster werden auf deinem Gerät aus deinen Einträgen berechnet. Diese Muster beschreiben deine Daten und sind keine medizinische Diagnose."
          }
        },
