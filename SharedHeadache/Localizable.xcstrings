    "Notifications are not enabled. Open iPhone Settings and allow notifications for One Tap Headache Tracker.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not enabled. Open iPhone Settings and allow notifications for One Tap Headache Tracker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Öffne die iPhone-Einstellungen und erlaube Mitteilungen für One Tap Headache Tracker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです。iPhoneの「設定」でOne Tap Headache Trackerの通知を許可してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Abre Ajustes del iPhone y permite las notificaciones de One Tap Headache Tracker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono attive. Apri Impostazioni su iPhone e consenti le notifiche per One Tap Headache Tracker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Otwórz Ustawienia na iPhonie i zezwól One Tap Headache Tracker na wysyłanie powiadomień."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések nincsenek bekapcsolva. Nyisd meg az iPhone Beállításokat, és engedélyezd az értesítéseket a One Tap Headache Tracker számára."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset eivät ole käytössä. Avaa iPhonen Asetukset ja salli One Tap Headache Trackerin ilmoitukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er ikke slått på. Åpne Innstillinger på iPhone og tillat varsler fra One Tap Headache Tracker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelelser er slået fra. Åbn Indstillinger på iPhone, og tillad meddelelser fra One Tap Headache Tracker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Открой Настройки iPhone и разреши уведомления для One Tap Headache Tracker."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Abre as Definições do iPhone e permite notificações para One Tap Headache Tracker."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Відкрий Параметри iPhone й дозволь сповіщення для One Tap Headache Tracker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Ouvrez Réglages sur l’iPhone et autorisez les notifications de One Tap Headache Tracker."
          }
        }
      }
    },
    "Notifications are off. Alerts can't be delivered until you enable them in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Alerts can't be delivered until you enable them in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Aktiviere sie in den Einstellungen, damit Hinweise gesendet werden können."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです。「設定」でオンにすると予報通知を受け取れます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes para recibir avisos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Attivale in Impostazioni per ricevere gli avvisi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Włącz je w Ustawieniach, aby otrzymywać powiadomienia o prognozie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. A Beállításokban kapcsold be őket az előrejelzési értesítések fogadásához."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat pois käytöstä. Ota ne käyttöön Asetuksissa, jotta saat ennusteilmoituksia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er slått av. Slå dem på i Innstillinger for å motta værvarsler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelelser er slået fra. Slå dem til under Indstillinger for at modtage vejrvarsler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Включи их в Настройках, чтобы получать уведомления по прогнозу."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Não poderás receber alertas até as ativares nas Definições."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Ти не отримуватимеш сповіщень, доки не ввімкнеш їх у Параметрах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Vous ne recevrez pas d’alertes avant de les activer dans Réglages."
          }
        }
      }
    },
    "Notifications are working. Real alerts fire only when a forecast matches a supported personal signal from your logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are working. Real alerts fire only when a forecast matches a supported personal signal from your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen funktionieren. Hinweise werden nur gesendet, wenn ein Prognosesignal zu einem Muster in deinen Einträgen passt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は利用できます。予報が記録に見られる信号と一致した場合に、予報通知が届きます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones funcionan. Solo recibirás avisos cuando la previsión coincida con una señal respaldada por tus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche funzionano. Riceverai avvisi solo quando le previsioni corrispondono a un segnale supportato dai tuoi registri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia działają. Otrzymasz je tylko wtedy, gdy prognoza będzie pasować do sygnału potwierdzonego w twoich wpisach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések működnek. Valódi értesítést csak akkor kapsz, ha az előrejelzés egyezik a bejegyzéseidben látható személyes jellel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset toimivat. Saat varsinaisen ilmoituksen vain, kun ennuste vastaa kirjauksissasi näkyvää henkilökohtaista signaalia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler fungerer. Du får et ekte varsel bare når værmeldingen samsvarer med et personlig signal i registreringene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelelser fungerer. Du får kun reelle varsler, når vejrudsigten matcher et personligt signal i dine registreringer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления работают. Обычное уведомление придёт, только если прогноз совпадёт с личным сигналом из твоих записей."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão a funcionar. Os alertas só são enviados quando a previsão corresponde a um sinal pessoal identificado nos teus registos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення працюють. Вони надходитимуть лише тоді, коли прогноз відповідатиме особистому сигналу, підтвердженому записами."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications fonctionnent. Les alertes ne sont envoyées que si les prévisions correspondent à un signal personnel relevé dans vos notes."
          }
        }
      }
    },
