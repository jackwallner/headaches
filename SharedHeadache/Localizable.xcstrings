            "state": "translated",
            "value": "Usługi lokalizacyjne są wyłączone dla tego urządzenia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyszíni szolgáltatások ki vannak kapcsolva az eszköz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän laitteen sijaintipalvelut on suljettu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasseringstjenester er slått av for denne enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placering tjenester er slukket for denne enhed."
          }
        },
        "ru": {
