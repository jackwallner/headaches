    "%@. One-time purchase. Lifetime access, no subscription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. One-time purchase. Lifetime access, no subscription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Einmalzahlung für dauerhaften Zugriff, ohne Abo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。買い切りです。サブスクリプションなしで継続して利用できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pago único. Acceso de por vida, sin suscripción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pagamento unico. Accesso a vita, senza abbonamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Płatność jednorazowa. Dostęp dożywotni, bez subskrypcji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Egyszeri vásárlás, örökös hozzáféréssel és előfizetés nélkül."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Kertaostos, elinikäinen käyttöoikeus ilman tilausta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Engangskjøp med livstidstilgang, uten abonnement."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Engangskøb med livstidsadgang, intet abonnement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Разовая покупка, пожизненный доступ без подписки."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Compra única. Acesso vitalício, sem assinatura."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Одноразова покупка. Довічний доступ без підписки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Achat unique. Accès à vie, sans abonnement."
          }
        }
      }
    },
