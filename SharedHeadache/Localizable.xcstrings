    "Pressure is forecast to fall by %@ hPa in the next %lld hours. Your logs show headaches on %lld of %lld similar days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure is forecast to fall by %@ hPa in the next %lld hours. Your logs show headaches on %lld of %lld similar days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Druck wird voraussichtlich um %@ hPa in den nächsten %lld Stunden fallen. Ihre Protokolle zeigen Kopfschmerzen auf %lld von %lld ähnlichen Tagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気圧は今後%@ hPa下がる予報です（次の%lld時間）。記録では、%lld/%lldの類似日で頭痛が記録されています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prevé que la presión caerá por %@ hPa en las próximas horas %lld. Sus registros muestran dolores de cabeza en %lld de %lld días similares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione è prevista per cadere da %@ hPa nelle prossime ore %lld. I tuoi registri mostrano mal di testa su %lld di %lld giorni simili."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewiduje się spadek ciśnienia przez %@ hPa w kolejnych godzinach %lld. Twoje logi pokazują bóle głowy na %lld %lld podobnych dni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ hPa nyomás csökkenése várható a következő %lld órában. A naplók szerint fejfájás %lld %lld hasonló napokon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paineen ennustetaan laskevan %@ hPa:llä seuraavien %lld:n tuntien aikana. Lokit osoittavat päänsärkyä %lld %lld vastaavia päiviä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk er forventet å falle av %@ hPa i de neste %lld timer. Loggene dine viser hodepine på %lld av %lld lignende dager."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykket forventes at falde af %@ hPa i de næste %lld timer. Dine logfiler viser hovedpine på %lld af %lld lignende dage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По прогнозу, давление снизится на %@ hPa в ближайшие %lld часов. В записях головная боль отмечалась в %lld из %lld похожих дней."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevê-se que a pressão caia em %@ hPa nas próximas horas de %lld. Seus registros mostram dores de cabeça em %lld de %lld dias semelhantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиск є прогнозом падіння %@ hPa в наступні години %lld. Ваші журнали показують головні болі на %lld %lld аналогічні дні."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression devrait diminuer de %@ hPa dans les prochaines heures de %lld. Vos journaux montrent des maux de tête sur %lld de %lld jours similaires."
          }
        }
      }
    },
