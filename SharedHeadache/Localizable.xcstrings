    "Even baseline (%@): what you'd see if headaches were spread evenly across these buckets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even baseline (%@): what you'd see if headaches were spread evenly across these buckets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sogar Baseline (%@): Was würden Sie sehen, wenn Kopfschmerzen gleichmäßig über diese Eimer verteilt wären?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースライン(%@)でも: 頭痛がこれらの Bucket に均等に広がるかどうかを確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso basal (%@): lo que vería si los dolores de cabeza se diseminaban uniformemente a través de estos cubos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la linea di base (%@): ciò che si vede se i mal di testa sono stati distribuiti uniformemente attraverso questi secchi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet początkowe (%@): co można zobaczyć, jeśli bóle głowy były rozłożone równomiernie na tych wiadrach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még a kiindulási (%@) is: amit látni lehet, ha a fejfájás egyenletesen oszlik szét ezeken a vödrökön."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jopa lähtötilanteessa (%@): mitä näkisit, jos päänsärky olisi levinnyt tasaisesti näihin kauhoihin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv baseline (%@): hva du ville se om hodepine var jevnt spredt over disse bøtter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv baseline (%@): hvad du ville se, hvis hovedpine blev spredt jævnt over disse spande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже базовый уровень (%@): что бы вы увидели, если бы головные боли распределялись равномерно по этим ведрам."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo a linha de base (%@): o que você veria se as dores de cabeça se espalhassem uniformemente por estes baldes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть базова лінія (%@): що ви бачите, якщо головні болі поширилися рівномірно через ці відро."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même au départ (%@) : ce que vous verriez si les maux de tête se répandaient uniformément dans ces seaux."
          }
        }
      }
    },
