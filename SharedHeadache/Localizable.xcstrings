            "state": "translated",
            "value": "Ricevi un avviso prima che questo segnale aumenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymaj powiadomienie, zanim ten sygnał wzrośnie."
