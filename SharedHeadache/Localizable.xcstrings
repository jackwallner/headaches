    "Then %@. Auto-renews; cancel anytime in Settings at least 24 hours before it ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then %@. Auto-renews; cancel anytime in Settings at least 24 hours before it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach %@. Das Abo verlängert sich automatisch. Du kannst es jederzeit in den Einstellungen kündigen, mindestens 24 Stunden vor Ablauf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後は%@です。自動更新されます。終了の24時間以上前までに「設定」からいつでも解約できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, %@. Se renueva automáticamente. Puedes cancelarlo en Ajustes hasta 24 horas antes de que termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi %@. Si rinnova automaticamente. Puoi disdirlo in Impostazioni almeno 24 ore prima della scadenza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem %@. Subskrypcja odnawia się automatycznie. Możesz ją anulować w Ustawieniach co najmniej 24 godziny przed końcem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután %@. Automatikusan megújul. A Beállításokban bármikor lemondhatod, legalább 24 órával a lejárat előtt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen jälkeen %@. Tilaus uusiutuu automaattisesti. Voit perua sen Asetuksissa milloin tahansa, vähintään 24 tuntia ennen kauden loppua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter %@. Abonnementet fornyes automatisk. Du kan si det opp i Innstillinger når som helst, minst 24 timer før det utløper."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter %@. Abonnementet fornyes automatisk. Du kan opsige det i Indstillinger mindst 24 timer før det udløber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем %@. Подписка продлевается автоматически. Ты можешь отменить её в Настройках не менее чем за 24 часа до конца периода."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois %@. Renova automaticamente. Podes cancelar nas Definições até 24 horas antes do fim do período."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім %@. План поновлюється автоматично. Його можна скасувати в Параметрах щонайменше за 24 години до завершення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis %@. Renouvellement automatique. Vous pouvez résilier dans Réglages au moins 24 heures avant la fin de la période."
          }
        }
      }
    },
    "This file may contain events that are already in your history. How would you like to handle them?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file may contain events that are already in your history. How would you like to handle them?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält möglicherweise Einträge, die bereits in deinem Verlauf stehen. Wie möchtest du damit umgehen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには履歴にある記録が含まれている場合があります。どのように扱いますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el archivo contenga registros que ya están en tu historial. ¿Cómo quieres gestionarlos?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file potrebbe contenere registrazioni già presenti nella cronologia. Come vuoi gestirle?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik może zawierać wpisy, które są już w twojej historii. Jak chcesz z nimi postąpić?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl olyan bejegyzéseket is tartalmazhat, amelyek már szerepelnek az előzményekben. Mit tegyünk velük?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostossa voi olla kirjauksia, jotka ovat jo historiassasi. Miten haluat käsitellä ne?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan inneholde registreringer som allerede finnes i historikken din. Hvordan vil du håndtere dem?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan indeholde registreringer, der allerede findes i din historik. Hvordan vil du håndtere dem?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле могут быть записи, которые уже есть в истории. Что с ними сделать?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro pode conter registos que já estão no teu histórico. Como queres tratá-los?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому файлі можуть бути записи, які вже є в історії. Як їх обробити?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier peut contenir des notes déjà présentes dans votre historique. Comment souhaitez-vous les traiter ?"
          }
        }
      }
    },
    "This is a pattern in your logged data. It does not show what caused a headache. It is not medical advice or a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a pattern in your logged data. It does not show what caused a headache. It is not medical advice or a diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Muster in deinen Einträgen. Es zeigt nicht, wodurch Kopfschmerzen verursacht wurden. Es ist keine medizinische Beratung oder Diagnose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛の記録に見られるパターンです。頭痛の原因を示すものではありません。医療上の助言や診断ではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este patrón aparece en tus datos registrados. No indica qué causó el dolor de cabeza y no es consejo médico ni un diagnóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo andamento compare nei dati che hai registrato. Non indica cosa abbia causato il mal di testa e non è un consiglio medico né una diagnosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wzorzec widoczny w zapisanych danych. Nie wskazuje przyczyny bólu głowy i nie jest poradą medyczną ani diagnozą."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy, a rögzített adataidban látható mintázat. Nem mutatja meg, mi okozta a fejfájást, és nem orvosi tanács vagy diagnózis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kuvio näkyy kirjatuissa tiedoissasi. Se ei osoita, mikä aiheutti päänsäryn, eikä ole lääketieteellistä neuvontaa tai diagnoosi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette mønsteret finnes i de registrerte dataene dine. Det viser ikke hva som forårsaket hodepine, og er ikke medisinske råd eller en diagnose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette mønster fremgår af dine registrerede data. Det viser ikke, hvad der forårsagede hovedpine, og er ikke lægefaglig rådgivning eller en diagnose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта закономерность видна в записанных данных. Она не показывает, что вызвало головную боль, и не является медицинской рекомендацией или диагнозом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um padrão nos teus registos. Não indica o que causou uma dor de cabeça. Não é aconselhamento médico nem diagnóstico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це закономірність у твоїх записах. Вона не вказує на причину головного болю. Це не медична порада й не діагноз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une tendance dans vos données. Elle n’indique pas la cause d’un mal de tête. Ce n’est ni un avis médical ni un diagnostic."
          }
        }
      }
    },
    "This permanently removes the entr%@ from your history. Export a CSV first if you need a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the entr%@ from your history. Export a CSV first if you need a backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Eintrag%@ entfernst du dauerhaft aus deinem Verlauf. Exportiere zuerst eine CSV-Datei, wenn du ein Backup brauchst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録%@を履歴から完全に削除します。必要であれば、先にCSVを書き出してバックアップしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro se eliminará definitivamente de tu historial. Exporta primero un CSV si necesitas una copia de seguridad (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione verrà rimossa definitivamente dalla cronologia. Esporta prima un CSV se vuoi conservarne una copia (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wpis zostanie trwale usunięty z historii. Najpierw wyeksportuj plik CSV, jeśli potrzebujesz kopii zapasowej (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen törli a bejegyzést az előzményekből. Ha biztonsági másolatot szeretnél, előbb exportálj CSV-fájlt. %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kirjauksen pysyvästi historiastasi. Vie ensin CSV-tiedosto, jos tarvitset varmuuskopion. %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner registreringen permanent fra historikken. Eksporter en CSV-fil først hvis du trenger en sikkerhetskopi. %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner registreringen permanent fra din historik. Eksporter først en CSV-fil, hvis du har brug for en sikkerhedskopi. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись будет удалена из истории без возможности восстановления. Если нужна резервная копия, сначала экспортируй CSV-файл. %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação elimina permanentemente o registo do teu histórico. Exporta um ficheiro CSV antes, se precisares de uma cópia de segurança. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запис буде назавжди видалено з історії. Якщо потрібна резервна копія, спочатку експортуй CSV-файл. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note sera définitivement supprimée de votre historique. Exportez d’abord un CSV si vous avez besoin d’une sauvegarde. %@"
          }
        }
      }
    },
    "This permanently removes the selected entries from your history. Export a CSV first if you need a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
