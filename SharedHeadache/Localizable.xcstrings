    "Use a CSV exported from this app. Other CSVs are not guaranteed to match the columns we expect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a CSV exported from this app. Other CSVs are not guaranteed to match the columns we expect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine CSV-Datei aus dieser App. Bei anderen CSV-Dateien stimmen die Spalten möglicherweise nicht überein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリから書き出したCSVを使ってください。他のCSVは対応する列の形式が異なる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un CSV exportado desde esta app. No se garantiza que otros archivos CSV tengan las columnas necesarias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un file CSV esportato da questa app. Non è garantito che altri CSV abbiano le colonne richieste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj pliku CSV wyeksportowanego z tej aplikacji. Inne pliki CSV mogą mieć niezgodne kolumny."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazásból exportált CSV-fájlt használj. Más CSV-fájlok oszlopai eltérhetnek az elvárttól."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä tästä sovelluksesta vietyä CSV-tiedostoa. Muiden CSV-tiedostojen sarakkeet eivät välttämättä vastaa odotuksia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en CSV-fil eksportert fra denne appen. Andre CSV-filer har ikke nødvendigvis kolonnene vi forventer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en CSV-fil, der er eksporteret fra appen. Andre CSV-filer har ikke nødvendigvis de kolonner, vi forventer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используй CSV-файл, экспортированный из приложения. Структура других файлов может отличаться."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa um ficheiro CSV exportado por esta app. Outros ficheiros podem não ter as colunas necessárias."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуй CSV-файл, експортований із цієї програми. В інших CSV можуть бути інші стовпці."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un CSV exporté depuis cette app. Les autres fichiers CSV ne présentent pas nécessairement les colonnes attendues."
          }
        }
      }
    },
    "Use a test alert to confirm notifications are working before relying on a forecast alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a test alert to confirm notifications are working before relying on a forecast alert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende einen Testhinweis, um zu prüfen, ob Mitteilungen funktionieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報通知を使う前に、テスト通知で通知が届くことを確認してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un aviso de prueba para comprobar que las notificaciones funcionan antes de confiar en los avisos de previsión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un avviso di prova per verificare che le notifiche funzionino prima di affidarti agli avvisi meteo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij powiadomienie testowe, aby sprawdzić, czy powiadomienia działają, zanim zaczniesz polegać na tych z prognozy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesztértesítéssel ellenőrizd, hogy működnek-e az értesítések, mielőtt az előrejelzésen alapuló értesítésekre hagyatkoznál."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista testi-ilmoituksella, että ilmoitukset toimivat, ennen kuin luotat ennusteilmoitukseen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk et testvarsel for å kontrollere at varsler fungerer før du stoler på et værvarsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en testmeddelelse til at kontrollere, at meddelelser virker, før du stoler på et vejrvarsel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправь тестовое уведомление, чтобы проверить работу уведомлений перед использованием прогноза."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia um alerta de teste para confirmar que as notificações funcionam antes de contares com um alerta de previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішли тестове сповіщення, щоб перевірити роботу сповіщень до того, як покладатися на сповіщення за прогнозом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une alerte de test pour vérifier le fonctionnement des notifications avant de compter sur une alerte météo."
          }
        }
      }
    },
    "Use a test alert to confirm notifications are working before waiting for real headache weather.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a test alert to confirm notifications are working before waiting for real headache weather."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende einen Testhinweis, um zu prüfen, ob Mitteilungen funktionieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知で通知が届くことを確認してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un aviso de prueba para comprobar que las notificaciones funcionan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un avviso di prova per verificare che le notifiche funzionino."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij powiadomienie testowe, aby sprawdzić, czy powiadomienia działają."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesztértesítéssel ellenőrizd, hogy működnek-e az értesítések, mielőtt valódi időjárási jelre vársz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista testi-ilmoituksella, että ilmoitukset toimivat, ennen kuin odotat sääsignaalia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk et testvarsel for å kontrollere at varsler fungerer før du venter på værforhold."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en testmeddelelse til at kontrollere, at meddelelser virker, før du venter på vejrforholdene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправь тестовое уведомление, чтобы проверить работу уведомлений до появления подходящих погодных условий."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia um alerta de teste para confirmar que as notificações funcionam antes de aguardares por um alerta meteorológico real."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішли тестове сповіщення, щоб перевірити роботу сповіщень до очікування реального сповіщення про погоду."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une alerte de test pour vérifier le fonctionnement des notifications avant d’attendre une alerte météo réelle."
          }
        }
      }
    },
    "Use the Headache button on the One Tap tab and the app will start building a timeline you can share with your doctor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Headache button on the One Tap tab and the app will start building a timeline you can share with your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe im Tab „One Tap“ auf „Kopfschmerz“. Die App erstellt dann einen Verlauf, den du mit deiner Arztpraxis teilen kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ワンタップ」タブの「頭痛」ボタンを使うと、医師と共有できる記録が作られます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Dolor de cabeza» en la pestaña «Un toque» para empezar a crear un historial que puedas compartir con tu médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Mal di testa» nella scheda «Un tocco» per iniziare a creare uno storico da condividere con il medico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij przycisku „Ból głowy” na karcie „Jedno dotknięcie”, aby zacząć tworzyć historię do udostępnienia lekarzowi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejfájás rögzítéséhez koppints az Egy érintés lapon a Fejfájás gombra. Az alkalmazás ezután megosztható előzményeket készít."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Yksi napautus -välilehdellä Päänsärky-painiketta. Sovellus alkaa koota historiaa, jonka voit jakaa lääkärillesi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Hodepine-knappen på Ett trykk-fanen. Appen begynner da å bygge opp en historikk du kan dele med legen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Hovedpine-knappen under Ét tryk. Appen begynder derefter at opbygge en historik, som du kan dele med din læge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми кнопку «Головная боль» на вкладке «Одно касание». Приложение начнёт собирать историю, которой можно поделиться с врачом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o botão Dor de cabeça no separador Um toque. A app começará a criar um histórico que podes partilhar com o médico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни кнопку «Головний біль» на вкладці «Один дотик». Програма почне створювати історію, якою можна поділитися з лікарем."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton Mal de tête de l’onglet Une touche. L’app commencera à constituer un historique à partager avec votre médecin."
          }
        }
      }
    },
