    "Most barometric-trigger studies use 3–6 hPa over 12–24 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most barometric-trigger studies use 3–6 hPa over 12–24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In vielen Studien werden Luftdruckänderungen von 3–6 hPa innerhalb von 12–24 Stunden betrachtet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気圧と頭痛の関連を調べた研究では、通常12～24時間で3～6 hPaの変化を見ています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los estudios sobre presión atmosférica y dolor de cabeza analizan cambios de 3–6 hPa en 12–24 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte degli studi sulle variazioni della pressione atmosferica esamina cambiamenti di 3–6 hPa nell’arco di 12–24 ore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość badań nad ciśnieniem atmosferycznym analizuje zmiany o 3–6 hPa w ciągu 12–24 godzin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A légnyomás változását vizsgáló tanulmányok többsége 3–6 hPa változást néz 12–24 óra alatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useimmissa ilmanpaineen muutoksia käsittelevissä tutkimuksissa tarkastellaan 3–6 hPa:n muutosta 12–24 tunnin aikana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste studier av lufttrykksendringer ser på 3–6 hPa over 12–24 timer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste studier af lufttryksændringer ser på 3–6 hPa over 12–24 timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В большинстве исследований изменения давления рассматривают перепады 3–6 гПа за 12–24 часа."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria dos estudos sobre pressão atmosférica analisa variações de 3–6 hPa ao longo de 12–24 horas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У більшості досліджень зв’язку атмосферного тиску з головним болем аналізують зміну на 3–6 hPa за 12–24 години."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des études sur la pression atmosphérique analysent des variations de 3–6 hPa sur 12–24 heures."
          }
        }
      }
    },
