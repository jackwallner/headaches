    "Unlock Pro for personalized headache and weather alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Pro for personalized headache and weather alerts"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Pro frei für persönliche Muster und Wetterhinweise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proで記録に基づくパターンと天気の通知を確認"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea Pro para recibir avisos meteorológicos basados en tus registros"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca Pro per ricevere avvisi meteo basati sui tuoi registri"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj Pro, aby otrzymywać powiadomienia pogodowe na podstawie twoich wpisów"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldd fel a Prót a személyre szabott fejfájás- és időjárási értesítésekért"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Pro saadaksesi henkilökohtaisia päänsärky- ja sääilmoituksia"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp Pro for personlige varsler om hodepine og vær"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås Pro op for personlige hovedpine- og vejrvarsler"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Pro, чтобы получать личные уведомления о головной боли и погоде"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia o Pro para receber alertas meteorológicos personalizados com base nos teus registos"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуй Pro, щоб отримувати особисті сповіщення про погоду на основі записів"
