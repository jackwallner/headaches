    "Shows forecast pressure and air quality alongside your logged sleep. It is a heads-up, not a prediction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows forecast pressure and air quality alongside your logged sleep. It is a heads-up, not a prediction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den vorhergesagten Luftdruck und die Luftqualität neben deinen Schlafdaten. Ein Hinweis, keine Vorhersage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の記録とあわせて気圧と空気質の予報を表示します。天気のお知らせであり、頭痛の予測ではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la previsión de presión y calidad del aire junto con tus datos de sueño. Es un aviso, no una predicción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le previsioni di pressione e qualità dell’aria insieme ai tuoi dati sul sonno. È un avviso, non una previsione del mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje prognozę ciśnienia i jakości powietrza obok danych o śnie. To powiadomienie, nie prognoza bólu głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alvásadataid mellett mutatja az előrejelzett légnyomást és levegőminőséget. Tájékoztató jelzés, nem előrejelzés."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää ilmanpaine- ja ilmanlaatuennusteen kirjattujen unitietojesi rinnalla. Tämä on ennakkotieto, ei ennuste päänsärystä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser lufttrykk og luftkvalitet fra værmeldingen sammen med søvnregistreringene dine. Det er et varsel, ikke en spådom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser lufttryk og luftkvalitet fra vejrudsigten sammen med dine søvnregistreringer. Det er en påmindelse, ikke en forudsigelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает прогноз давления и качества воздуха рядом с записями о сне. Это уведомление, а не прогноз головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a pressão e a qualidade do ar previstas, juntamente com os dados de sono registados. É um aviso, não uma previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує прогноз тиску й якості повітря разом із записами про сон. Це попередження, а не прогноз головного болю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les prévisions de pression et de qualité de l’air avec vos données de sommeil. C’est une alerte, pas une prédiction de mal de tête."
          }
        }
      }
    },
