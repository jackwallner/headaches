    "Even baseline (%@): what you'd see if headaches were spread evenly across these buckets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even baseline (%@): what you'd see if headaches were spread evenly across these buckets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßiger Richtwert (%@): die Verteilung, wenn Einträge gleichmäßig auf diese Zeiträume entfielen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "均等な基準値（%@）: 頭痛が各区分に均等に分布した場合の目安です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia uniforme (%@): lo que verías si los dolores de cabeza se distribuyeran por igual entre estas categorías."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valore uniforme (%@): cosa vedresti se i mal di testa fossero distribuiti in modo uniforme tra queste categorie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Równomierny poziom odniesienia (%@): taki rozkład widać, gdy bóle głowy występują jednakowo często w każdej kategorii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyenletes eloszlás (%@): ezt látnád, ha a fejfájások az egyes kategóriákban egyformán gyakran fordulnának elő."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasaisen jakauman vertailutaso (%@): näin päänsäryt jakautuisivat, jos ne osuisivat yhtä usein jokaiseen luokkaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevnt referansenivå (%@): slik ville hodepinene fordelt seg hvis de forekom like ofte i alle kategoriene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jævn fordeling (%@): sådan ville hovedpinerne fordele sig, hvis de forekom lige ofte i hver kategori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Равномерный уровень (%@): так выглядело бы распределение, если бы головные боли возникали одинаково часто в каждой категории."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Média uniforme (%@): o valor esperado se as dores de cabeça estivessem distribuídas por igual nestas faixas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівномірний показник (%@): значення, яке було б за рівномірного розподілу головного болю між цими категоріями."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne uniforme (%@) : répartition attendue si les maux de tête étaient répartis également entre ces catégories."
          }
        }
      }
    },
