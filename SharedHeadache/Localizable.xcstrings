    "Optional. Helps Patterns highlight areas you may want to explore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Helps Patterns highlight areas you may want to explore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Hilft dir, Bereiche in deinen Einträgen zu entdecken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。記録から確認したい点を見つけやすくなります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ayuda a Patrones a destacar aspectos que quizá quieras explorar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Aiuta Andamenti a mettere in evidenza gli aspetti che potresti voler approfondire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Odpowiedzi pomogą wskazać obszary, które możesz chcieć lepiej poznać."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális. Segít kiemelni a mintázatokat, amelyeket érdemes lehet jobban megismerned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Auttaa nostamaan esiin kuvioita, joita voit tutkia tarkemmin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Hjelper med å løfte fram mønstre du kanskje vil utforske."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Hjælper med at fremhæve mønstre, du måske vil undersøge nærmere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Поможет выделить закономерности, которые ты сможешь изучить."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ajuda a destacar áreas que talvez queiras explorar nos Padrões."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Допомагає виділити теми, які можна дослідити у розділі «Закономірності»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Aide Tendances à faire ressortir des sujets que vous pourriez explorer."
          }
        }
      }
    },
    "Optional. Helps Patterns surface the triggers most relevant to you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Helps Patterns surface the triggers most relevant to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Hilft dir, passende Muster in deinen Einträgen zu entdecken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。記録から関連するパターンを見つけやすくなります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ayuda a Patrones a destacar las señales más relevantes para ti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Aiuta Andamenti a mettere in evidenza i segnali più rilevanti per te."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Odpowiedzi pomogą wskazać sygnały, które mogą być dla ciebie najistotniejsze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális. Segít kiemelni a számodra legfontosabb jeleket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Auttaa nostamaan esiin sinulle tärkeimmät signaalit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Hjelper med å finne signalene som er mest relevante for deg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Hjælper med at fremhæve de signaler, der er vigtigst for dig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Поможет выделить сигналы, наиболее важные для тебя."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ajuda a destacar os padrões mais relevantes para ti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Допомагає виділити закономірності, найважливіші для тебе."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Aide Tendances à faire ressortir les tendances les plus pertinentes pour vous."
          }
        }
      }
    },
