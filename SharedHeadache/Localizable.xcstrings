    "Across %lld days with %@, headaches were logged on %@ of days, below the overall rate of %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across %lld days with %@, headaches were logged on %@ of days, below the overall rate of %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %lld Tagen mit %@ hast du an %@ der Tage einen Eintrag erfasst. Das liegt unter dem Gesamtwert von %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日間で%@があったとき、頭痛を記録した割合は%@で、全体の%@を下回りました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los %lld días con %@, registraste dolor de cabeza en %@ de los días, por debajo de la tasa general de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei %lld giorni con %@, hai registrato mal di testa nel %@ dei giorni, meno della frequenza complessiva del %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu %lld dni z %@ odsetek dni z bólem głowy wyniósł %@, poniżej ogólnego odsetka %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld olyan napból, amikor %@ volt, %@ napon rögzítettél fejfájást. Ez az összesített %@ aránynál alacsonyabb."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld päivän aikana, jolloin %@, päänsärky kirjattiin %@ päivänä. Osuus jäi alle kaikkien päivien tason %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I løpet av %lld dager med %@ ble hodepine registrert på %@ av dagene, lavere enn den samlede andelen på %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I løbet af %lld dage med %@ blev hovedpine registreret på %@ dage, under den samlede andel på %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За %lld дней с %@ головная боль была записана в %@ дней, что ниже общего показателя %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao longo de %lld dias com %@, as dores de cabeça foram registadas em %@ dos dias, abaixo da taxa geral de %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За %lld днів із %@ головний біль записували у %@ днів, що нижче загального показника %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur %lld jours avec %@, des maux de tête ont été notés %@ jours, soit moins que le taux général de %@."
          }
        }
      }
    },
