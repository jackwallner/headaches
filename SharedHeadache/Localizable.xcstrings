    "Press once when a headache starts; the app records the moment and fills in as much health and environmental context as it can.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press once when a headache starts; the app records the moment and fills in as much health and environmental context as it can."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einmal, wenn Kopfschmerzen beginnen. Die App erfasst den Zeitpunkt und ergänzt so viele Health- und Umweltdaten wie möglich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛が始まったら一度タップしてください。時刻を記録し、取得できるヘルスケアや環境の情報を追加します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una vez cuando empiece el dolor de cabeza. La app registra el momento y añade los datos de Salud y del entorno que estén disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando inizia il mal di testa, tocca una volta. L’app registra il momento e aggiunge i dati di Salute e dell’ambiente disponibili."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zacznie się ból głowy, dotknij przycisku. Aplikacja zapisze moment i uzupełni go dostępnymi danymi o zdrowiu i środowisku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejfájás kezdetekor érints meg egyszer a gombot. Az alkalmazás rögzíti az időpontot, és hozzáadja az elérhető egészségügyi és környezeti adatokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kerran, kun päänsärky alkaa. Sovellus kirjaa ajankohdan ja lisää saatavilla olevat terveys- ja ympäristötiedot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk én gang når hodepinen starter. Appen registrerer tidspunktet og legger til tilgjengelige helse- og miljøopplysninger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang, når hovedpinen begynder. Appen registrerer tidspunktet og tilføjer de sundheds- og miljødata, der er tilgængelige."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми один раз, когда начнётся головная боль. Приложение запишет время и добавит доступные данные о здоровье и окружающей среде."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uma vez quando começa uma dor de cabeça. A app regista o momento e acrescenta os dados de saúde e do ambiente que conseguir recolher."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись один раз, коли почнеться головний біль. Програма запише час і додасть доступні дані про здоров’я та довкілля."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois au début d’un mal de tête. L’app note l’heure et ajoute les données de santé et d’environnement disponibles."
          }
        }
      }
    },
    "Pressure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
