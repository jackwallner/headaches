    "Log a headache once to capture your location, then come back here to see forecast signals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a headache once to capture your location, then come back here to see forecast signals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen Sie einmal Kopfschmerzen, um Ihren Standort zu erfassen, und kommen Sie dann hierher zurück, um Prognosesignale zu sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置をキャプチャするために、頭痛を一度ログに記録し、ここで戻って予測信号を確認します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lograr dolor de cabeza una vez para capturar su ubicación, y luego volver aquí para ver señales de pronóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi un mal di testa una volta per catturare la tua posizione, poi torna qui per vedere i segnali di previsione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj ból głowy raz uchwycić swoją lokalizację, a następnie wrócić tutaj, aby zobaczyć prognozy sygnałów."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyezz be egy fejfájást egyszer, hogy rögzítsd a helyzeted, majd gyere vissza, hogy lásd az előrejelző jeleket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa päänsärky kerran tallentaa sijaintisi, sitten palata tänne nähdä ennustesignaalit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg en hodepine en gang for å fange plasseringen din, så komme tilbake hit for å se prognosesignaler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log en hovedpine en gang for at fange din placering, og kom så tilbage her for at se prognoser signaler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите головную боль один раз, чтобы захватить ваше местоположение, а затем вернитесь сюда, чтобы увидеть прогнозные сигналы."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre uma dor de cabeça uma vez para capturar sua localização e depois volte aqui para ver sinais de previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть головний біль, щоб захопити своє місце, потім поверніть сюди, щоб побачити прогнозні сигнали."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un mal de tête une fois pour saisir votre emplacement, puis revenez ici pour voir les signaux de prévision."
          }
        }
      }
    },
    "Forecast unavailable. Tap to retry.": {
      "extractionState": "manual",
      "localizations": {
