    "Not enough logged headaches yet for pattern detection (need at least %lld).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough logged headaches yet for pattern detection (need at least %lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch nicht genug Einträge, um Muster zu erkennen (mindestens %lld erforderlich)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パターンを確認するには、まだ頭痛の記録が足りません（少なくとも%lld件必要です）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes registros para detectar patrones (se necesitan al menos %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza mal di testa registrati per rilevare andamenti (ne servono almeno %lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało zapisanych bólów głowy, aby wykryć wzorce. Potrzeba co najmniej %lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs elég rögzített fejfájás a mintázatok felismeréséhez (legalább %lld szükséges)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päänsärkyjä ei ole vielä kirjattu tarpeeksi kuvioiden tunnistamiseen (tarvitaan vähintään %lld)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke registrert nok hodepine til å finne mønstre ennå (minst %lld kreves)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke registreret nok hovedpiner til at finde mønstre endnu (mindst %lld er nødvendigt)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно записей о головной боли для поиска закономерностей (нужно не менее %lld)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há registos suficientes para identificar padrões (são necessários pelo menos %lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки недостатньо записів про головний біль для пошуку закономірностей (потрібно щонайменше %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de notes pour faire ressortir des tendances (il en faut au moins %lld)."
          }
        }
      }
    },
