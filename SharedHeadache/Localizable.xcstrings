    "Your median pre-headache HRV (SDNN) is %@. The chart shows where your HRV typically sat at the moment you logged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your median pre-headache HRV (SDNN) is %@. The chart shows where your HRV typically sat at the moment you logged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Median der HRV (SDNN) vor einem Eintrag liegt bei %@. Die Grafik zeigt die Werte zum Zeitpunkt deiner Einträge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を記録する前の心拍変動（SDNN）の中央値は%@です。グラフには記録時の心拍変動を表示します。"
