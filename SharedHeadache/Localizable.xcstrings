    "Context captured but save failed. Reopen to retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context captured but save failed. Reopen to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext erfasst, aber nicht gespeichert. Öffne die App erneut und versuche es noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連データを取得しましたが、保存できませんでした。開き直してもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se obtuvo el contexto, pero no se pudo guardar. Cierra y vuelve a abrir para intentarlo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati contestuali sono stati raccolti, ma non salvati. Riapri l’app per riprovare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zebrano dane kontekstowe, ale nie udało się ich zapisać. Otwórz ponownie, aby spróbować jeszcze raz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok rögzítése sikerült, de a mentés nem. Nyisd meg újra, és próbáld meg ismét."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustatiedot saatiin, mutta tallennus epäonnistui. Yritä uudelleen avaamalla sovellus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplysningene ble hentet, men kunne ikke lagres. Åpne appen igjen for å prøve på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplysningerne blev indsamlet, men kunne ikke gemmes. Åbn appen igen for at prøve på ny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные собраны, но сохранить их не удалось. Открой приложение снова и повтори попытку."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contexto foi recolhido, mas não foi possível guardar o registo. Abre-o novamente para tentar outra vez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст зібрано, але не вдалося зберегти запис. Відкрий його знову, щоб повторити спробу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte a été recueilli, mais la note n’a pas pu être enregistrée. Rouvrez-la pour réessayer."
          }
        }
      }
    },
