    "Few forecast signals match patterns in your logs. This does not predict whether you will have a headache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Few forecast signals match patterns in your logs. This does not predict whether you will have a headache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenige Prognosesignale stimmen mit Mustern in Ihren Protokollen überein. Dies sagt nicht voraus, ob Sie Kopfschmerzen haben werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログの予測信号のマッチパターンを汚します。 頭痛があるかどうかを予測しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos pronósticos coinciden con los patrones en sus registros. Esto no predice si usted tendrá dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi segnali di previsione corrispondono modelli nei vostri registri. Questo non prevede se si avrà un mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka sygnałów prognostycznych pasuje do wzorców w dziennikach. Nie przewiduje to występowania bólu głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány előrejelző jel egyezik a naplóban szereplő mintákkal. Ez nem jelzi előre, hogy lesz-e fejfájása."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain muutama ennuste täsmää lokiisi. Tämä ei ennusta, onko sinulla päänsärkyä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få prognosesignaler matcher mønstre i loggene. Dette forutsier ikke om du vil ha hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få prognosesignaler matcher mønstre i dine logfiler. Dette forudsiger ikke, om du vil have hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немногие прогнозные сигналы соответствуют шаблонам в ваших журналах. Это не означает, что у вас будет головная боль."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poucos sinais de previsão coincidem com padrões em seus registros. Isto não prediz se você vai ter uma dor de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забудьте про те, що у вашому журналі запрошують сигнали. Це не прогнозує, чи ви будете мати головний біль."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de signaux de prévision correspondent aux modèles dans vos journaux. Cela ne prédit pas si vous aurez un mal de tête."
          }
        }
      }
    },
