    "Shows forecast pressure and air quality alongside your logged sleep. It is a heads-up, not a prediction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows forecast pressure and air quality alongside your logged sleep. It is a heads-up, not a prediction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Prognose Druck und Luftqualität neben Ihrem protokollierten Schlaf. Es ist ein Heads-up, keine Vorhersage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの記録された睡眠と一緒に予報圧力と空気の質を表示します。 予測ではなく、ヘッドアップです。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra presión de pronóstico y calidad del aire junto con su sueño registrado. Es una alerta, no una predicción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la pressione previsionale e la qualità dell'aria accanto al sonno registrato. E' una testata, non una previsione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje przewidywane ciśnienie i jakość powietrza obok zalogowanego snu. To jest głowa do góry, a nie przepowiednia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megmutatja az előrejelzett nyomást és a levegő minőségét a naplózott alvás mellett. Ez egy fej-up, nem egy előrejelzés."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää ennustettu paine ja ilmanlaatu yhdessä kirjautuneen unen. Se on varoitus, ei ennustus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser værvarsel og luftkvalitet sammen med din loggede søvn. Det er en heads-up, ikke en forutsigelse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser forventet tryk og luftkvalitet ved siden af din loggede søvn. Det er en heads-up, ikke en forudsigelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает прогнозируемое давление и качество воздуха наряду с загруженным сном. Это предупреждение, а не предсказание."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra pressão de previsão e qualidade do ar ao lado de seu sono registrado. É um aviso, não uma previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує тиск і якість повітря поряд з логічною сну. Це голова, не передбачення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la pression de prévision et la qualité de l'air à côté de votre sommeil enregistré. C'est une alerte, pas une prédiction."
          }
        }
      }
    },
