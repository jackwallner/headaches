    "One-page report covering the last 90 days: headache count, severity mix, calendar heatmap, and your top patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-page report covering the last 90 days: headache count, severity mix, calendar heatmap, and your top patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einseitiger Bericht der letzten 90 Tage: Anzahl der Einträge, Schweregrade, Kalenderübersicht und wichtigste Muster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去90日間の1ページレポートです。頭痛の記録数、重症度の内訳、カレンダー表示、主なパターンをまとめます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe de una página con los últimos 90 días: número de dolores de cabeza, intensidad, calendario y patrones principales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resoconto di una pagina sugli ultimi 90 giorni: numero di mal di testa, distribuzione dell’intensità, calendario e andamenti principali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostronicowy raport z ostatnich 90 dni: liczba bólów głowy, rozkład nasilenia, kalendarz i najważniejsze wzorce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyoldalas jelentés az elmúlt 90 napról: fejfájások száma, erősségük megoszlása, naptárnézet és a legfontosabb mintázatok."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhden sivun raportti viimeisistä 90 päivästä: päänsärkyjen määrä, voimakkuuksien jakauma, kalenterinäkymä ja tärkeimmät kuviot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én sides rapport for de siste 90 dagene: antall hodepiner, fordeling etter styrke, kalenderoversikt og de viktigste mønstrene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én sides rapport for de seneste 90 dage: antal hovedpiner, fordeling efter styrke, kalenderoversigt og dine vigtigste mønstre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одностраничный отчёт за последние 90 дней: количество головных болей, интенсивность, календарь и главные закономерности."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatório de uma página dos últimos 90 dias: número de dores de cabeça, distribuição da intensidade, mapa de calor do calendário e principais padrões."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Односторінковий звіт за останні 90 днів: кількість головних болів, їхня інтенсивність, календарна теплова карта та основні закономірності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport d’une page sur les 90 derniers jours : nombre de maux de tête, répartition des intensités, calendrier thermique et principales tendances."
          }
        }
      }
    },
