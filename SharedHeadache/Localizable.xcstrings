          "stringUnit": {
            "state": "translated",
            "value": "頭痛が始まると、アプリは瞬間を記録し、できるだけ多くの健康と環境のコンテキストを埋めます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione una vez cuando se inicia el dolor de cabeza; la aplicación registra el momento y llena tanto de salud y contexto ambiental como pueda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premere una volta che inizia un mal di testa; l'app registra il momento e si riempie di tanto contesto sanitario e ambientale come può."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij raz, gdy ból głowy zaczyna; aplikacja rejestruje moment i wypełnia jak najwięcej zdrowia i środowiska kontekstu, jak to możliwe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg egyszer, amikor a fejfájás kezdődik; az alkalmazás rögzíti a pillanatot, és kitölti annyi egészségügyi és környezeti környezetben, amennyit csak lehet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina kerran, kun päänsärky alkaa; sovellus tallentaa hetken ja täyttää mahdollisimman paljon terveyttä ja ympäristöä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk én gang når hodepine starter; appen registrerer øyeblikket og fyller inn så mye helse og miljø sammenheng som den kan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang, når en hovedpine starter; appen registrerer øjeblikket og fylder så meget sundhed og miljø sammenhæng, som det kan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите один раз, когда начинается головная боль; приложение записывает момент и заполняет как можно больше здоровья и окружающей среды."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma vez quando uma dor de cabeça começa; o aplicativo registra o momento e preenche o máximo de saúde e contexto ambiental possível."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть один раз, коли починається головний біль; додаток записує момент і заповнюється стільки здоров'я і навколишнього середовища, як це може."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois sur quand un mal de tête commence ; l'application enregistre le moment et remplit autant de contexte de santé et d'environnement qu'elle peut."
          }
        }
      }
    },
