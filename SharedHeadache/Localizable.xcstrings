    "Couldn't start your trial. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start your trial. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase konnte nicht starten. Bitte versuch es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルを開始できません。 お問い合わせ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar tu prueba. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la prova. Riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozpocząć okresu próbnego. Spróbuj ponownie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kezdhette el a tárgyalást. Kérem, próbálja újra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilua ei voitu aloittaa. Yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke starte prøveperioden. Prøv igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kunne ikke starte din retssag. Prøv igen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать пробный период. Попробуйте ещё раз."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pude começar o julgamento. Por favor, tente novamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося почати пробний період. Спробуйте ще раз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer votre essai. Veuillez réessayer."
          }
        }
      }
    },
