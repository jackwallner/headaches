    "Proactive Alerts use the forecast signals shown here for a 12 to 24 hour heads-up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactive Alerts use the forecast signals shown here for a 12 to 24 hour heads-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wetterhinweise nutzen die hier gezeigten Prognosesignale und informieren dich 12 bis 24 Stunden im Voraus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報通知では、ここに表示される信号を使って12～24時間先の天気をお知らせします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de previsión usan las señales que se muestran aquí para avisarte con 12 a 24 horas de antelación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi meteo usano i segnali mostrati qui per avvisarti con 12-24 ore di anticipo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia o prognozie wykorzystują pokazane tu sygnały, aby informować z 12–24-godzinnym wyprzedzeniem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előrejelzési értesítések az itt látható jelek alapján 12–24 órával korábban szólnak."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennusteilmoitukset käyttävät tässä näkyviä signaaleja ja ilmoittavat niistä 12–24 tuntia etukäteen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Værvarslene bruker signalene som vises her, og gir beskjed 12–24 timer i forkant."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslerne bruger signalerne fra vejrudsigten, der vises her, og giver besked 12–24 timer i forvejen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления по прогнозу используют сигналы, показанные здесь, и приходят за 12–24 часа."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas proativos usam os sinais da previsão apresentados aqui para te avisar com 12 a 24 horas de antecedência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проактивні сповіщення використовують наведені тут сигнали прогнозу й надходять за 12–24 години."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes proactives utilisent les signaux météo affichés ici pour vous prévenir 12 à 24 heures à l’avance."
          }
        }
      }
    },
    "Proactive Alerts use the same forecast signals shown here to give you a 12–24 hour heads-up before risky weather.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactive Alerts use the same forecast signals shown here to give you a 12–24 hour heads-up before risky weather."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wetterhinweise nutzen dieselben Prognosesignale wie hier und informieren dich 12–24 Stunden im Voraus über Wetteränderungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報通知では、ここに表示される信号を使って12～24時間先の天気をお知らせします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de previsión usan estas señales para avisarte con 12–24 horas de antelación sobre cambios meteorológicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi meteo usano gli stessi segnali mostrati qui per avvisarti con 12-24 ore di anticipo sui cambiamenti del meteo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia o prognozie wykorzystują te same sygnały, aby informować z 12–24-godzinnym wyprzedzeniem o zmianach pogody."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előrejelzési értesítések ugyanezekre a jelekre támaszkodnak, és 12–24 órával korábban tájékoztatnak az időjárás változásáról."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennusteilmoitukset käyttävät samoja tässä näkyviä signaaleja ja kertovat säämuutoksista 12–24 tuntia etukäteen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Værvarslene bruker de samme signalene som vises her, og varsler om værendringer 12–24 timer i forkant."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslerne bruger de samme signaler fra vejrudsigten og giver besked om vejrændringer 12–24 timer i forvejen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления по прогнозу используют те же сигналы и сообщают об изменениях погоды за 12–24 часа."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas proativos usam os mesmos sinais da previsão apresentados aqui para te avisar com 12–24 horas de antecedência sobre condições meteorológicas relevantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проактивні сповіщення використовують ті самі сигнали прогнозу й надходять за 12–24 години до погодних умов, схожих на ті, що є у твоїх записах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes proactives utilisent les mêmes signaux météo pour vous prévenir 12 à 24 heures à l’avance en cas de conditions similaires à celles de vos notes."
          }
        }
      }
    },
    "Prompt for severity and notes": {
