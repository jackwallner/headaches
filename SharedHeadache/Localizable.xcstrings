    "Billed through Apple. No charge during the trial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed through Apple. No charge during the trial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrechnung läuft über Apple. Während des Probezeitraums zahlst du nichts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleを通じて請求されます。無料トライアル中の請求はありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cobro se realiza a través de Apple. No pagarás durante la prueba gratuita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’addebito è gestito da Apple. Non paghi durante la prova gratuita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność obsługuje Apple. W bezpłatnym okresie próbnym nie ponosisz opłat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számlázást az Apple kezeli. Az ingyenes próbaidőszak alatt nem kell fizetned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hoitaa laskutuksen. Kokeilujakson aikana sinulta ei veloiteta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple håndterer betalingen. Du belastes ikke i prøveperioden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple håndterer betalingen. Du bliver ikke opkrævet i prøveperioden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплату обрабатывает Apple. В течение бесплатного пробного периода списаний не будет."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cobrança é feita pela Apple. Não pagas durante o período experimental gratuito."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата через Apple. Під час безкоштовного пробного періоду плата не стягується."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facturation est gérée par Apple. Aucun paiement n’est dû pendant l’essai gratuit."
          }
        }
      }
    },
