    "Export selected entries from %@, or export all years below. The CSV opens in Numbers and can be shared with your doctor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export selected entries from %@, or export all years below. The CSV opens in Numbers and can be shared with your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere ausgewählte Einträge aus %@ oder unten alle Jahre. Die CSV-Datei lässt sich in Numbers öffnen und mit deiner Arztpraxis teilen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の記録を書き出すか、下から全期間を書き出してください。CSVはNumbersで開いたり、医師と共有したりできます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta los registros seleccionados de %@ o todos los años abajo. Puedes abrir el CSV en Numbers y compartirlo con tu médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta le registrazioni selezionate da %@ o tutti gli anni qui sotto. Puoi aprire il CSV in Numbers e condividerlo con il medico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj wybrane wpisy z %@ lub wszystkie lata poniżej. Plik CSV otworzysz w Numbers i możesz udostępnić go lekarzowi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportáld a %@-ból kiválasztott bejegyzéseket, vagy lent az összes évet. A CSV-fájlt megnyithatod a Numbersben és megoszthatod az orvosoddal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie valitut kirjaukset vuodelta %@ tai kaikki vuodet alta. CSV-tiedoston voi avata Numbersissa ja jakaa lääkärillesi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter valgte registreringer fra %@ eller alle år nedenfor. CSV-filen kan åpnes i Numbers og deles med legen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter valgte registreringer fra %@ eller alle år nedenfor. CSV-filen kan åbnes i Numbers og deles med din læge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируй выбранные записи за %@ или за все годы ниже. CSV-файл можно открыть в Numbers и отправить врачу."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta os registos selecionados de %@ ou todos os anos abaixo. Podes abrir o ficheiro CSV no Numbers e partilhá-lo com o médico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортуй вибрані записи за %@ або всі роки нижче. CSV-файл можна відкрити в Numbers і надіслати лікарю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez les notes sélectionnées de %@ ou toutes les années ci-dessous. Le fichier CSV s’ouvre dans Numbers et peut être partagé avec votre médecin."
          }
        }
      }
    },
