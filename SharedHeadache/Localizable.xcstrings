    "See patterns in your logs and get weather alerts when your data supports them. Free until the trial ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See patterns in your logs and get weather alerts when your data supports them. Free until the trial ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie Muster in Ihren Protokollen und erhalten Sie Wetterwarnungen, wenn Ihre Daten sie unterstützen. Frei bis zum Ende des Prozesses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログのパターンを見て、データがサポートしたときに気象アラートを取得します。 トライアル終了まで無料。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver patrones en sus registros y obtener alertas del tiempo cuando sus datos los soportan. Libre hasta que termine el juicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedere modelli nei registri e ottenere avvisi meteo quando i dati li supporta. Libero fino alla fine del processo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz wzory w dziennikach i uzyskać ostrzeżenia pogodowe, gdy dane je obsługują. Wolny do końca procesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lásd minták a naplók és kap időjárás figyelmeztető, ha az adatok támogatják őket. Szabadon, amíg a tárgyalás véget nem ér."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso kaavoja lokit ja saada sää hälytyksiä, kun tiedot tukevat niitä. Vapaa, kunnes oikeudenkäynti päättyy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i loggene og få værvarsler når dataene støtter dem. Fri til rettssaken avsluttes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i dine logfiler og få vejrvarsler, når dine data understøtter dem. Fri indtil retssagen er afsluttet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите шаблоны в своих журналах и получайте предупреждения о погоде, когда ваши данные поддерживают их. Бесплатно до окончания суда."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja padrões em seus registros e obtenha alertas meteorológicos quando seus dados os suportam. Livre até o julgamento acabar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте шаблони в журналах і отримуйте сповіщення про те, коли ваші дані підтримують їх. Безкоштовно до закінчення випробувань."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez les modèles dans vos journaux et obtenez des alertes météorologiques lorsque vos données les supportent. Libre jusqu'à la fin du procès."
          }
        }
      }
    },
    "See patterns in your logs and get alerts based on your history, free for eligible new subscribers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See patterns in your logs and get alerts based on your history, free for eligible new subscribers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie Muster in Ihren Protokollen und erhalten Sie Benachrichtigungen basierend auf Ihrer Historie, kostenlos für berechtigte neue Abonnenten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログのパターンを見て、あなたの履歴に基づいてアラートを取得する, 資格のある新しい加入者に無料で."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver patrones en tus registros y obtener alertas basadas en tu historia, gratis para nuevos suscriptores elegibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i modelli nei tuoi registri e ricevi avvisi in base alla tua storia, gratis per i nuovi iscritti idonei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz wzory w dziennikach i uzyskać ostrzeżenia oparte na historii, bezpłatnie dla uprawnionych nowych abonentów."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lásd minták a naplók és kap figyelmeztető a történelem alapján, ingyenes jogosult új előfizetők."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso kaavoja lokit ja saada hälytyksiä perusteella historian, ilmaiseksi hyväksyttävät uudet tilaajat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i loggene og få varsler basert på din historie, gratis for kvalifiserte nye abonnenter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mønstre i dine logfiler og få advarsler baseret på din historie, gratis for støtteberettigede nye abonnenter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите шаблоны в своих журналах и получайте оповещения на основе вашей истории, бесплатно для новых подписчиков."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja padrões em seus registros e receba alertas com base em seu histórico, gratuitos para novos assinantes elegíveis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте шаблони в журналах і отримуйте сповіщення на основі вашої історії, безкоштовно для отримання нових абонентів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les modèles dans vos journaux et obtenez des alertes en fonction de votre historique, gratuitement pour les nouveaux abonnés admissibles."
          }
        }
      }
    },
