    "Great start! Pro highlights patterns in your logs across time, sleep, weather, and more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great start! Pro highlights patterns in your logs across time, sleep, weather, and more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Anfang! Pro zeigt Muster in deinen Einträgen zu Uhrzeit, Schlaf, Wetter und mehr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を始めましょう。Proでは、時間帯、睡眠、天気などに関するパターンを確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Buen comienzo! Pro destaca patrones en tus registros sobre horarios, sueño, tiempo y otros datos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo inizio! Pro mette in evidenza gli andamenti nei tuoi registri relativi a orari, sonno, meteo e altro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobry początek! Pro pokazuje wzorce w twoich wpisach dotyczące pory dnia, snu, pogody i innych danych."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jó kezdet! A Pro kiemeli az időpontokkal, alvással, időjárással és más adatokkal kapcsolatos mintázatokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvä alku! Pro nostaa esiin kirjauksiesi aikaan, uneen, säähän ja muuhun liittyviä kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "God start! Pro viser mønstre i registreringene dine for tidspunkt, søvn, vær og mer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "God begyndelse! Pro fremhæver mønstre i dine registreringer om tidspunkter, søvn, vejr og mere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отличное начало! Pro показывает закономерности в записях о времени, сне, погоде и других данных."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bom começo! O Pro destaca padrões nos teus registos de horário, sono, meteorologia e outros dados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудовий початок! Pro показує закономірності у твоїх записах про час, сон, погоду та інші дані."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon début ! Pro fait ressortir les tendances de vos notes concernant les horaires, le sommeil, la météo et plus encore."
          }
        }
      }
    },
