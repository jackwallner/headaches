    "%lld headaches logged, building a useful history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld headaches logged, building a useful history"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Kopfschmerz-Einträge erfasst. Deine Übersicht wächst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を%lld件記録しました。記録を続けて傾向を見ていきましょう。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has registrado %lld dolores de cabeza; sigue así para crear un historial útil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai registrato %lld mal di testa. Continua per creare uno storico utile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano %lld bólów głowy. Kontynuuj, aby zbudować przydatną historię."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fejfájást rögzítettél. Folytasd, hogy idővel hasznos előzményeket gyűjts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet kirjannut %lld päänsärkyä. Jatka, niin saat koottua hyödyllisen historian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har registrert %lld hodepiner. Fortsett for å bygge opp en nyttig historikk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har registreret %lld hovedpiner. Fortsæt for at opbygge en nyttig historik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты записал %lld головных болей. Продолжай, чтобы собрать полезную историю."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dores de cabeça registadas: %lld. Continua a registar para criares um histórico útil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записано випадків головного болю: %lld. Продовжуй, щоб зібрати корисну історію."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maux de tête notés : %lld. Continuez pour constituer un historique utile."
          }
        }
      }
    },
