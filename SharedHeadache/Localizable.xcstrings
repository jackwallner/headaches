    "Coloured cells mark days you logged a headache. Darker means a more severe attack when severity was rated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloured cells mark days you logged a headache. Darker means a more severe attack when severity was rated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbige Felder markieren Tage mit einem Eintrag. Dunklere Felder stehen für einen höheren angegebenen Schweregrad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きのマスは頭痛を記録した日を示します。重症度を評価した日は、濃い色ほど重い頭痛です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las celdas coloreadas indican los días en que registraste dolor de cabeza. Si valoraste la intensidad, un tono más oscuro indica un dolor más intenso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le celle colorate indicano i giorni in cui hai registrato un mal di testa. Se hai valutato l’intensità, un colore più scuro indica un mal di testa più intenso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolorowe pola oznaczają dni, w których zapisano ból głowy. Jeśli oceniono nasilenie, ciemniejszy kolor oznacza silniejszy ból."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színes cellák jelölik a fejfájásos napokat. Sötétebb szín jelzi az erősebb fájdalmat az értékeléssel ellátott napokon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värilliset solut merkitsevät päiviä, joina kirjasit päänsäryn. Tummempi väri tarkoittaa voimakkaampaa kipua, jos arvioit voimakkuuden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargede felt viser dager du registrerte hodepine. Mørkere felt betyr sterkere smerte på dager der du vurderte alvorlighetsgraden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farvede felter markerer dage, hvor du registrerede hovedpine. Mørkere felter betyder stærkere smerter på dage, hvor du vurderede intensiteten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветные ячейки отмечают дни, когда ты записал головную боль. Более тёмный цвет означает более сильную боль в дни, когда ты оценивал её интенсивность."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As células coloridas assinalam os dias em que registaste uma dor de cabeça. As mais escuras indicam maior intensidade, quando foi avaliada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольорові клітинки позначають дні, коли ти записав головний біль. Темніший колір означає вищу оцінену інтенсивність."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cellules colorées indiquent les jours où vous avez noté un mal de tête. Une couleur plus foncée indique une intensité évaluée comme plus forte."
          }
        }
      }
    },
