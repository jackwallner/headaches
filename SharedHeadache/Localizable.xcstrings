    "Forecast alerts based on patterns in your logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forecast alerts based on patterns in your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetterhinweise auf Grundlage der Muster in deinen Einträgen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のパターンに基づく予報通知。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos de previsión basados en patrones de tus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi meteo basati sugli andamenti nei tuoi registri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia o prognozie oparte na wzorcach z twoich wpisów."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzéseid mintázatain alapuló előrejelzési értesítések."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauksiesi kuvioihin perustuvat ennusteilmoitukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Værvarsler basert på mønstrene i registreringene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler fra vejrudsigten baseret på mønstrene i dine registreringer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
