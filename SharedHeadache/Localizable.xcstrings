    "# Device fields include battery level, charging, low power mode, and motion activity captured when you logged the headache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Device fields include battery level, charging, low power mode, and motion activity captured when you logged the headache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zu den Gerätedaten gehören Akkustand, Ladezustand, Stromsparmodus und Bewegungsdaten, die beim Eintragen eines Kopfschmerzes erfasst wurden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# デバイス情報には、頭痛を記録した時点のバッテリー残量、充電状態、低電力モード、動作データが含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos del dispositivo incluyen la batería, la carga, el modo de bajo consumo y la actividad de movimiento registrados al anotar el dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi del dispositivo includono il livello della batteria, lo stato di ricarica, il risparmio energetico e i dati di movimento rilevati quando registri il mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Informacje o urządzeniu obejmują poziom baterii, ładowanie, tryb niskiego zużycia energii i dane o ruchu z chwili zapisania bólu głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Az eszközadatok közé tartozik az akkumulátor töltöttsége, a töltés állapota, az alacsony töltöttségű mód és a mozgás rögzítéskor mért adatai."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Laitetietoihin kuuluvat akun varaus, lataus, virransäästötila ja kirjaushetken liikkumistiedot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Enhetsdata omfatter batterinivå, lading, spareblussmodus og bevegelse da du registrerte hodepinen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Enhedsdata omfatter batteriniveau, opladning, energibesparende funktion og bevægelse, som blev registreret, da du noterede hovedpinen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Данные устройства включают уровень заряда, зарядку, режим энергосбережения и сведения о движении на момент записи головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos do dispositivo incluem o nível da bateria, o estado de carregamento, o modo de baixo consumo e a atividade motora registados quando anotaste a dor de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# У полях пристрою вказано рівень заряду, заряджання, режим енергозбереження та рухову активність, зафіксовані під час запису головного болю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs de l’appareil indiquent le niveau de batterie, la recharge, le mode économie d’énergie et l’activité motrice relevés lors de la note du mal de tête."
          }
        }
      }
    },
    "# Empty quoted cells mean a value was unavailable or was not recorded for that event.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Empty quoted cells mean a value was unavailable or was not recorded for that event."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Leere, in Anführungszeichen gesetzte Felder bedeuten, dass ein Wert für diesen Eintrag nicht verfügbar war oder nicht erfasst wurde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 引用符で囲まれた空欄は、その記録で値を取得できなかったか、記録されなかったことを示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Las celdas vacías entre comillas indican que no había un valor disponible o que no se registró en esa entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Le celle vuote tra virgolette indicano che il dato non era disponibile o non è stato registrato per quella voce."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Puste komórki w cudzysłowie oznaczają, że dana wartość była niedostępna lub nie została zapisana dla tego wpisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Az üres, idézőjelek közötti mezők azt jelentik, hogy az adat nem volt elérhető vagy nem került rögzítésre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tyhjä lainausmerkeissä oleva solu tarkoittaa, ettei arvo ollut saatavilla tai sitä ei kirjattu tapahtumalle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tomme celler i anførselstegn betyr at en verdi ikke var tilgjengelig eller ikke ble registrert for hendelsen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tomme celler i anførselstegn betyder, at en værdi ikke var tilgængelig eller ikke blev registreret for hændelsen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Пустые ячейки в кавычках означают, что значение было недоступно или не записано для этого события."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# As células vazias entre aspas indicam que um dado não estava disponível ou não foi registado nesse episódio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Порожні клітинки в лапках означають, що значення було недоступним або його не записано для цієї події."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les cellules vides entre guillemets indiquent qu’une donnée était indisponible ou n’a pas été enregistrée pour cette entrée."
          }
        }
      }
    },
    "# Environment fields include location, weather, temperature, humidity, pressure, precipitation, wind, cloud cover, UV, dew point, air quality, pollutants, and pollen when available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Environment fields include location, weather, temperature, humidity, pressure, precipitation, wind, cloud cover, UV, dew point, air quality, pollutants, and pollen when available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zu den Umweltdaten gehören, sofern verfügbar, Standort, Wetter, Temperatur, Luftfeuchtigkeit, Luftdruck, Niederschlag, Wind, Bewölkung, UV-Index, Taupunkt, Luftqualität, Schadstoffe und Pollen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 環境情報には、取得できる場合、位置情報、天気、気温、湿度、気圧、降水量、風、雲量、UV、露点、空気質、汚染物質、花粉が含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos ambientales incluyen, cuando están disponibles, la ubicación, el tiempo, la temperatura, la humedad, la presión, las precipitaciones, el viento, la nubosidad, el índice UV, el punto de rocío, la calidad del aire, los contaminantes y el polen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi ambientali includono, quando disponibili, posizione, meteo, temperatura, umidità, pressione, precipitazioni, vento, copertura nuvolosa, UV, punto di rugiada, qualità dell’aria, inquinanti e polline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Dane o środowisku obejmują, gdy są dostępne, lokalizację, pogodę, temperaturę, wilgotność, ciśnienie, opady, wiatr, zachmurzenie, UV, punkt rosy, jakość powietrza, zanieczyszczenia i pyłki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# A környezeti adatok, ha elérhetők, a helyet, az időjárást, a hőmérsékletet, a páratartalmat, a légnyomást, a csapadékot, a szelet, a felhőzetet, az UV-sugárzást, a harmatpontot, a levegőminőséget, a szennyező anyagokat és a pollent tartalmazzák."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ympäristötietoihin kuuluvat saatavuuden mukaan sijainti, sää, lämpötila, kosteus, ilmanpaine, sade, tuuli, pilvisyys, UV-säteily, kastepiste, ilmanlaatu, epäpuhtaudet ja siitepöly."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Miljødata omfatter, når tilgjengelig, sted, vær, temperatur, luftfuktighet, lufttrykk, nedbør, vind, skydekke, UV, duggpunkt, luftkvalitet, forurensning og pollen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Miljødata omfatter, når de er tilgængelige, sted, vejr, temperatur, luftfugtighed, lufttryk, nedbør, vind, skydække, UV, dugpunkt, luftkvalitet, forurenende stoffer og pollen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Данные об окружающей среде, если они доступны, включают местоположение, погоду, температуру, влажность, давление, осадки, ветер, облачность, УФ-излучение, точку росы, качество воздуха, загрязнители и пыльцу."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos do ambiente incluem localização, condições meteorológicas, temperatura, humidade, pressão, precipitação, vento, nebulosidade, UV, ponto de orvalho, qualidade do ar, poluentes e pólen, quando disponíveis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Дані про довкілля можуть містити місце, погоду, температуру, вологість, тиск, опади, вітер, хмарність, UV, точку роси, якість повітря, забруднювачі та пилок."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les données environnementales incluent, si elles sont disponibles, le lieu, la météo, la température, l’humidité, la pression, les précipitations, le vent, la couverture nuageuse, les UV, le point de rosée, la qualité de l’air, les polluants et le pollen."
          }
        }
      }
    },
    "# Health fields include activity, sleep, heart, breathing, audio, mindful minutes, workouts, intake, blood pressure, blood glucose, daylight, and cycle data when Apple Health access is allowed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Health fields include activity, sleep, heart, breathing, audio, mindful minutes, workouts, intake, blood pressure, blood glucose, daylight, and cycle data when Apple Health access is allowed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zu den Gesundheitsdaten gehören Aktivität, Schlaf, Herz, Atmung, Audio, Achtsamkeitsminuten, Training, Nahrungsaufnahme, Blutdruck, Blutzucker, Tageslicht und Zyklusdaten, sofern der Zugriff auf Apple Health erlaubt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# Apple Healthへのアクセスが許可されている場合、健康情報には活動、睡眠、心拍、呼吸、音声、マインドフル時間、ワークアウト、摂取量、血圧、血糖値、日照時間、周期データが含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de Salud incluyen la actividad, el sueño, el corazón, la respiración, la exposición al audio, los minutos de atención plena, los entrenamientos, la ingesta, la presión arterial, la glucosa en sangre, la luz diurna y los datos del ciclo, si has permitido el acceso a Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I dati di Salute includono attività, sonno, cuore, respirazione, esposizione audio, minuti di mindfulness, allenamenti, assunzione di alimenti e bevande, pressione sanguigna, glicemia, luce diurna e dati del ciclo, se consenti l’accesso ad Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Dane aplikacji Zdrowie obejmują aktywność, sen, pracę serca, oddychanie, ekspozycję na dźwięk, minuty uważności, treningi, spożycie, ciśnienie krwi, glikemię, światło dzienne i dane o cyklu, jeśli zezwolisz na dostęp Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Az Egészség-adatok közé tartozik az aktivitás, az alvás, a szív, a légzés, a hangkitettség, a tudatos jelenlét percei, az edzések, a bevitel, a vérnyomás, a vércukorszint, a napfény és a ciklus adatai, ha engedélyezed az Apple Health-hozzáférést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Terveystietoihin kuuluvat aktiivisuus, uni, sydän, hengitys, äänialtistus, tietoisen läsnäolon minuutit, harjoitukset, saanti, verenpaine, verensokeri, päivänvalo ja kiertoon liittyvät tiedot, jos annat luvan Apple Healthin käyttöön."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Helseopplysninger omfatter aktivitet, søvn, hjerte, pust, lydeksponering, minutter med oppmerksomt nærvær, treningsøkter, inntak, blodtrykk, blodsukker, dagslys og syklusdata når du har gitt tilgang til Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Sundhedsdata omfatter aktivitet, søvn, hjerte, vejrtrækning, lydeksponering, mindfulnessminutter, træning, indtag, blodtryk, blodsukker, dagslys og cyklusdata, hvis du giver adgang til Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Данные о здоровье включают активность, сон, работу сердца, дыхание, воздействие звука, минуты осознанности, тренировки, питание, давление, глюкозу крови, дневной свет и данные цикла, если ты разрешил доступ к Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de saúde incluem atividade, sono, coração, respiração, exposição a áudio, minutos de atenção plena, treinos, ingestão, pressão arterial, glicemia, luz natural e dados do ciclo, se autorizares o acesso à app Saúde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Дані про здоров’я можуть містити активність, сон, роботу серця, дихання, вплив звуку, хвилини усвідомленості, тренування, споживання води, артеріальний тиск, рівень глюкози, денне світло та дані циклу, якщо надано доступ до Здоров’я."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les données de santé incluent l’activité, le sommeil, le cœur, la respiration, l’exposition audio, les minutes de pleine conscience, les entraînements, les apports, la tension artérielle, la glycémie, la lumière du jour et le cycle, si l’accès à Santé est autorisé."
          }
        }
      }
    },
