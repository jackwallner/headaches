    "US AQI 100 is \"unhealthy for sensitive groups\". 150+ is unhealthy for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 is \"unhealthy for sensitive groups\". 150+ is unhealthy for everyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein US-AQI von 100 gilt als „ungesund für empfindliche Gruppen“, ab 150 als ungesund für alle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100は「影響を受けやすい人にとって不健康」、150以上はすべての人にとって不健康とされます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un AQI de EE. UU. de 100 se considera «perjudicial para grupos sensibles»; a partir de 150, «perjudicial para todos»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un AQI USA di 100 è considerato «non salutare per i gruppi sensibili»; da 150 in su, «non salutare per tutti»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AQI USA 100 oznacza „niezdrowe dla osób wrażliwych”, a 150+ „niezdrowe dla wszystkich”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 100-as amerikai AQI az érzékeny csoportok számára egészségtelen, a 150+ mindenki számára egészségtelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdysvaltain AQI 100 on epäterveellinen herkille ryhmille, ja 150+ on epäterveellinen kaikille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 er «usunt for følsomme grupper». 150+ er usunt for alle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 er «usundt for følsomme grupper». 150+ er usundt for alle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 означает «вредно для чувствительных групп», а 150+ вредно для всех."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 é considerado «prejudicial para grupos sensíveis». A partir de 150, é prejudicial para todos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 вважається шкідливим для чутливих груп, а 150+ шкідливим для всіх."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un US AQI de 100 est considéré comme nocif pour les groupes sensibles. À partir de 150, il est nocif pour tous."
          }
        }
      }
    },
