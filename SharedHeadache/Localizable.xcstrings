          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus días libres de dolor de cabeza"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi giorni senza mal di testa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dni bez głowy"
          }
        },
        "hu": {
          "stringUnit": {
