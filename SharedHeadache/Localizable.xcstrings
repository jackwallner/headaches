    "Still partial. You can email the developer from the event card.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still partial. You can email the developer from the event card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung ist weiterhin unvollständig. Kontaktiere den Entwickler über die Eintragskarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のデータを取得できていません。記録のカードから開発者にメールできます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información sigue incompleta. Puedes escribir al desarrollador desde la tarjeta del registro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sono ancora parziali. Puoi scrivere allo sviluppatore dalla scheda della registrazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nadal są częściowe. Możesz napisać do dewelopera z karty wpisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Továbbra is csak részlegesek az adatok. A bejegyzés kártyájáról e-mailt írhatsz a fejlesztőnek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedot ovat yhä osittaiset. Voit lähettää kehittäjälle sähköpostia tapahtumakortista."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplysningene er fortsatt ufullstendige. Du kan sende en e-post til utvikleren fra registreringskortet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplysningerne er stadig ufuldstændige. Du kan sende en e-mail til udvikleren fra registreringskortet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные по-прежнему неполные. Ты можешь написать разработчику с карточки записи."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo continua incompleto. Podes enviar um email ao programador através do cartão do registo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані все ще неповні. Напиши розробнику з картки запису."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données restent partielles. Vous pouvez envoyer un e-mail au développeur depuis la fiche de la note."
          }
        }
      }
    },
    "Still watching for a clear pattern": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still watching for a clear pattern"
