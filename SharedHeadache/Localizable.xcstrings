    "Headaches were logged %@ more often after %@ of sleep (%lld%% vs %lld%% overall). Median: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headaches were logged %@ more often after %@ of sleep (%lld%% vs %lld%% overall). Median: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %@ Schlaf hast du %@ häufiger einen Eintrag erfasst (%lld%% statt %lld%% insgesamt). Median: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@多く頭痛を記録しました。睡眠時間は%@で、割合は全体の%lld%%に対して%lld%%でした。中央値: %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registraste dolor de cabeza %@ más a menudo tras dormir %@ (%lld%% frente al %lld%% general). Mediana: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai registrato mal di testa %@ più spesso dopo %@ di sonno (%lld%% rispetto al %lld%% complessivo). Mediana: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ból głowy zapisywano %@ częściej po %@ snu (%lld%% w porównaniu z %lld%% ogółem). Mediana: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-szor gyakrabban rögzítettél fejfájást %@ alvás után (%lld%%, az összes nap %lld%%-ával szemben). Medián: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päänsärky kirjattiin %@ useammin %@ unen jälkeen (%lld%%, kaikkien päivien osuus %lld%%). Mediaani: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodepine ble registrert %@ oftere etter %@ søvn (%lld%% mot %lld%% totalt). Median: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedpine blev registreret %@ oftere efter %@ søvn (%lld%% mod %lld%% samlet set). Median: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сна продолжительностью %@ головную боль записывали на %@ чаще (%lld%% против %lld%% в среднем). Медиана: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As dores de cabeça foram registadas %@ mais vezes após %@ de sono (%lld%% contra %lld%% no total). Mediana: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після сну тривалістю %@ головний біль записували на %@ частіше (%lld%% проти %lld%% загалом). Медіана: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les maux de tête ont été notés %@ plus souvent après %@ de sommeil (%lld%% contre %lld%% au total). Médiane : %@."
          }
        }
      }
    },
    "Health and location are read-only and only used to enrich logs with context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health and location are read-only and only used to enrich logs with context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health- und Standortdaten werden nur gelesen und ergänzen deine Einträge um Kontext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアと位置情報は読み取り専用で、記録に関連データを追加するためだけに使います。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app solo consulta Salud y tu ubicación para añadir contexto a tus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app legge i dati di Salute e la posizione solo per aggiungere contesto alle registrazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja tylko odczytuje dane o zdrowiu i lokalizacji, aby uzupełnić wpisy o dodatkowy kontekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Egészség- és helyadatokat az alkalmazás csak olvassa, és kizárólag a bejegyzések kiegészítésére használja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terveys- ja sijaintitietoja luetaan vain kirjausten taustatiedoiksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Helse- og posisjonsdata leses bare for å gi registreringene mer kontekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundheds- og positionsdata læses kun for at give registreringerne mere kontekst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о здоровье и местоположении доступны только для чтения и используются лишь для дополнения записей."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de saúde e a localização são apenas consultados e servem para acrescentar contexto aos registos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані Здоров’я та місце розташування лише зчитуються й додають контекст до записів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de Santé et de localisation sont consultées uniquement pour ajouter du contexte à vos notes."
          }
        }
      }
    },
