    "No single signal yet stands out. Continued logging can show patterns over time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No single signal yet stands out. Continued logging can show patterns over time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher sticht kein einzelnes Signal hervor. Weitere Einträge können mit der Zeit Muster zeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点で目立つ信号はありません。記録を続けると、時間の経過とともにパターンが見えてくることがあります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no destaca ninguna señal. Si sigues registrando datos, con el tiempo podrán aparecer patrones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora non emerge alcun segnale. Continuando a registrare i dati, nel tempo potrebbero apparire degli andamenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie nie wyróżnia się żaden sygnał. Dalsze zapisywanie danych może z czasem ujawnić wzorce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik jel sem tűnik még ki. A további rögzítés idővel mintázatokat mutathat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään signaali ei vielä erotu. Jatkamalla kirjaamista voit nähdä ajan myötä muodostuvia kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen signaler skiller seg ut ennå. Flere registreringer kan vise mønstre over tid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet signal skiller sig ud endnu. Flere registreringer kan vise mønstre over tid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ни один сигнал не выделяется. Новые записи со временем могут показать закономерности."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há um sinal que se destaque. Continua a registar para veres como os padrões evoluem com o tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки жоден окремий сигнал не вирізняється. Регулярні записи допоможуть побачити закономірності з часом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal ne se distingue pour le moment. En continuant à noter vos maux de tête, vous pourrez faire ressortir des tendances."
          }
        }
      }
    },
