    "Location is off. Without it the app can't fetch your local forecast.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off. Without it the app can't fetch your local forecast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist deaktiviert. Ohne ihn kann die App keine lokale Vorhersage abrufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報がオフです。オンにすると地域の予報を取得できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está desactivada. Actívala para obtener la previsión local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è disattivata. Attivala per ricevere le previsioni locali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja jest wyłączona. Włącz ją, aby pobrać lokalną prognozę."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás ki van kapcsolva. Enélkül az alkalmazás nem tudja lekérni a helyi előrejelzést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijainti on pois käytöstä. Ilman sitä sovellus ei voi hakea paikallista ennustetta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjon er slått av. Uten den kan ikke appen hente værmeldingen for området ditt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Position er slået fra. Uden den kan appen ikke hente den lokale vejrudsigt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокация выключена. Без неё приложение не сможет получить местный прогноз."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização está desativada. Sem ela, a app não consegue obter a previsão meteorológica local."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокацію вимкнено. Без неї програма не зможе отримати місцевий прогноз погоди."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée. Sans elle, l’app ne peut pas récupérer les prévisions météo locales."
          }
        }
      }
    },
    "Location permission is required for weather and place context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is required for weather and place context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Wetter- und Ortsangaben ist der Standortzugriff erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気や場所の情報を取得するには位置情報へのアクセスが必要です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso de ubicación para obtener el tiempo y el nombre del lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ottenere il meteo e il nome del luogo è necessario il permesso di posizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest wymagany, aby pobrać pogodę i nazwę miejsca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időjárási és helyadatokhoz engedélyezned kell a helymeghatározást."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintilupa tarvitaan säätä ja paikkatietoa varten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang trengs for vær- og stedsinformasjon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til position er nødvendig for vejr- og stedsoplysninger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для получения данных о погоде и месте нужно разрешить доступ к геолокации."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app precisa de acesso à localização para acrescentar dados meteorológicos e indicar o local."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отримання прогнозу погоди й даних про місце потрібен доступ до геолокації."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la localisation est nécessaire pour ajouter la météo et le lieu aux notes."
          }
        }
      }
    },
