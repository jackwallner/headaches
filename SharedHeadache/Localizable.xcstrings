    "Do certain foods or drinks seem to be linked with your headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do certain foods or drinks seem to be linked with your headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheinen bestimmte Lebensmittel oder Getränke mit deinen Kopfschmerzen zusammenzuhängen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の食べ物や飲み物と頭痛に関連があると感じますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Crees que algunos alimentos o bebidas podrían estar relacionados con tus dolores de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensi che alcuni cibi o bevande possano essere associati ai tuoi mal di testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy niektóre potrawy lub napoje wydają się związane z twoimi bólami głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, hogy bizonyos ételek vagy italok összefüggnek a fejfájásaiddal?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaatko yhteyden joidenkin ruokien tai juomien ja päänsärkyjesi välillä?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Virker det som enkelte matvarer eller drikker henger sammen med hodepinene dine?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virker det, som om bestemte madvarer eller drikke hænger sammen med dine hovedpiner?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажется ли тебе, что некоторые продукты или напитки связаны с головными болями?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece haver uma relação entre certos alimentos ou bebidas e as tuas dores de cabeça?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи помічав ти зв’язок між певною їжею або напоями та головним болем?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains aliments ou boissons semblent-ils associés à vos maux de tête ?"
          }
        }
      }
    },
    "Do you notice headaches after poor or too little sleep?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you notice headaches after poor or too little sleep?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du nach schlechtem oder zu kurzem Schlaf Kopfschmerzen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の質が悪い、または睡眠時間が短いときに頭痛が起きると感じますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Notas dolor de cabeza después de dormir mal o poco?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Noti mal di testa dopo aver dormito male o troppo poco?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy po złym lub zbyt krótkim śnie pojawia się u ciebie ból głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapasztalsz fejfájást rossz vagy túl rövid alvás után?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaatko päänsärkyä huonosti nukutun tai liian lyhyen yön jälkeen?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får du hodepine etter dårlig eller for lite søvn?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Får du hovedpine efter dårlig eller for lidt søvn?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бывает ли у тебя головная боль после плохого или слишком короткого сна?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Costumas registar dores de cabeça depois de dormires mal ou pouco?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи помічаєш головний біль після поганого або короткого сну?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous remarqué des maux de tête après une mauvaise nuit ou un sommeil trop court ?"
          }
        }
      }
    },
