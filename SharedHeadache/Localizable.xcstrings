    "You stay headache-free on %@ of days with %@, the best of any condition tracked. Overall you log a headache on %@ of days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stay headache-free on %@ of days with %@, the best of any condition tracked. Overall you log a headache on %@ of days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %@ der Tage mit %@ warst du kopfschmerzfrei, der höchste Wert aller erfassten Bedingungen. Insgesamt hattest du an %@ der Tage Kopfschmerzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の条件では%@の日に頭痛がなく、記録した条件の中で最も高い割合でした。全体では%@の日に頭痛を記録しています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No registraste dolor de cabeza en el %@ de los días con %@, la proporción más alta entre las condiciones analizadas. En general, registras dolor de cabeza en el %@ de los días."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei giorni con %@, non hai registrato mal di testa nel %@, la percentuale più alta tra le condizioni osservate. Nel complesso, registri mal di testa nel %@ dei giorni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wśród dni z warunkiem „%@” odsetek dni bez bólu głowy wyniósł %@, najwięcej spośród obserwowanych warunków. Ogółem zapisujesz ból głowy w %@ dni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ feltétel mellett a napok %@-án nem jelentkezett fejfájás, ez a legjobb arány a vizsgált feltételek között. Összességében a napok %@-án rögzítesz fejfájást."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %@, päänsärkyä ei ollut %@ päivänä. Tämä oli paras osuus seuratuista olosuhteista. Kaiken kaikkiaan kirjaat päänsäryn %@ päivänä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For «%@» var %@ av dagene uten hodepine, den høyeste andelen blant forholdene som spores. Totalt registrerer du hodepine på %@ av dagene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På dage med %@ var du uden hovedpine %@ af dagene, den største andel af de forhold, der følges. Samlet set registrerer du hovedpine på %@ af dagene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При условии %@ головной боли не было в %@ дней, это лучший показатель среди отслеживаемых условий. В целом ты записываешь головную боль в %@ дней."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficaste sem dor de cabeça em %@ dos dias com %@, a percentagem mais elevada entre as condições analisadas. No geral, registaste dor de cabeça em %@ dos dias."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У дні з %@ головний біль не виникав у %@ випадках, це найкращий показник серед відстежуваних умов. Загалом головний біль записано у %@ днів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas noté de mal de tête pendant %@ des jours avec %@, la meilleure proportion parmi les conditions suivies. Globalement, vous en notez un %@ des jours."
          }
        }
      }
    },
    "You'll be notified when forecast conditions match patterns in your logs. Tap to tune thresholds and quiet hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be notified when forecast conditions match patterns in your logs. Tap to tune thresholds and quiet hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst einen Hinweis, wenn die Vorhersage zu Mustern in deinen Einträgen passt. Tippe hier, um Schwellenwerte und Ruhezeiten anzupassen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報が記録のパターンと一致すると通知します。タップしてしきい値や通知しない時間を設定してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un aviso cuando la previsión coincida con patrones de tus registros. Toca para ajustar los umbrales y las horas de silencio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai un avviso quando le previsioni corrispondono agli andamenti nei tuoi registri. Tocca per regolare soglie e ore di silenzio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz powiadomienie, gdy prognoza będzie pasować do wzorców w twoich wpisach. Dotknij, aby ustawić progi i godziny ciszy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítést kapsz, ha az előrejelzés egyezik a bejegyzéseid mintázataival. Koppints a küszöbértékek és a csendes időszakok beállításához."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun ennuste vastaa kirjaustesi kuvioita. Säädä raja-arvoja ja hiljaisia aikoja napauttamalla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du varsles når værmeldingen samsvarer med mønstrene i registreringene dine. Trykk for å justere terskler og stilleperioder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får besked, når vejret matcher mønstre i dine registreringer. Tryk for at justere grænser og stilleperioder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты получишь уведомление, когда прогноз совпадёт с закономерностями в записях. Нажми, чтобы настроить пороги и часы тишины."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás uma notificação quando a previsão corresponder aos padrões dos teus registos. Toca para ajustar os limites e o horário de silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти отримуватимеш сповіщення, коли прогноз відповідатиме закономірностям у твоїх записах. Торкнись, щоб налаштувати пороги й години тиші."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une notification lorsque les prévisions correspondent aux tendances de vos notes. Touchez pour régler les seuils et les heures de silence."
          }
        }
      }
    },
    "You'll be notified when the forecast matches a supported personal trigger. Tap to tune thresholds and quiet hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be notified when the forecast matches a supported personal trigger. Tap to tune thresholds and quiet hours."
