    "After %@ of sleep, headaches were logged on %lld%% of days, compared with %lld%% across days with sleep data. Median sleep before a headache: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %@ of sleep, headaches were logged on %lld%% of days, compared with %lld%% across days with sleep data. Median sleep before a headache: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %@ des Schlafes wurden Kopfschmerzen auf %lld%% von Tagen aufgezeichnet, verglichen mit %lld%% über Tage mit Schlafdaten. Mittlerer Schlaf vor Kopfschmerzen: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の%@の後で、頭痛は%lld%%に、睡眠データとの日を渡る%lld%%と比較されて記録されました。 頭痛の前のメディア睡眠: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras dormir %@, se registraron dolores de cabeza en el %lld%% de los días, frente al %lld%% de los días con datos de sueño. Sueño mediano antes del dolor de cabeza: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo %@ di sonno, i mal di testa sono stati registrati su %lld%% di giorni, rispetto a %lld%% di giorni con dati di sonno. Dormire mediana prima di un mal di testa: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %@ snu ból głowy odnotowano w %lld%% dni, wobec %lld%% dni z danymi o śnie. Mediana snu przed bólem głowy: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ alvás utáni napok %lld%%-án fejfájást rögzítettek, szemben az alvásadatokkal rendelkező napok %lld%%-ával. A fejfájás előtti alvás mediánja: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:n jälkeen päänsärkyä kirjattiin päivien %lld%%:lla verrattuna %lld%%:ään päivien aikana. Mediaaniuni ennen päänsärkyä: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter %@ søvn ble hodepine loggført på %lld%% av dagene, mot %lld%% blant dager med søvndata. Median søvn før hodepine: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter %@ søvn blev hovedpine registreret på %lld%% af dagene, mod %lld%% blandt dage med søvndata. Median søvn før hovedpine: %@."
          }
        },
        "ru": {
          "stringUnit": {
