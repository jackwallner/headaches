    "Alert text shows how often headaches appeared on similar days in your logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert text shows how often headaches appeared on similar days in your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmtext zeigt, wie oft Kopfschmerzen an ähnlichen Tagen in Ihren Protokollen aufgetreten sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラートテキストは、あなたのログの同様の日に頭痛が現れる頻度を示しています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de alerta muestra la frecuencia con que los dolores de cabeza aparecieron en días similares en sus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo di avviso mostra quanto spesso i mal di testa sono apparsi in giorni simili nei registri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst alarmowy pokazuje, jak często bóle głowy pojawiały się w podobnych dniach w dziennikach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztető szöveg mutatja, milyen gyakran fejfájás megjelent hasonló napokon a naplók."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytysteksti osoittaa, kuinka usein päänsärkyä ilmestyi samankaltaisina päivinä lokit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert tekst viser hvor ofte hodepine dukker opp på lignende dager i loggene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert tekst viser, hvor ofte hovedpine dukkede op på lignende dage i dine logfiler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В тексте оповещения показано, как часто головные боли появлялись в аналогичные дни в ваших журналах."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de alerta mostra quantas dores de cabeça apareceram em dias semelhantes em seus registros."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте текст показує, як часто з'являються головні болі аналогічні дні в журналах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte d'alerte montre à quelle fréquence des maux de tête sont apparus les mêmes jours dans vos journaux."
          }
        }
      }
    },
    "Keep logging. Forecast alerts stay quiet until your history includes enough days to show a recurring weather pattern.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep logging. Forecast alerts stay quiet until your history includes enough days to show a recurring weather pattern."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen Sie weiter. Prognosewarnungen bleiben ruhig, bis Ihre Geschichte genügend Tage umfasst, um ein wiederkehrendes Wettermuster anzuzeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを保存します。 予報アラートは、再発気象パターンを示すために十分な日が含まれているまで静かにとどまります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue registrando. Las alertas prefabricadas permanecen tranquilas hasta que su historia incluya suficientes días para mostrar un patrón de tiempo recurrente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a scavare. Gli avvisi di previsione rimangono silenziosi finché la tua storia non include abbastanza giorni per mostrare un modello di tempo ricorrente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przestawaj. Ostrzeżenia prognozy pozostają ciche, aż historia zawiera wystarczająco dni, aby pokazać powtarzający się wzór pogody."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytasd a naplózást. Az előrejelzési riasztás csendes marad, amíg a történelmük nem tartalmaz elég napot, hogy visszatérő időjárást mutassanak."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkakaa hakkuita. Ennuste hälytykset pysyvät hiljaa, kunnes historiassa on tarpeeksi päiviä näyttää toistuvia sääkuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett å logge. Prognosevarsler holder seg stille til historien inkluderer nok dager til å vise et gjentatt værmønster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv ved med at logge. Forebyggende advarsler forblive stille, indtil din historie omfatter nok dage til at vise en tilbagevendende vejr mønster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте лесозаготовку. Предупреждения о прогнозе остаются тихими, пока ваша история не включает в себя достаточно дней, чтобы показать повторяющуюся погодную картину."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registar. Alertas de previsão permanecem quietos até que sua história inclua dias suficientes para mostrar um padrão climático recorrente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструватися. Прогнозні оповіщення залишаються тихими, поки ваша історія включає в себе достатні дні, щоб показати повторюваний варіант погоди."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à enregistrer. Les alertes de prévisions restent calmes jusqu'à ce que votre histoire comprenne suffisamment de jours pour montrer un schéma météorologique récurrent."
          }
        }
      }
    },
