    "Few forecast signals match patterns in your logs. This does not predict whether you will have a headache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Few forecast signals match patterns in your logs. This does not predict whether you will have a headache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenige Prognosesignale passen zu Mustern in deinen Einträgen. Daraus lässt sich nicht ableiten, ob du Kopfschmerzen bekommen wirst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報信号の一部が記録のパターンと一致しています。頭痛が起きるかどうかを予測するものではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas señales de la previsión coinciden con patrones de tus registros. Esto no predice si tendrás dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi segnali delle previsioni corrispondono agli andamenti nei tuoi registri. Questo non prevede se avrai un mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewiele sygnałów z prognozy pasuje do wzorców w twoich wpisach. Nie przewiduje to, czy wystąpi ból głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevés előrejelzési jel egyezik a bejegyzéseid mintázataival. Ez nem jelzi előre, hogy lesz-e fejfájásod."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harvat ennustesignaalit vastaavat kirjauksiesi kuvioita. Tämä ei ennusta, saatko päänsäryn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få værmeldingssignaler samsvarer med mønstrene i registreringene dine. Dette forutsier ikke om du får hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få signaler fra vejrudsigten matcher mønstrene i dine registreringer. Det forudsiger ikke, om du får hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немногие сигналы прогноза совпадают с закономерностями в твоих записях. Это не предсказывает, будет ли у тебя головная боль."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poucos sinais da previsão correspondem a padrões nos teus registos. Isto não prevê se vais ter uma dor de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Небагато сигналів прогнозу відповідають закономірностям у твоїх записах. Це не прогнозує, чи болітиме в тебе голова."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de signaux météo correspondent aux tendances de vos notes. Cela ne permet pas de prévoir si vous aurez mal à la tête."
          }
        }
      }
    },
