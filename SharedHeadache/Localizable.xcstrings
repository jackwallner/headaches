    "Your answers help Patterns highlight areas in your logs. You can always come back later from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers help Patterns highlight areas in your logs. You can always come back later from Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antworten helfen dabei, Muster in deinen Einträgen hervorzuheben. Du kannst das Quiz später in den Einstellungen fortsetzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答をもとに、記録の中から注目する点を見つけやすくなります。「設定」からいつでも回答できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas ayudan a Patrones a destacar aspectos de tus registros. Puedes volver a ellas más tarde desde Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte aiutano Andamenti a mettere in evidenza alcuni aspetti dei tuoi registri. Puoi riprenderle quando vuoi da Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi pomagają wskazać obszary widoczne we wpisach. Możesz wrócić do quizu później w Ustawieniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszaid segítenek kiemelni a bejegyzéseidben látható mintázatokat. A Beállításokból később bármikor visszatérhetsz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi auttavat nostamaan esiin kirjauksissasi näkyviä kuvioita. Voit palata niihin myöhemmin Asetuksissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene dine hjelper med å løfte fram mønstre i registreringene. Du kan gå tilbake senere i Innstillinger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar hjælper med at fremhæve mønstre i dine registreringer. Du kan altid vende tilbage under Indstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои ответы помогут выделить закономерности в записях. Ты всегда можешь вернуться к ним в Настройках."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas respostas ajudam a destacar áreas nos teus registos. Podes voltar a estas perguntas mais tarde nas Definições."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої відповіді допомагають виділити важливі теми у записах. Повернутися до запитань можна будь-коли в Параметрах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses aident Tendances à faire ressortir des éléments dans vos notes. Vous pourrez y revenir dans Réglages."
          }
        }
      }
    },
    "Your answers will help us highlight the headache patterns most relevant to you. You can update them anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers will help us highlight the headache patterns most relevant to you. You can update them anytime in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antworten helfen uns, passende Muster in deinen Einträgen hervorzuheben. Du kannst sie jederzeit in den Einstellungen ändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答をもとに、あなたの記録に関係するパターンを表示します。「設定」からいつでも更新できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas nos ayudan a destacar los patrones más relevantes para ti. Puedes cambiarlas cuando quieras en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte ci aiutano a mettere in evidenza gli andamenti più rilevanti per te. Puoi modificarle quando vuoi in Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi pomogą nam wyróżnić wzorce dotyczące twoich bólów głowy. Możesz je zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszaid segítenek kiemelni a számodra legfontosabb fejfájásmintázatokat. A Beállításokban bármikor módosíthatod őket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaustesi avulla voimme nostaa esiin sinulle tärkeimmät päänsärkykuviot. Voit muuttaa vastauksiasi milloin tahansa Asetuksissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene dine hjelper oss med å finne hodepinemønstrene som er mest relevante for deg. Du kan endre dem når som helst i Innstillinger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar hjælper os med at fremhæve de hovedpinemønstre, der er mest relevante for dig. Du kan ændre dem når som helst under Indstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои ответы помогут выделить закономерности головной боли, наиболее важные для тебя. Ты можешь изменить их в Настройках в любое время."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas respostas ajudam a destacar os padrões mais relevantes para ti. Podes atualizá-las quando quiseres nas Definições."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої відповіді допоможуть виділити найважливіші для тебе закономірності головного болю. Їх можна змінити будь-коли в Параметрах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses nous aideront à faire ressortir les tendances les plus pertinentes pour vous. Vous pouvez les modifier à tout moment dans Réglages."
          }
        }
      }
    },
