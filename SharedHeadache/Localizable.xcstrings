          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この信号が強まる前に通知を受け取ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso antes de que esta señal aumente."
          }
        },
        "it": {
