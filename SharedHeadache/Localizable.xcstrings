    "%@ of your headaches occurred with US AQI at or above 75, the threshold where sensitive groups commonly start to feel effects.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your headaches occurred with US AQI at or above 75, the threshold where sensitive groups commonly start to feel effects."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ihrer Kopfschmerzen traten mit US AQI bei oder über 75 auf, der Schwelle, an der empfindliche Gruppen häufig Auswirkungen spüren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの頭痛の%@は、75以上のUS AQIで発生し、敏感なグループが一般的に効果を感じ始めるしきい値。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de sus dolores de cabeza ocurrieron con US AQI a o más de 75, el umbral donde grupos sensibles comúnmente comienzan a sentir efectos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del mal di testa si è verificato con US AQI a o sopra 75, la soglia in cui i gruppi sensibili comunemente iniziano a sentire effetti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ z bólów głowy wystąpił z US AQI na 75 lub powyżej, progu, w którym wrażliwe grupy zwykle zaczynają odczuwać skutki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fejfájás fordult elő a US AQI, vagy több, mint 75, a küszöbérték, ahol érzékeny csoportok gyakran kezdenek érezni hatásokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
