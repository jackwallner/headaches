    "Headache Pro summarizes patterns in your logs and gives you a heads-up about forecast changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro summarizes patterns in your logs and gives you a heads-up about forecast changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro fasst Muster in deinen Einträgen zusammen und weist dich auf Wetteränderungen in der Vorhersage hin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Proは記録のパターンをまとめ、予報の変化をお知らせします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro resume los patrones de tus registros y te avisa de cambios en la previsión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro riassume gli andamenti nei tuoi registri e ti avvisa dei cambiamenti previsti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro podsumowuje wzorce z twoich wpisów i informuje o zmianach w prognozie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Headache Pro összefoglalja a bejegyzéseid mintázatait, és előrejelzést ad az időjárási változásokról."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro kokoaa yhteen kirjauksiesi kuviot ja ilmoittaa ennusteen muutoksista."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro oppsummerer mønstrene i registreringene dine og varsler om endringer i værmeldingen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro opsummerer mønstre i dine registreringer og giver besked om ændringer i vejrudsigten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro показывает закономерности в записях и уведомляет об изменениях в прогнозе."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro resume os padrões dos teus registos e avisa-te sobre alterações na previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro підсумовує закономірності у твоїх записах і сповіщає про зміни прогнозу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro résume les tendances de vos notes et vous informe des changements météo prévus."
          }
        }
      }
    },
    "Headache Pro turns your logs into a heads-up so you can plan around risky days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro turns your logs into a heads-up so you can plan around risky days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro fasst Muster in deinen Einträgen zusammen und gibt dir einen Hinweis auf bevorstehende Wetteränderungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Proは記録に見られるパターンをもとに予報の変化をお知らせします。予定を立てる参考にしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro te avisa de cambios en la previsión basándose en tus registros, para que puedas planificar tus días."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro ti segnala cambiamenti previsti in base ai tuoi registri, così puoi organizzarti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro informuje o zmianach w prognozie na podstawie twoich wpisów, aby ułatwić planowanie dnia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Headache Pro a bejegyzéseid alapján jelzi az időjárási változásokat, hogy előre tervezhess."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro ilmoittaa kirjauksiisi perustuvista säämuutoksista, jotta voit suunnitella päiviäsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro varsler om værendringer basert på registreringene dine, slik at du kan planlegge dagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro giver besked om vejrændringer ud fra dine registreringer, så du kan planlægge dagen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro уведомляет об изменениях погоды на основе твоих записей, чтобы ты мог планировать день."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro usa os padrões dos teus registos para te avisar sobre dias com condições meteorológicas semelhantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro використовує твої записи, щоб завчасно сповіщати про дні з погодою, схожою на ту, що супроводжувала головний біль."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro s’appuie sur vos notes pour vous informer des journées où la météo présente des tendances similaires."
          }
        }
      }
    },
