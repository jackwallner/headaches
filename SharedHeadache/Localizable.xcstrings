        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Median søvn natten før hodepine: %@. %@ av hodepinene dine kom etter en natt med under 6 timers søvn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Median søvn natten før hovedpine: %@. %@ af dine hovedpiner kom efter en nat med under 6 timers søvn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиана сна в ночь перед головной болью: %@. %@ головных болей возникли после ночи со сном менее 6 часов."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana do sono na noite anterior a uma dor de cabeça: %@. %@ das tuas dores de cabeça foram registadas após uma noite com menos de 6 horas de sono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіана сну в ніч перед головним болем: %@. %@ випадків головного болю припали на ранок після сну менш як 6 годин."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée médiane du sommeil la nuit précédant un mal de tête : %@. %@ des maux de tête ont été notés après une nuit de moins de 6 heures."
          }
        }
      }
    },
