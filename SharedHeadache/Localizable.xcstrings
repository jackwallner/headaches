    "What time of day do you most often get headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What time of day do you most often get headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu welcher Tageszeit bekommen Sie am häufigsten Kopfschmerzen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの場合、頭痛はいつ頃ですか?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hora del día con más frecuencia tienes dolores de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che ora del giorno si ottiene più spesso mal di testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O której masz najczęściej bóle głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor szokott a legtöbb fejfájásod lenni?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin aikaan päivästä saat useimmiten päänsärkyä?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken tid på dagen får du oftest hodepine?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår får du mest hovedpine?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В какое время суток чаще всего возникают головные боли?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A que horas do dia você costuma ter dores de cabeça?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Який час доби ви найчастіше отримуєте головні болі?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A quelle heure de la journée avez-vous souvent des maux de tête?"
          }
        }
      }
    },
    "Do you notice headaches after poor or too little sleep?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you notice headaches after poor or too little sleep?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bemerken Sie Kopfschmerzen nach schlechtem oder zu wenig Schlaf?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠不足や睡眠不足の後に頭痛に気づく?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Notas dolores de cabeza después del sueño pobre o demasiado pequeño?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai notato mal di testa dopo il sonno povero o troppo piccolo?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauważyłeś bóle głowy po biednym lub za mało snu?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Észrevetted, hogy fáj a fejed?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaatko päänsärkyä huonon vai liian pienen unen jälkeen?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger du merke til hodepine etter dårlig eller for lite søvn?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du bemærket hovedpine efter dårlig eller for lidt søvn?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы замечаете головные боли после плохого или слишком малого сна?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dores de cabeça depois de dormir mal ou pouco?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви помітите головні болі після поганого або занадто маленького сну?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous remarquez des maux de tête après un sommeil pauvre ou trop peu ?"
          }
        }
      }
    },
    "Have you noticed a link between weather changes and your headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you noticed a link between weather changes and your headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Sie eine Verbindung zwischen Wetteränderungen und Ihren Kopfschmerzen bemerkt?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天候の変化と頭痛のリンクに気付きましたか?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ha notado un vínculo entre los cambios climáticos y sus dolores de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai notato un legame tra cambiamenti climatici e mal di testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauważyłeś związek między zmianami pogody a bólami głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Észrevetted, hogy kapcsolat van az időjárás változások és a fejfájásod között?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko huomannut yhteyden säämuutosten ja päänsärkysi välillä?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du merket en sammenheng mellom værendringer og hodepine?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du bemærket en forbindelse mellem vejrændringer og din hovedpine?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы заметили связь между изменениями погоды и головными болями?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já reparaste numa ligação entre as mudanças climáticas e as dores de cabeça?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви помітили посилання між змінами погоди та вашими головними болями?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous remarqué un lien entre les changements climatiques et vos maux de tête?"
          }
        }
      }
    },
    "Do certain foods or drinks seem to be linked with your headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do certain foods or drinks seem to be linked with your headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheinen bestimmte Lebensmittel oder Getränke mit Ihren Kopfschmerzen verbunden zu sein?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の食べ物や飲み物は頭痛にリンクされているようですか?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Acaso ciertos alimentos o bebidas parecen estar vinculados con sus dolores de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni alimenti o bevande sembrano essere collegati con il mal di testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy niektóre pokarmy lub napoje są związane z bólem głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, hogy bizonyos ételek vagy italok kapcsolatban állnak a fejfájással?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittyykö tietty ruoka tai juoma päänsärkyyn?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synes visse matvarer eller drikke å være knyttet til hodepinen din?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er visse fødevarer eller drikkevarer synes at være forbundet med din hovedpine?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые продукты или напитки связаны с вашей головной болью?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que certos alimentos ou bebidas estão relacionados com suas dores de cabeça?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи є певні продукти харчування або напої, здавалося б, пов'язані з вашими головними болями?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains aliments ou boissons semblent-ils liés à vos maux de tête?"
          }
        }
      }
    },
