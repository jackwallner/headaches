    "What time of day do you most often get headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What time of day do you most often get headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu welcher Tageszeit hast du am häufigsten Kopfschmerzen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を記録することが最も多い時間帯はいつですか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora del día sueles tener dolor de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quale fascia oraria registri più spesso un mal di testa?"
          }
