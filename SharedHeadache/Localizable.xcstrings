    "Location-based weather, pressure, air quality, UV, and pollen-style signals when available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location-based weather, pressure, air quality, UV, and pollen-style signals when available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortbasierte Wetter-, Druck-, Luftqualitäts-, UV- und Pollensignale, wenn verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置ベースの天候、圧力、空気の質、紫外線および花粉様式の信号は利用できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo, presión, calidad del aire, rayos UV y señales de estilo polen cuando esté disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponibili segnali meteo, pressione, qualità dell'aria, UV e polline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja: pogoda, ciśnienie, jakość powietrza, promieniowanie UV oraz sygnały w stylu pylenia, jeśli są dostępne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi alapú időjárás, nyomás, levegőminőség, UV, és pollenstílusú jelek, ha rendelkezésre állnak."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintiin perustuvat sää-, paine-, ilmanlaatu-, UV- ja siitepölytyyliset signaalit, jos saatavilla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasseringsbasert vær, trykk, luftkvalitet, UV og pollen-stil signaler når tilgjengelig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaliseringsbaseret vejr, tryk, luftkvalitet, UV og pollen- stil signaler, når de er tilgængelige."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погода, давление, качество воздуха, УФ и сигналы в виде пыльцы, когда они доступны."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima baseado na localização, pressão, qualidade do ar, UV e sinais de pólen quando disponível."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцезнаходження погода, тиск, якість повітря, УФ і сигнали запилення при наявності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La température, la pression, la qualité de l'air, les rayons UV et les signaux de type pollen basés sur la localisation sont disponibles."
          }
        }
      }
    },
