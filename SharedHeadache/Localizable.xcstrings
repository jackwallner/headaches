    "Nothing happens until you confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing happens until you confirm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geschieht nichts, bis du bestätigst"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまで変更されません"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambiará nada hasta que confirmes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non succede nulla finché non confermi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie stanie, dopóki nie potwierdzisz"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megerősítésedig nem történik semmi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei tapahdu ennen vahvistusta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting skjer før du bekrefter"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sker ikke noget, før du bekræfter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ты не подтвердишь, ничего не произойдёт"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada acontece até confirmares"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не станеться, доки ти не підтвердиш"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne se passe avant votre confirmation"
          }
        }
      }
    },
