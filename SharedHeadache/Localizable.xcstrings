    "US AQI 100 is \"unhealthy for sensitive groups\". 150+ is unhealthy for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 is \"unhealthy for sensitive groups\". 150+ is unhealthy for everyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 ist \"ungesund für empfindliche Gruppen\". 150+ ist ungesund für alle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100は「敏感なグループのための不健康な」です。 150+は誰にとっても不健康です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 es \"no saludable para grupos sensibles\". 150+ no es saludable para todos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 è \"insano per gruppi sensibili\". 150+ è malsano per tutti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 jest \"niezdrowy dla wrażliwych grup\". 150 + jest niezdrowe dla wszystkich."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A US AQI 100 \"érzékeny csoportok számára egészségtelen\". 150 + mindenkinek egészségtelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 on \"epäterveellistä herkille ryhmille.\" 150+ on epäterveellistä kaikille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 er usunn for sensitive grupper 150+ er usunt for alle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 er \"usund for følsomme grupper\". 150 + er usundt for alle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 «нездоров для чувствительных групп». 150+ – это вредно для всех."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 é \"não saudável para grupos sensíveis\". 150+ não é saudável para todos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 є \"нездоровим для чутливих груп\". 150+ нездоровий для всіх."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "US AQI 100 est \"insalubre pour les groupes sensibles\". 150+ est malsain pour tout le monde."
          }
        }
      }
    },
