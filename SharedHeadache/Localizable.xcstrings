    "Export your headache history to a CSV file you can share with a doctor or open in Numbers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your headache history to a CSV file you can share with a doctor or open in Numbers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie Ihren Kopfschmerzverlauf in eine CSV-Datei, die Sie mit einem Arzt teilen oder in Zahlen öffnen können."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛の履歴を CSV にエクスポートし、医師と共有したり、番号で開くことができます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte su historial de dolor de cabeza a un archivo CSV que puede compartir con un médico o abrir en Números."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta la cronologia del tuo mal di testa in un file CSV che puoi condividere con un medico o aprire in Numbers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj swoją historię bólu głowy do pliku CSV, którym możesz podzielić się z lekarzem lub otworzyć w numerach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportálja az anamnézist egy CSV fájlba, amit megoszthat egy orvossal, vagy megnyit számokban."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie päänsärkyhistoriasi CSV -tiedostoon, jonka voit jakaa lääkärin kanssa tai avata numeroina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter din hodepine historie til en CSV-fil. Du kan dele med en lege eller åpne i Numbers."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportér din hovedpine historie til en CSV fil, du kan dele med en læge eller åbne i Numbers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте свою историю головной боли в файл CSV, которым вы можете поделиться с врачом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar seu histórico de dor de cabeça para um arquivo CSV que você pode compartilhar com um médico ou abrir em Números."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експорт історії головного болю до файлу CSV ви можете поділитися з лікарем або відкрити в кількості."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos antécédents de maux de tête dans un fichier CSV que vous pouvez partager avec un médecin ou ouvrir dans Nombres."
          }
        }
      }
    },
    "Export selected entries from %@, or export all years below. The CSV opens in Numbers and can be shared with your doctor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export selected entries from %@, or export all years below. The CSV opens in Numbers and can be shared with your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie ausgewählte Einträge aus %@ oder exportieren Sie alle folgenden Jahre. Der CSV öffnet sich in Zahlen und kann mit Ihrem Arzt geteilt werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から選択したエントリをエクスポートするか、以下のすべての年をエクスポートします。 CSVは番号で開き、医師と共有することができます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar entradas seleccionadas de %@, o exportar todos los años abajo. El CSV se abre en Números y se puede compartir con su médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta le voci selezionate da %@ o esporta tutti gli anni seguenti. La CSV si apre in Numeri e può essere condivisa con il medico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj wybrane wpisy z %@ lub eksportuj wszystkie lata poniżej. CSV otwiera się w liczbach i może być udostępniany lekarzowi prowadzącemu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiválasztott bejegyzések exportálása a %@-ből, vagy exportálása az összes alábbi évben. A CSV megnyílik számokban, és megosztható orvosával."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie valitut merkinnät %@:stä tai vie kaikki vuodet alla. CSV avautuu numeroissa ja se voidaan jakaa lääkärisi kanssa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter valgte oppføringer fra %@, eller eksporter alle årene nedenfor. CSV åpnes i tall og kan deles med legen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportér valgte indgange fra %@, eller eksport alle år nedenfor. CSV åbner i numre og kan deles med din læge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт отдельных позиций из %@ или экспорт на все годы ниже. CSV открывается в цифрах и может быть передан вашему врачу."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar entradas selecionadas do %@, ou exportar todos os anos abaixo. O CSV abre em Números e pode ser partilhado com o seu médico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортувати вибрані записи з %@ або експортувати всі роки нижче. CSV відкриває в числах і може бути передано до лікаря."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter des entrées sélectionnées de %@, ou exporter toutes les années ci-dessous. Le CSV s'ouvre dans Numbers et peut être partagé avec votre médecin."
          }
        }
      }
    },
    "Save all selected entries to a CSV file you can share with a doctor, open in Numbers, or back up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save all selected entries to a CSV file you can share with a doctor, open in Numbers, or back up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie alle ausgewählten Einträge in einer CSV-Datei, die Sie mit einem Arzt teilen, in Zahlen öffnen oder sichern können."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したすべてのエントリをCSVファイルに保存して、医師と共有したり、番号で開くか、バックアップできます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde todas las entradas seleccionadas en un archivo CSV que pueda compartir con un médico, abrir en Números o respaldar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva tutte le voci selezionate in un file CSV puoi condividere con un medico, aprire in Numbers o eseguire il backup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz wszystkie wybrane wpisy do pliku CSV, które możesz udostępnić lekarzowi, otwartego w numerach lub kopii zapasowej."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse az összes kiválasztott bejegyzéseket a CSV fájlba, amit megoszthat egy orvossal, megnyílik számokban, vagy vissza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna kaikki valitut merkinnät CSV-tiedostoon, jonka voit jakaa lääkärin kanssa, avata numeroina tai varmuuskopiona."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre alle valgte oppføringer til en CSV-fil, eller sikkerhetskopier."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem alle markerede indgange til en CSV fil du kan dele med en læge, åbne i numre, eller sikkerhedskopiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните все выбранные записи в файл CSV, которым вы можете поделиться с врачом, открыть в Числах или создать резервную копию."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve todas as entradas selecionadas em um arquivo CSV que você pode compartilhar com um médico, abrir em Números ou fazer backup."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заощаджуйте всі вибрані записи до файлу CSV, ви можете поділитися з лікарем, відкрити в Кількістьх, або назад вгору."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez toutes les entrées sélectionnées dans un fichier CSV que vous pouvez partager avec un médecin, ouvrir dans Numbers ou sauvegarder."
          }
        }
      }
    },
