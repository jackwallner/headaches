    "Keep logging. Forecast alerts stay quiet until your daily history shows a clear weather-pattern link across at least %lld days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep logging. Forecast alerts stay quiet until your daily history shows a clear weather-pattern link across at least %lld days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse weiter Einträge. Wetterhinweise bleiben aus, bis sich in deinen Daten über mindestens %lld Tage ein wiederkehrendes Wettermuster zeigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を続けてください。少なくとも%lld日分の履歴に天気のパターンが見られるまでは、予報通知は届きません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue registrando tus dolores de cabeza. No recibirás avisos hasta que haya al menos %lld días de historial que muestren un patrón meteorológico claro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registrare i mal di testa. Non riceverai avvisi finché almeno %lld giorni di dati non mostreranno un andamento meteo chiaro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj zapisywanie bólów głowy. Powiadomienia o prognozie nie będą wysyłane, dopóki co najmniej %lld dni danych nie pokaże wyraźnego wzorca pogodowego."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsd továbbra is a fejfájásokat. Nem kapsz előrejelzési értesítést, amíg legalább %lld nap adatai nem mutatnak visszatérő időjárási mintázatot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka kirjaamista. Ennusteilmoitukset pysyvät poissa, kunnes vähintään %lld päivän tiedot osoittavat selvän sääkuvion."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett å registrere hodepine. Værvarsler sendes ikke før minst %lld dager med data viser et tydelig værmønster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv ved med at registrere hovedpine. Varsler fra vejrudsigten sendes først, når mindst %lld dages data viser et tydeligt vejrmønster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжай записывать головные боли. Уведомления по прогнозу не будут приходить, пока данные минимум за %lld дней не покажут явную погодную закономерность."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registar as dores de cabeça. Só receberás alertas quando os teus dados diários mostrarem um padrão meteorológico recorrente ao longo de pelo menos %lld dias."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуй записувати головний біль. Сповіщення за прогнозом не надходитимуть, доки дані щонайменше за %lld днів не покажуть чіткої погодної закономірності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à noter vos maux de tête. Les alertes météo restent silencieuses tant que les données d’au moins %lld jours ne montrent pas de tendance météo claire et récurrente."
          }
        }
      }
    },
    "Keep logging. Forecast alerts stay quiet until your history includes enough days to show a recurring weather pattern.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep logging. Forecast alerts stay quiet until your history includes enough days to show a recurring weather pattern."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse weiter Einträge. Wetterhinweise bleiben aus, bis genug Tage für ein wiederkehrendes Wettermuster vorliegen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を続けてください。履歴から繰り返し現れる天気のパターンが見えるまでは、予報通知は届きません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue registrando tus dolores de cabeza. No recibirás avisos hasta que el historial muestre un patrón meteorológico recurrente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registrare i mal di testa. Non riceverai avvisi finché lo storico non mostrerà un andamento meteo ricorrente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj zapisywanie bólów głowy. Powiadomienia o prognozie nie będą wysyłane, dopóki historia nie pokaże powtarzającego się wzorca pogodowego."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsd továbbra is a fejfájásokat. Nem kapsz előrejelzési értesítést, amíg nincs elég adat egy visszatérő időjárási mintázat felismeréséhez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka kirjaamista. Ennusteilmoitukset pysyvät poissa, kunnes tiedoissa on tarpeeksi päiviä toistuvan sääkuvion havaitsemiseen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett å registrere hodepine. Værvarsler sendes ikke før historikken viser et gjentakende værmønster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv ved med at registrere hovedpine. Varsler fra vejrudsigten sendes først, når historikken viser et tilbagevendende vejrmønster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжай записывать головные боли. Уведомления по прогнозу не будут приходить, пока в истории не будет достаточно данных для повторяющейся погодной закономерности."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registar as dores de cabeça. Os alertas só são enviados quando houver dias suficientes para identificar um padrão meteorológico recorrente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуй записувати головний біль. Сповіщення надходитимуть лише тоді, коли в історії буде достатньо днів для виявлення повторюваної погодної закономірності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à noter vos maux de tête. Les alertes météo restent silencieuses tant que l’historique ne contient pas assez de jours pour faire ressortir une tendance récurrente."
          }
        }
      }
    },
