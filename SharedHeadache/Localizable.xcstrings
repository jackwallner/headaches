            "value": "Foreslåede opsætning"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагаемая установка"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuração sugerida"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроювання"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration suggérée"
          }
        }
      }
    },
    "You'll be notified when forecast conditions match patterns in your logs. Tap to tune thresholds and quiet hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be notified when forecast conditions match patterns in your logs. Tap to tune thresholds and quiet hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden benachrichtigt, wenn die prognostizierten Bedingungen mit Mustern in Ihren Protokollen übereinstimmen. Tippen Sie auf Schwellenwerte und ruhige Stunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報条件がログのパターンにマッチしたときに通知されます。 タップして、しきい値と静かな時間を調整します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le notificará cuando las condiciones del pronóstico coincidan con los patrones en sus registros. Pulsa para sintonizar umbrales y horas tranquilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà notificato quando le condizioni di previsione corrispondono modelli nei tuoi registri. Toccare per sintonizzare le soglie e le ore tranquille."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaniesz powiadomiony, kiedy warunki prognozy będą pasować do wzorców w dziennikach. Dotknij, aby dostroić progi i ciche godziny."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítjük, ha az előrejelzési körülmények egyeznek a naplóban szereplő mintákkal. Koppintsunk a küszöbértékek és a csendes órák hangolására."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulle ilmoitetaan, kun ennusteet vastaavat lokitietojasi. Napauta kynnykset ja hiljaiset tunnit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil bli varslet når prognosebetingelser matcher mønster i loggen. Trykk til tune terskel og stille timer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil blive underrettet, når prognoserne betingelser matcher mønstre i dine logfiler. Tryk på for at tune tærskler og stille timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы будете уведомлены, когда прогнозируемые условия соответствуют шаблонам в ваших журналах. Нажмите, чтобы настроить пороги и тихие часы."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será notificado quando as condições de previsão coincidirem com padrões em seus registros. Toque para sintonizar limiares e horas tranquilas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви будете повідомлені при прогнозі умов, що відповідають шаблонам вашого журналу. Натисніть, щоб налаштувати пороги і тихі години."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez averti lorsque les conditions prévues correspondent aux modèles dans vos journaux. Appuyez sur pour régler les seuils et les heures tranquilles."
          }
        }
      }
    },
    "Turn on background forecast checks that stay quiet until pressure or AQI patterns appear in your logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on background forecast checks that stay quiet until pressure or AQI patterns appear in your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Hintergrundprognoseprüfungen, die ruhig bleiben, bis Druck oder AQI-Muster in Ihren Protokollen erscheinen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景予測をオンにすると、圧力やAQIパターンがログに表示されるまで静かに滞在するチェックがオンになります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encienda los controles de pronóstico de fondo que se mantengan en silencio hasta que aparezcan los patrones AQI en sus registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendere i controlli di previsione di sfondo che rimangono silenziosi fino alla pressione o modelli AQI appaiono nei vostri registri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączanie kontroli prognozy tła, które pozostają cicho aż do ciśnienia lub AQI wzory pojawiają się w dziennikach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a háttér előrejelzés ellenőrzések, hogy csendben marad, amíg nyomás vagy AQI minták jelennek meg a naplók."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä taustaennusteen tarkistukset, jotka pysyvät hiljaa kunnes paine tai AQI kuviot näkyvät lokit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på bakgrunnsprognose som holder seg stille til trykk eller AQI-mønstre vises i loggene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd baggrund prognose kontroller, der forbliver stille, indtil trykket eller AQI mønstre vises i dine logfiler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите проверки фонового прогноза, которые остаются спокойными, пока в ваших журналах не появятся шаблоны AQI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as verificações de previsão de fundo que permanecem quietas até que os padrões AQI apareçam em seus registros."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть фонові перевірки прогнозів, які залишаються тихими до тиску або AQI, з'являються в журналах."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les prévisions de fond vérifie que vous restez silencieux jusqu'à ce que la pression ou les modèles AQI apparaissent dans vos journaux."
          }
        }
      }
    },
