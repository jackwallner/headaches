    "Health and location are read-only and only used to enrich logs with context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health and location are read-only and only used to enrich logs with context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheit und Standort sind schreibgeschützt und werden nur zur Anreicherung von Protokollen mit Kontext verwendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康と場所は読み取り専用であり、コンテキストでログを埋めるためにのみ使用されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salud y la ubicación son sólo lectura y sólo se utilizan para enriquecer los registros con contexto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La salute e la posizione sono di sola lettura e utilizzati solo per arricchire i registri con il contesto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdrowie i lokalizacja są tylko read- i tylko wykorzystywane do wzbogacania dzienników z kontekstem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egészség és a hely csak olvasható, és csak arra használják, hogy gazdagítsa naplókat kontextussal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terveys ja sijainti ovat vain luku-ja käytetään vain rikastuttaa lokit yhteydessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Helse og plassering er skrivebeskyttet og brukes bare til å berike logger med kontekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundhed og placering er read- kun og kun bruges til at berige logs med kontekst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровье и местоположение используются только для чтения и обогащения журналов контекстом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A saúde e a localização são somente leituras e usadas apenas para enriquecer logs com contexto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоров'я та розташування використовуються для збагачення журналів з контекстом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La santé et l'emplacement sont en lecture seule et seulement utilisés pour enrichir les journaux avec le contexte."
          }
        }
      }
    },
