    "Pro summarizes patterns in your logged sleep, pressure, timing, and weather data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro summarizes patterns in your logged sleep, pressure, timing, and weather data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro fasst Muster in Ihren protokollierten Schlaf-, Druck-, Timing- und Wetterdaten zusammen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された睡眠、圧力、タイミング、気象データのパターンを要約します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro resume los patrones en su sueño conectado, presión, tiempo y datos meteorológicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro riassume i modelli nel sonno, pressione, tempi e dati meteo registrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro podsumowuje wzorce w zalogowanych danych dotyczących snu, ciśnienia, czasu i pogody."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro foglalja össze minták a naplózott alvás, nyomás, időzítés, és az időjárás adatok."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tiivistää malleja kirjautuneen unen, paineen, ajoituksen ja säätiedot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro oppsummerer mønstre i din logget søvn, trykk, timing og værdata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro opsummerer mønstre i din loggede søvn, tryk, timing og vejr data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro суммирует закономерности в вашем зарегистрированном сне, давлении, времени и погодных данных."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro resume padrões em seu sono registrado, pressão, tempo e dados meteorológicos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro підбиває візерунки в логічному соні, тиску, часу і погодних даних."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro résume les tendances dans vos données enregistrées sur le sommeil, la pression, le timing et la météo."
          }
        }
      }
    },
