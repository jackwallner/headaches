    "Pressure is forecast to fall by %@ hPa in the next %lld hours. Your logs show headaches on %lld of %lld similar days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure is forecast to fall by %@ hPa in the next %lld hours. Your logs show headaches on %lld of %lld similar days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Luftdruck soll um %@ hPa in den nächsten %lld Stunden fallen. Deine Einträge zeigen Kopfschmerzen an %lld von %lld vergleichbaren Tagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後%@ hPaの気圧低下が予報されています（%lld時間）。記録では、似た条件の日のうち%lld/%lld日に頭痛がありました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prevé que la presión atmosférica baje %@ hPa en las próximas %lld horas. Tus registros muestran dolor de cabeza en %lld de %lld días similares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È previsto un calo di %@ hPa nelle prossime %lld ore. Nei tuoi registri hai annotato mal di testa in %lld giorni su %lld simili."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognozowany spadek ciśnienia wynosi %@ hPa w ciągu %lld godzin. W twoich wpisach ból głowy wystąpił w %lld z %lld podobnych dni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előrejelzés szerint a légnyomás %@ hPa-lal csökken a következő %lld órában. A bejegyzéseidben %lld-ből %lld hasonló napon szerepel fejfájás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmanpaineen ennustetaan laskevan %@ hPa seuraavan %lld tunnin aikana. Kirjauksissasi päänsärky esiintyi %lld:na %lld samankaltaisesta päivästä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lufttrykket er ventet å falle %@ hPa i løpet av de neste %lld timene. Registreringene dine viser hodepine på %lld av %lld lignende dager."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lufttrykket forventes at falde %@ hPa i løbet af de næste %lld timer. Dine registreringer viser hovedpine på %lld af %lld lignende dage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По прогнозу, давление снизится на %@ гПа в ближайшие %lld ч. В твоих записях головная боль была в %lld из %lld похожих дней."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevê-se uma descida de %@ hPa na pressão atmosférica nas próximas %lld horas. Nos teus registos, houve dores de cabeça em %lld de %lld dias semelhantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За прогнозом, тиск знизиться на %@ hPa протягом наступних %lld годин. У твоїх записах головний біль був у %lld із %lld подібних днів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression devrait baisser de %@ hPa dans les %lld prochaines heures. Vos notes indiquent des maux de tête %lld jours sur %lld jours comparables."
          }
        }
      }
    },
    "Pressure is forecast to fall by %@ hPa in the next 24 hours.": {
