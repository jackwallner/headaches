    "# Empty quoted cells mean a value was unavailable or was not recorded for that event.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Empty quoted cells mean a value was unavailable or was not recorded for that event."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere zitierte Zellen bedeuten, dass ein Wert nicht verfügbar war oder für dieses Ereignis nicht aufgezeichnet wurde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 空の引用されたセルは、値が利用できなくなったり、そのイベントのために記録されていないことを意味します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Las células citadas vacías significan que un valor no estaba disponible o no fue registrado para ese evento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Le celle vuote significano che un valore non era disponibile o non è stato registrato per quell'evento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Puste cytowane komórki oznaczają, że wartość była niedostępna lub nie została zarejestrowana dla tego zdarzenia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Üres jegyzett cellák azt jelentik, hogy egy érték nem volt elérhető, vagy nem rögzítették az esemény."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tyhjät noteeratut solut tarkoittavat, että arvoa ei ollut saatavilla tai sitä ei ollut kirjattu kyseiseen tapahtumaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# tomme siterte celler betyr at en verdi var utilgjengelig eller ikke ble registrert for den hendelsen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tomme citerede celler betyder en værdi var utilgængelig eller ikke blev registreret for denne begivenhed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые цитируемые ячейки означают, что значение было недоступно или не было записано для этого события."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Células citadas vazias significam que um valor não estava disponível ou não foi gravado para esse evento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи не було записано на цю акцію."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les cellules vides citées signifient qu'une valeur n'était pas disponible ou n'a pas été enregistrée pour cet événement."
          }
        }
      }
    },
    "# This export is for personal tracking and sharing. It does not establish medical facts by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# This export is for personal tracking and sharing. It does not establish medical facts by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Dieser Export dient dem persönlichen Tracking und Teilen. Es stellt keine medizinischen Fakten von selbst fest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# このエクスポートは、個人的な追跡と共有のためのものです。 自身で医療事実を確立しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# This export is for personal tracking and sharing. No establece hechos médicos por sí mismo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Questa esportazione Ã ̈ per il monitoraggio personale e la condivisione. Non stabilisce fatti medici da solo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ten eksport jest do osobistego śledzenia i udostępniania. Nie określa ona samych faktów medycznych."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ez az export személyes nyomon követésre és megosztásra van. Ez önmagában nem állapít meg orvosi tényeket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vienti on henkilökohtaista seurantaa ja jakamista varten. Se ei yksin vahvista lääketieteellisiä tietoja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne eksporten er for personlig sporing og deling. Den etablerer ikke medisinske fakta i seg selv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"This export is for personal tracking and share. Den fastslår ikke medicinske fakta alene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экспорт предназначен для личного отслеживания и обмена. Он не устанавливает медицинские факты сам по себе."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Esta exportação é para rastreamento pessoal e compartilhamento. Não estabelece os fatos médicos por si só."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Цей експорт є для особистого відстеження та спільного доступу. Не встановлюйте медичні факти самостійно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Cette exportation est pour le suivi personnel et le partage. Il n'établit pas les faits médicaux par lui-même."
          }
        }
      }
