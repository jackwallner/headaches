        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты получишь уведомление, когда прогноз совпадёт с личным сигналом из записей. Нажми, чтобы настроить пороги и часы тишины."
          }
        },
        "pt-PT": {
          "stringUnit": {
