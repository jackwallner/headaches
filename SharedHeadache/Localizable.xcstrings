            "state": "translated",
            "value": "Sitter hodepinen vanligvis på én side av hodet?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidder hovedpinen typisk i den ene side af hovedet?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головная боль обычно возникает с одной стороны?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
