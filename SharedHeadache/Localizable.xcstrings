    "%@ Keep using the one-tap button and Pro will surface a pattern when a signal stands out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Keep using the one-tap button and Pro will surface a pattern when a signal stands out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nutze die Ein-Tipp-Taste weiter. Pro zeigt dir ein Muster, wenn ein Signal in deinen Einträgen auffällt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ワンタップでの記録を続けると、目立つ信号があったときにProがパターンを表示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sigue usando el botón de un toque y Pro mostrará un patrón cuando destaque alguna señal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Continua a usare il pulsante per registrare con un tocco. Pro mostrerà un andamento quando emerge un segnale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nadal zapisuj ból głowy jednym dotknięciem. Pro pokaże wzorzec, gdy wyróżni się jakiś sygnał."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Rögzítsd továbbra is egy érintéssel a fejfájásokat. A Pro kiemeli a mintázatokat, ha egy jel feltűnővé válik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kirjaa päänsärky yhdellä napautuksella jatkossakin. Pro nostaa esiin kuvion, kun jokin signaali erottuu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Fortsett å registrere hodepine med ett trykk. Pro viser et mønster når et signal skiller seg ut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bliv ved med at registrere hovedpine med ét tryk. Pro fremhæver et mønster, når et signal skiller sig ud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Продолжай записывать головные боли одним касанием. Pro покажет закономерность, когда какой-либо сигнал будет выделяться."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Continua a usar o botão de um toque. O Pro destaca um padrão quando um sinal sobressai nos teus registos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Продовжуй записувати головний біль одним дотиком. Pro покаже закономірність, коли певний сигнал вирізнятиметься."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Continuez à noter vos maux de tête d’une seule touche. Pro fera ressortir une tendance quand un signal se distinguera."
          }
        }
      }
    },
