    "We'll tell you how many entries are in the file before saving anything.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll tell you how many entries are in the file before saving anything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sagen Ihnen, wie viele Einträge in der Datei sind, bevor Sie etwas speichern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かを保存する前に、ファイル内のエントリがいくつあるかをお伝えします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te diremos cuántas entradas hay en el archivo antes de guardar cualquier cosa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti diremo quante voci sono nel file prima di salvare qualcosa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiemy ci, ile wpisów jest w pliku, zanim cokolwiek zapisze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmondjuk, hány bejegyzés van az aktában, mielőtt bármit is megmentenénk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerromme, kuinka monta merkintää tiedostossa on ennen kuin tallennat mitään."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi forteller deg hvor mange oppføringer som er i filen før du lagrer noe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil fortælle dig, hvor mange indgange er i filen, før du gemmer noget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы расскажем вам, сколько записей в файле, прежде чем что-либо сохранить."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nós diremos quantas entradas estão no arquivo antes de salvar qualquer coisa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми розповімо вам, скільки записів у файлі перед збереженням нічого."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons vous dire combien d'entrées sont dans le fichier avant de sauvegarder quoi que ce soit."
          }
        }
      }
    },
