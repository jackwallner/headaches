            "value": "Aún no has dado permiso para las notificaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora concesso il permesso per le notifiche."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przyznano jeszcze pozwolenia na powiadomienia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem engedélyezted az értesítéseket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksille ei ole vielä annettu lupaa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke gitt tillatelse til varsler ennå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke givet tilladelse til meddelelser endnu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на уведомления ещё не предоставлено."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não autorizaste as notificações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на сповіщення ще не надано."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’envoyer des notifications n’a pas encore été accordée."
          }
        }
      }
    },
