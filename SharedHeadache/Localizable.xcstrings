    "Log a headache once to capture your location, then come back here for forecast-based risk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a headache once to capture your location, then come back here for forecast-based risk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage einmal einen Kopfschmerz-Eintrag ein, damit dein Standort erfasst wird. Hier siehst du anschließend die Wettervorhersage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を一度記録して位置情報を取得すると、ここで予報を確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un dolor de cabeza para obtener tu ubicación y vuelve aquí para consultar la previsión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un mal di testa per rilevare la posizione, poi torna qui per consultare le previsioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ból głowy, aby ustalić lokalizację, a potem wróć tutaj, by sprawdzić prognozę."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts egy fejfájást a helyadatok felvételéhez, majd térj vissza ide az előrejelzési jelekért."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa päänsärky kerran sijaintitietojen tallentamista varten. Palaa sitten tänne katsomaan ennusteen signaaleja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer en hodepine for å hente posisjonen din, og kom tilbake hit for å se værmeldingssignalene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer en hovedpine for at hente din position, og kom så tilbage hertil for at se signaler fra vejrudsigten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши головную боль, чтобы сохранить местоположение, а затем вернись сюда, чтобы посмотреть сигналы прогноза."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista uma dor de cabeça para guardar a localização e volta aqui para consultar os sinais da previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши головний біль, щоб зберегти місце розташування, а потім повернися сюди, щоб переглянути сигнали прогнозу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez un mal de tête pour enregistrer votre position, puis revenez ici pour consulter les signaux météo."
          }
        }
      }
    },
    "Log a headache once to capture your location, then come back here to see forecast signals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a headache once to capture your location, then come back here to see forecast signals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage einmal einen Eintrag ein, damit dein Standort erfasst wird. Kehre dann hierher zurück, um Prognosesignale zu sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を一度記録して位置情報を取得すると、ここで予報信号を確認できます。"
          }
        },
        "es": {
