            "value": "Registra un mal di testa per rilevare la posizione, poi torna qui per vedere i segnali delle previsioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ból głowy, aby ustalić lokalizację, a potem wróć tutaj, by zobaczyć sygnały z prognozy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts egy fejfájást a helyadatok felvételéhez, majd térj vissza ide az előrejelzési jelekért."
          }
        },
        "fi": {
          "stringUnit": {
