          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримати сповіщення, коли прогнозні сигнали відповідають вашим логічним шаблонам."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez une notification lorsque les signaux de prévision correspondent à vos modèles enregistrés."
          }
        }
      }
    },
    "Computed on your device from your logs. Descriptive only. Not medical advice or a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed on your device from your logs. Descriptive only. Not medical advice or a diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet auf Ihrem Gerät aus Ihren Protokollen. Nur beschreibend. Kein ärztlicher Rat oder eine Diagnose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログからデバイスにコンピュータをオンにします。 記述のみ。 医療のアドバイスや診断はありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Computado en tu dispositivo desde tus registros. Sólo descriptivo. No asesoramiento médico ni diagnóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Computato sul dispositivo dai registri. Solo descrittivo. Non un consiglio medico o una diagnosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skomputeryzowano twoje urządzenie z dzienników. Tylko opis. Ani porady medycznej, ani diagnozy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naplóbejegyzéseidből. Csak leíró jellegű. Nem orvosi tanács vagy diagnózis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskettu laitteeseenne lokeistanne. Vain kuvainnollisia. Ei lääkärin neuvoja eikä diagnoosia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslått på enheten din fra loggene. Deskriptiv bare. Ikke medisinsk rådgivning eller diagnose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Computeret på din enhed fra dine logfiler. Kun deskriptiv. Ikke medicinsk rådgivning eller diagnose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вычислен на вашем устройстве из ваших журналов. Только описательные. Никаких медицинских советов или диагнозов."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Computado em seu dispositivo a partir de seus registros. Apenas descritivo. Não aconselhamento médico ou diagnóstico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть пристрій з вашого журналу. Розшифровка тільки. Не медичні консультації або діагностика."
          }
        },
        "fr": {
          "stringUnit": {
