    "This setting is the forecast pressure change that activates an alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting is the forecast pressure change that activates an alert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wert legt fest, ab welcher vorhergesagten Luftdruckänderung ein Hinweis gesendet wird."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は、通知の対象となる気圧の予報変化を指定します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste define el cambio de presión previsto que activa un aviso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa impostazione definisce la variazione di pressione prevista che attiva un avviso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie określa prognozowaną zmianę ciśnienia, która uruchamia powiadomienie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a beállítás adja meg azt az előrejelzett légnyomás-változást, amely értesítést indít."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä asetus määrittää ennustetun ilmanpaineen muutoksen, joka käynnistää ilmoituksen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne innstillingen angir hvor stor varslet endring i lufttrykk må være for å utløse et varsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne indstilling angiver den forventede ændring i lufttryk, som udløser et varsel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта настройка задаёт прогнозируемое изменение давления, при котором отправляется уведомление."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta definição indica a variação da pressão prevista que ativa um alerta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей параметр визначає зміну тиску за прогнозом, за якої надходить сповіщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage définit la variation de pression prévue qui active une alerte."
          }
        }
      }
    },
