    "Skip entries that already exist, or overwrite them with values from the file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip entries that already exist, or overwrite them with values from the file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringe bereits vorhandene Einträge oder ersetze sie durch die Werte aus der Datei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにある記録をスキップするか、ファイルのデータで置き換えます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite los registros que ya existen o reemplázalos con los datos del archivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora le registrazioni già esistenti oppure sovrascrivile con i valori del file."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiń istniejące wpisy lub zastąp je wartościami z pliku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kihagyhatod a már meglévő bejegyzéseket, vagy felülírhatod őket a fájl értékeivel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohita jo olemassa olevat kirjaukset tai korvaa ne tiedoston arvoilla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hopp over registreringer som allerede finnes, eller erstatt dem med verdiene fra filen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring registreringer, der allerede findes, over, eller erstat dem med værdierne fra filen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропусти уже существующие записи или замени их данными из файла."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora os registos que já existem ou substitui-os pelos valores do ficheiro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропусти наявні записи або заміни їх даними з файлу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorez les notes déjà présentes ou remplacez-les par les données du fichier."
          }
        }
