    "Have you noticed a link between weather changes and your headaches?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you noticed a link between weather changes and your headaches?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dir ein Zusammenhang zwischen Wetteränderungen und deinen Kopfschmerzen aufgefallen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気の変化と頭痛に関連があると感じますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has notado alguna relación entre los cambios del tiempo y tus dolores de cabeza?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai notato un’associazione tra i cambiamenti del meteo e i tuoi mal di testa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy zauważasz związek między zmianami pogody a bólami głowy?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Észrevettél összefüggést az időjárás változása és a fejfájásaid között?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko huomannut yhteyttä säämuutosten ja päänsärkyjesi välillä?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du lagt merke til en sammenheng mellom værendringer og hodepinene dine?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du bemærket en sammenhæng mellem vejrændringer og dine hovedpiner?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечал ли ты связь между изменениями погоды и головными болями?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparaste numa relação entre as mudanças meteorológicas e as tuas dores de cabeça?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи помічав ти зв’язок між змінами погоди та головним болем?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous remarqué une association entre les changements météo et vos maux de tête ?"
          }
        }
      }
    },
