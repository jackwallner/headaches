          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані записи буде назавжди видалено з історії. Якщо потрібна резервна копія, спочатку експортуй CSV-файл."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces notes seront définitivement supprimées de votre historique. Exportez d’abord un CSV si vous avez besoin d’une sauvegarde."
          }
