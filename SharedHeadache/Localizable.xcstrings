    "Retry captured context but save failed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry captured context but save failed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erneute Versuch hat den Kontext erfasst, aber nicht gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連データは取得できましたが、保存できませんでした。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se obtuvo el contexto al reintentar, pero no se pudo guardar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati contestuali sono stati acquisiti, ma non salvati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udało się zebrać dane kontekstowe, ale nie zapisać wpisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok rögzítése sikerült, de a mentés nem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustatiedot saatiin, mutta tallennus epäonnistui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplysningene ble hentet, men kunne ikke lagres."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplysningerne blev hentet, men kunne ikke gemmes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные получены, но сохранить запись не удалось."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contexto foi recolhido novamente, mas não foi possível guardar o registo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст зібрано повторно, але не вдалося зберегти запис."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau relevé du contexte a échoué à l’enregistrement."
          }
        }
      }
    },
    "Retry failed. Event missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry failed. Event missing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erneute Versuch ist fehlgeschlagen. Eintrag nicht gefunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行できませんでした。記録が見つかりません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reintentar. No se encontró el registro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovo tentativo non riuscito. Registrazione non trovata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowienie nie powiodło się. Nie znaleziono wpisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újrapróbálás nem sikerült. A bejegyzés nem található."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenyritys epäonnistui. Kirjausta ei löytynyt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt forsøk mislyktes. Registreringen mangler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt forsøg mislykkedes. Registreringen mangler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная попытка не удалась. Запись не найдена."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova tentativa falhou. O registo já não existe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося повторити спробу. Запис не знайдено."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle tentative a échoué. Note introuvable."
          }
        }
      }
    },
    "Retry still failed. Email the developer from the event card.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry still failed. Email the developer from the event card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erneute Versuch ist wieder fehlgeschlagen. Kontaktiere den Entwickler über die Eintragskarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行しても解決しませんでした。記録のカードから開発者にメールしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reintento tampoco funcionó. Escribe al desarrollador desde la tarjeta del registro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche il nuovo tentativo non è riuscito. Scrivi allo sviluppatore dalla scheda della registrazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowienie nadal się nie powiodło. Napisz do dewelopera z karty wpisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újrapróbálás továbbra sem sikerült. A bejegyzés kártyájáról e-mailt írhatsz a fejlesztőnek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenyritys epäonnistui taas. Voit lähettää kehittäjälle sähköpostia tapahtumakortista."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt forsøk mislyktes igjen. Send en e-post til utvikleren fra registreringskortet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt forsøg mislykkedes igen. Send en e-mail til udvikleren fra registreringskortet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная попытка снова не удалась. Напиши разработчику с карточки записи."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova tentativa falhou. Envia um email ao programador através do cartão do registo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторна спроба не вдалася. Напиши розробнику з картки запису."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
