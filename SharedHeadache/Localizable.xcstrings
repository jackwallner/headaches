    "Headache Pro summarizes patterns in your logs and gives you a heads-up about forecast changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro summarizes patterns in your logs and gives you a heads-up about forecast changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro fasst Muster in Ihren Protokollen zusammen und gibt Ihnen einen Überblick über Prognoseänderungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Proはログのパターンを要約し、予測変更に関するヘッドアップを提供します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro resume patrones en sus registros y le da un aviso sobre cambios de pronóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro riassume i modelli nei tuoi registri e ti dà un heads-up sulle modifiche delle previsioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro podsumowuje wzorce w dziennikach i daje głowę o zmianach prognozowanych."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro összefoglalja a mintákat a naplókban, és ad egy heads- up kapcsolatos előrejelzés változások."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro tiivistää kuvioita lokit ja antaa sinulle varoituksia ennusteiden muutoksia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro oppsummerer mønstre i loggene dine og gir deg et heads-up om endringer i prognoser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro opsummerer mønstre i dine logfiler og giver dig en heads- up om prognoseændringer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro обобщает шаблоны в ваших журналах и дает вам представление об изменениях прогноза."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro resume padrões em seus logs e lhe dá um aviso sobre as mudanças de previsão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro підбиває візерунки в журналах і дає вам голови про зміни прогнозу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Pro résume les tendances dans vos journaux et vous donne un aperçu des changements prévus."
          }
        }
      }
    },
    "Spot your personal patterns across sleep, timing, and weather": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot your personal patterns across sleep, timing, and weather"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie Ihre persönlichen Muster über Schlaf, Timing und Wetter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠、タイミング、天候を横断してあなたの個人的なパターンを見つけて下さい"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tus patrones personales a través del sueño, el tiempo y el tiempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot i tuoi modelli personali attraverso il sonno, il tempo e il tempo"
          }
        },
