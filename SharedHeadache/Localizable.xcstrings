    "Your answers help Patterns highlight areas in your logs. You can always come back later from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers help Patterns highlight areas in your logs. You can always come back later from Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Antworten helfen Patterns, Bereiche in Ihren Protokollen hervorzuheben. Sie können immer später von Settings zurückkommen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は、パターンがログの領域を強調するのに役立ちます。 [設定] から後で戻ってきます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus respuestas ayudan a los patrones a destacar áreas en sus registros. Siempre puedes volver más tarde desde Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte aiutano Patterns a evidenziare le aree nei tuoi registri. Puoi sempre tornare più tardi da Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi pomagają wzorzec wyróżniać obszary w dziennikach. Zawsze możesz wrócić później z Ustawienia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszai segítenek a minták kiemelni területek a naplók. A Beállítások után bármikor visszajöhetsz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi auttavat Kuvioita korostamaan alueita lokeissa. Voit aina palata myöhemmin Asetukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar hjelper Mønster markere områder i loggen. Du kan alltid komme tilbake senere fra Innstillinger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar hjælper Mønstre fremhæve områder i dine logfiler. Du kan altid komme tilbage senere fra Indstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши ответы помогают шаблонам выделять области в ваших журналах. Вы всегда можете вернуться позже из Настройки."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas ajudam Padrões destacar áreas em seus logs. Você sempre pode voltar mais tarde de Configurações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша відповідь допоможе Візерунки виділити ділянки в журналах. Ви завжди можете повернутися пізніше з налаштувань."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses aident Les motifs mettent en évidence les zones de vos journaux. Vous pouvez toujours revenir plus tard à partir de Paramètres."
          }
        }
      }
    },
