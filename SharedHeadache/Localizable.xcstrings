    "This permanently removes the selected entries from your history. Export a CSV first if you need a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the selected entries from your history. Export a CSV first if you need a backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die ausgewählten Einträge dauerhaft aus Ihrer Historie entfernt. Exportieren Sie zuerst ein CSV, wenn Sie ein Backup benötigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永続的に選択したエントリを履歴から削除します。 バックアップが必要な場合は、CSVを最初にエクスポートします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente las entradas seleccionadas de su historia. Exportar un CSV primero si necesita una copia de seguridad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente le voci selezionate dalla tua storia. Esportare un CSV prima se hai bisogno di un backup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To na stałe usuwa zaznaczone wpisy z historii. Eksportuj najpierw CSV, jeśli potrzebujesz kopii zapasowej."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja a kiválasztott bejegyzéseket a történelemből. Először exportálj egy CSV-t, ha erősítésre van szükséged."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa valitut merkinnät pysyvästi historiastasi. Vie CSV ensin, jos tarvitset varmuuskopion."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent de valgte oppføringene fra din historie. Eksporter en CSV først hvis du trenger en sikkerhetskopi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent de valgte indgange fra din historie. Eksportér en CSV først hvis du har brug for backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удаляет выбранные записи из вашей истории. Сначала экспортируйте CSV, если вам нужна резервная копия."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente os itens selecionados do seu histórico. Exportar um CSV primeiro se você precisar de um backup."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це остаточно видаляє вибрані записи з історії. Експортувати CSV, якщо вам потрібна резервна копія."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les entrées sélectionnées de votre historique. Exportez d'abord un CSV si vous avez besoin d'une sauvegarde."
          }
        }
      }
    },
