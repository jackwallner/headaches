    "Coloured cells mark days you logged a headache. Darker means a more severe attack when severity was rated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloured cells mark days you logged a headache. Darker means a more severe attack when severity was rated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbige Zellen markieren Tage, an denen Sie Kopfschmerzen hatten. Darker bedeutet einen schwereren Angriff, wenn der Schweregrad bewertet wurde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛を記録した日は、着色された細胞マーク。 Darker は、重症度が評価されたときに、より厳しい攻撃を意味します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Células coloreadas marcan días que has registrado dolor de cabeza. Más oscuro significa un ataque más severo cuando se valoró la gravedad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le celle colorate segnano giorni che hai registrato un mal di testa. Darker significa un attacco più grave quando la gravità è stata valutata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolorowe komórki oznaczają dni, w których zapisał pan ból głowy. Ciemniejszy oznacza cięższy atak, kiedy oceniono stopień ciężkości."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színezett sejtek jelzik a fejfájást. A sötétebb azt jelenti, hogy súlyosabb támadás történt, ha a súlyosságot értékelték."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värilliset solut merkitsevät päiviä, jolloin sait päänsärkyä. Tummempi tarkoittaa vakavampaa hyökkäystä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargede celler markerer dager du logget på hodepine. Mørkere betyr et mer alvorlig angrep når alvorlighetsgraden ble vurdert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farvede celler markerer dage du loggede en hovedpine. Mørkere betyder et mere alvorligt angreb, når sværhedsgrad blev bedømt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветные клетки отмечают дни, когда у вас появилась головная боль. Темнее означает более сильный приступ, когда степень тяжести была оценена."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Células coloridas marcam dias em que você tem uma dor de cabeça. Mais escuro significa um ataque mais grave quando a gravidade foi avaliada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольорові клітинки позначають дні, які ви влаштували головний біль. Darker означає більш сильний напад, коли тяжкість була оцінена."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cellules colorées marquent les jours où vous avez enregistré un mal de tête. Darker signifie une attaque plus sévère quand la gravité a été notée."
          }
        }
      }
    },
