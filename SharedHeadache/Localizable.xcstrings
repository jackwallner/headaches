    "62% of headaches were logged on days with falling pressure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "62% of headaches were logged on days with falling pressure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "62% der Einträge entfielen auf Tage mit fallendem Luftdruck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛記録の62%は、気圧が下がった日にありました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 62% de los dolores de cabeza se registró en días en que bajó la presión atmosférica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 62% dei mal di testa è stato registrato nei giorni in cui la pressione atmosferica era in calo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "62% bólów głowy zapisano w dniach, gdy ciśnienie spadało."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejfájások 62%-át olyan napokon rögzítetted, amikor csökkent a légnyomás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "62 % päänsäryistä kirjattiin päivinä, jolloin ilmanpaine laski."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "62% av hodepinene ble registrert på dager med fallende lufttrykk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "62% af hovedpinerne blev registreret på dage med faldende lufttryk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "62% головных болей записаны в дни со снижением давления."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "62% das dores de cabeça foram registadas em dias de descida da pressão atmosférica."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "62% випадків головного болю записано в дні зі зниженням тиску."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "62% des maux de tête ont été notés les jours où la pression était en baisse."
          }
        }
      }
    },
