    "Purchase cancelled. Tap again to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase cancelled. Tap again to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf abgebrochen. Tippe erneut, um fortzufahren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入をキャンセルしました。もう一度タップすると続行します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra cancelada. Toca de nuevo para continuar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto annullato. Tocca di nuovo per continuare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup anulowano. Dotknij ponownie, aby kontynuować."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás megszakadt. A folytatáshoz koppints újra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto peruttiin. Jatka napauttamalla uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ble avbrutt. Trykk igjen for å fortsette."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet blev annulleret. Tryk igen for at fortsætte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка отменена. Нажми ещё раз, чтобы продолжить."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra cancelada. Toca novamente para continuar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупку скасовано. Торкнись ще раз, щоб продовжити."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat annulé. Touchez à nouveau pour continuer."
          }
        }
      }
    },
    "Queued. It will sync when your iPhone is nearby.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued. It will sync when your iPhone is nearby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vorgemerkt und synchronisiert, sobald dein iPhone in der Nähe ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ちです。iPhoneが近くに来ると同期します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola. Se sincronizará cuando el iPhone esté cerca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda. La sincronizzazione avverrà quando l’iPhone sarà vicino."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce. Zsynchronizuje się, gdy iPhone będzie w pobliżu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozik. Akkor szinkronizál, ha az iPhone a közelben van."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa. Tiedot synkronoituvat, kun iPhone on lähellä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagt i kø. Synkroniseres når iPhone er i nærheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat i kø. Synkroniseres, når din iPhone er i nærheden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очереди. Синхронизация начнётся, когда iPhone будет рядом."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em fila. A sincronização começa quando o iPhone estiver por perto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У черзі. Дані синхронізуються, коли iPhone буде поруч."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente. La synchronisation aura lieu lorsque votre iPhone sera à proximité."
          }
        }
      }
