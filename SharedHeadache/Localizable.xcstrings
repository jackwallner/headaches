          "stringUnit": {
            "state": "translated",
            "value": "Alerta quando se prevê que a pressão caia"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте, коли тиск є прогнозом падіння"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerte lorsque la pression devrait baisser"
          }
