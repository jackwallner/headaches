    "Enable Proactive Alerts first, then send a test notification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Proactive Alerts first, then send a test notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst die Wetterhinweise und sende dann eine Testbenachrichtigung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に予報通知を有効にしてから、テスト通知を送信してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero activa los avisos de previsión y luego envía una notificación de prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima attiva gli avvisi meteo, poi invia una notifica di prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw włącz powiadomienia o prognozie, a potem wyślij powiadomienie testowe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először kapcsold be az előrejelzési értesítéseket, majd küldj tesztértesítést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ensin ennusteilmoitukset käyttöön ja lähetä sitten testi-ilmoitus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå først på værvarsler, og send deretter et testvarsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå først vejrvarsler til, og send derefter en testmeddelelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включи уведомления по прогнозу, затем отправь тестовое уведомление."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa primeiro os alertas proativos e, em seguida, envia uma notificação de teste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку ввімкни проактивні сповіщення, а потім надішли тестове сповіщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord les alertes proactives, puis envoyez une notification de test."
          }
        }
      }
    },
