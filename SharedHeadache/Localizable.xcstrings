          }
        }
      }
    },
    "You've built a useful history. Unlock Pro to see your patterns and get proactive alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've built a useful history. Unlock Pro to see your patterns and get proactive alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast schon viele Einträge gesammelt. Schalte Pro frei, um deine Muster und Wetterhinweise zu sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が蓄積されてきました。Proを利用すると、パターンや予報通知を確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes un historial útil. Desbloquea Pro para ver tus patrones y recibir avisos de previsión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai creato uno storico utile. Sblocca Pro per vedere i tuoi andamenti e ricevere avvisi meteo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już przydatną historię. Odblokuj Pro, aby zobaczyć wzorce i otrzymywać powiadomienia o prognozie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már hasznos előzményeket gyűjtöttél. Oldd fel a Prót a mintázatok és az előrejelzési értesítések megtekintéséhez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet koonnut hyödyllisen historian. Avaa Pro nähdäksesi kuviosi ja saadaksesi ennusteilmoituksia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har bygget opp en nyttig historikk. Lås opp Pro for å se mønstrene dine og få værvarsler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har opbygget en nyttig historik. Lås Pro op for at se dine mønstre og få varsler fra vejrudsigten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты собрал полезную историю. Открой Pro, чтобы увидеть закономерности и получать уведомления по прогнозу."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já criaste um histórico útil. Desbloqueia o Pro para veres os teus padrões e receberes alertas proativos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти зібрав корисну історію. Розблокуй Pro, щоб переглядати закономірності й отримувати проактивні сповіщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez constitué un historique utile. Débloquez Pro pour consulter vos tendances et recevoir des alertes proactives."
          }
        }
      }
    },
