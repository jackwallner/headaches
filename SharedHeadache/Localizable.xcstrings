          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen %@, sitten %@. Automaattinen renews; peruuttaa milloin tahansa Asetukset vähintään 24 tuntia ennen kuin se päättyy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for %@, deretter %@. Auto-renews; kanseller når som helst i Innstillinger minst 24 timer før det slutter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for %@, derefter %@. Auto- nyheder; annuller når som helst i Indstillinger mindst 24 timer før det slutter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно для %@, затем %@. Автообновление; отменить в любое время в настройках по крайней мере за 24 часа до его окончания."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Livre para %@, depois %@. Renova automaticamente; cancele a qualquer momento em Configurações pelo menos 24 horas antes de terminar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно для %@, потім %@. Автоновини; скасувати будь-який час в налаштуваннях не менше 24 годин до закінчення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour %@, puis %@. Auto-renews; annuler à tout moment dans Paramètres au moins 24 heures avant qu'il ne se termine."
          }
        }
      }
    },
    "Then %@. Auto-renews; cancel anytime in Settings at least 24 hours before it ends.": {
