    "40% of your headaches, 1.6× the even baseline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "40% of your headaches, 1.6× the even baseline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "40% deiner Einträge, das 1,6-Fache des gleichmäßig verteilten Richtwerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛記録の40%。均等な基準値の1.6倍です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "40% de tus dolores de cabeza, 1,6× la referencia uniforme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 40% dei tuoi mal di testa, 1,6× il valore uniforme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "40% bólów głowy, czyli 1,6× równomiernego poziomu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejfájásaid 40%-a, az egyenletes eloszlás 1,6-szerese."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % päänsäryistäsi, 1,6× tasaisen jakauman vertailutaso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "40% av hodepinene dine, 1,6× referansenivået ved jevn fordeling."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "40% af dine hovedpiner, 1,6× den forventede andel ved en jævn fordeling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "40% твоих головных болей, в 1,6 раза выше равномерного уровня."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "40% das tuas dores de cabeça, 1,6× a média uniforme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "40% випадків головного болю, у 1,6× більше за рівномірний показник."
          }
        },
        "fr": {
          "stringUnit": {
