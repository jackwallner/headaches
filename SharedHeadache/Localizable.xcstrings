          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er ikke aktivert. Åpne iPhone-innstillinger og tillat varsler for One Tap Headache Tracker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
