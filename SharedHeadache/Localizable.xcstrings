            "value": "Aktiviere die Hintergrundprüfung der Vorhersage. Hinweise werden erst gesendet, wenn sich in deinen Einträgen ein Muster zu Luftdruck oder AQI zeigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで予報を確認します。記録に気圧やAQIのパターンが見られるまでは通知しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las comprobaciones en segundo plano. No recibirás avisos hasta que tus registros muestren patrones de presión o AQI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva i controlli in background. Non riceverai avvisi finché i tuoi registri non mostrano andamenti di pressione o AQI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz sprawdzanie prognozy w tle. Powiadomienia pojawią się dopiero, gdy wpisy pokażą wzorce ciśnienia lub AQI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a háttérben futó előrejelzés-ellenőrzést. Addig csendben marad, amíg a bejegyzéseidben légnyomás- vagy AQI-mintázat nem rajzolódik ki."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota taustalla tehtävät ennustetarkistukset käyttöön. Ilmoituksia tulee vasta, kun kirjauksissasi näkyy ilmanpaine- tai AQI-kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på bakgrunnssjekk av værmeldingen. Varsler sendes først når registreringene viser mønstre for lufttrykk eller AQI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå baggrundstjek af vejrudsigten til. Der sendes først varsler, når registreringerne viser mønstre for lufttryk eller AQI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи проверку прогноза в фоне. Уведомления появятся, только когда в записях проявятся закономерности давления или AQI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa as verificações de previsão em segundo plano. Só recebes alertas quando surgirem padrões de pressão ou AQI nos teus registos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкни фонову перевірку прогнозу. Сповіщення надходитимуть, лише коли записи покажуть закономірності тиску або AQI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les vérifications météo en arrière-plan. Les alertes restent silencieuses jusqu’à ce que vos notes fassent ressortir une tendance de pression ou d’AQI."
          }
        }
      }
    },
    "Turn on background forecast checks that stay quiet until your logs support a pressure or AQI trigger.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on background forecast checks that stay quiet until your logs support a pressure or AQI trigger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Hintergrundprüfung der Vorhersage. Hinweise werden erst gesendet, wenn sich in deinen Einträgen ein Muster zu Luftdruck oder AQI zeigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで予報を確認します。記録に気圧やAQIのパターンが見られるまでは通知しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las comprobaciones en segundo plano. No recibirás avisos hasta que tus registros respalden una señal de presión o AQI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva i controlli in background. Non riceverai avvisi finché i tuoi registri non supportano un segnale relativo a pressione o AQI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz sprawdzanie prognozy w tle. Powiadomienia pojawią się dopiero, gdy wpisy potwierdzą sygnał ciśnienia lub AQI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a háttérben futó előrejelzés-ellenőrzést. Értesítést csak akkor kapsz, ha a bejegyzéseid alátámasztanak egy légnyomási vagy AQI-jelet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota taustalla tehtävät ennustetarkistukset käyttöön. Ilmoituksia tulee vasta, kun kirjauksesi tukevat ilmanpaine- tai AQI-signaalia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på bakgrunnssjekk av værmeldingen. Varsler sendes først når registreringene støtter et signal for lufttrykk eller AQI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå baggrundstjek af vejrudsigten til. Der sendes først varsler, når registreringerne understøtter et signal for lufttryk eller AQI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи проверку прогноза в фоне. Уведомления появятся, только если записи подтверждают сигнал давления или AQI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa as verificações de previsão em segundo plano. Só recebes alertas quando os teus registos sustentarem um padrão de pressão ou AQI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкни фонову перевірку прогнозу. Сповіщення надходитимуть, лише коли записи підтвердять закономірність тиску або AQI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les vérifications météo en arrière-plan. Les alertes restent silencieuses jusqu’à ce que vos notes confirment une tendance de pression ou d’AQI."
