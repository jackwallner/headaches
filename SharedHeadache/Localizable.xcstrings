    "Air quality is forecast to reach AQI %@ today. Your logs show headaches on %lld of %lld similar days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air quality is forecast to reach AQI %@ today. Your logs show headaches on %lld of %lld similar days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für heute wird ein AQI von %@ erwartet. Deine Einträge zeigen Kopfschmerzen an %lld von %lld vergleichbaren Tagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予報ではAQI %@に達する見込みです。記録では、似た条件の日%lld日のうち%lld日に頭痛がありました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy se prevé que la calidad del aire alcance un AQI de %@. Tus registros muestran dolor de cabeza en %lld de %lld días similares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi la qualità dell’aria dovrebbe raggiungere AQI %@. Nei tuoi registri hai annotato mal di testa in %lld giorni su %lld simili."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś prognozowany AQI wynosi %@. W twoich wpisach ból głowy wystąpił w %lld z %lld podobnych dni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mai előrejelzés szerint a levegőminőség AQI-értéke %@ lesz. A bejegyzéseidben %lld-ből %lld hasonló napon szerepel fejfájás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänään AQI:n ennustetaan olevan %@. Kirjauksissasi päänsärky esiintyi %lld:na %lld samankaltaisesta päivästä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Luftkvaliteten er ventet å nå AQI %@ i dag. Registreringene dine viser hodepine på %lld av %lld lignende dager."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luftkvaliteten forventes at nå AQI %@ i dag. Dine registreringer viser hovedpine på %lld af %lld lignende dage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня AQI, по прогнозу, достигнет %@. В твоих записях головная боль была в %lld из %lld похожих дней."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, prevê-se que o AQI chegue a %@. Os teus registos mostram dores de cabeça em %lld de %lld dias semelhantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні прогнозується AQI %@. У твоїх записах головний біль був у %lld із %lld подібних днів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’AQI devrait atteindre %@ aujourd’hui. Vos notes indiquent des maux de tête %lld jours sur %lld jours comparables."
          }
        }
      }
    },
