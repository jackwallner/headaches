    "See what time, sleep, and weather patterns emerge from your logged headaches.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what time, sleep, and weather patterns emerge from your logged headaches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie, welche Zeit, Schlaf und Wettermuster aus Ihren protokollierten Kopfschmerzen hervorgehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された頭痛からどのような時間、睡眠、および気象パターンが出現するかを参照してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea qué tiempo, sueño y patrones climáticos emergen de sus dolores de cabeza conectados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi a che ora, sonno e condizioni meteo emergono dai mal di testa registrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, jaki czas, sen i wzorce pogodowe pojawiają się z zapisanych bólów głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg, hány óra, alvás és időjárási viszonyok jelennek meg a naplózott fejfájásodból."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mihin aikaan, unet, ja sääkuviot tulevat kirjautuneista päänsärkysi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hva tid, søvn og værmønstre kommer fra logget hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvad tid, søvn og vejrmønstre opstår fra din loggede hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, какое время, сон и погодные условия возникают из-за ваших головных болей."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja a que horas, sono e padrões climáticos emergem de suas dores de cabeça registradas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивись час, сон, і погодні візерунки з'являються з ваших зламаних головного болю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez l'heure, le sommeil et les conditions météorologiques qui émergent de vos maux de tête."
          }
        }
      }
    },
