    "%@ of your headaches with BP data occurred with elevated systolic readings (≥130), including %@ at hypertensive levels (≥140).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your headaches with BP data occurred with elevated systolic readings (≥130), including %@ at hypertensive levels (≥140)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ deiner Einträge mit Blutdruckdaten war der systolische Wert erhöht (≥130), darunter %@ im Bereich ab 140."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血圧データがある頭痛記録のうち%@は収縮期血圧が130以上で、そのうち%@は140以上でした。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre los dolores de cabeza con datos de presión arterial, el %@ coincidió con valores sistólicos elevados (≥130), incluido el %@ en niveles altos (≥140)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra i mal di testa con dati pressori, il %@ coincideva con valori sistolici elevati (≥130), incluso il %@ a livelli ipertensivi (≥140)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wśród bólów głowy z danymi o ciśnieniu, %@ odnotowano przy podwyższonym ciśnieniu skurczowym (≥130), w tym %@ przy wartościach ≥140."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vérnyomásadatokkal rendelkező fejfájásaid közül %@ emelkedett szisztolés értékkel (≥130) járt, ebből %@ esetben az érték elérte a magasvérnyomás-tartományt (≥140)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verenpainetiedot sisältävistä päänsäryistäsi %@ esiintyi kohonneen systolisen verenpaineen (≥130) yhteydessä, ja %@ tapauksessa tasolla ≥140."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av hodepinene dine med blodtrykksdata oppsto %@ ved forhøyet systolisk blodtrykk (≥130), inkludert %@ på nivåer ≥140."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Af dine hovedpiner med blodtryksdata forekom %@ ved forhøjet systolisk blodtryk (≥130), herunder %@ ved niveauer ≥140."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из головных болей с данными о давлении %@ возникли при повышенном систолическом давлении (≥130), в том числе %@ при значениях ≥140."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ das tuas dores de cabeça com dados de pressão arterial coincidiram com valores sistólicos elevados (≥130), incluindo %@ em níveis de hipertensão (≥140)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ випадків головного болю з даними про тиск збігалися з підвищеним систолічним тиском (≥130), зокрема %@ на рівні гіпертензії (≥140)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de vos maux de tête avec des données de tension ont coïncidé avec une pression systolique élevée (≥130), dont %@ à un niveau d’hypertension (≥140)."
          }
        }
      }
    },
