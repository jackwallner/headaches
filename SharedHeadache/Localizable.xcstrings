    "Location was turned off during setup. Enable it in Settings › Privacy › Location to add weather and place context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location was turned off during setup. Enable it in Settings › Privacy › Location to add weather and place context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wurde während der Einrichtung deaktiviert. Aktivieren Sie es in Einstellungen › Privatsphäre › Standort, um Wetter und Ortskontext hinzuzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップ中にロケーションがオフになりました。 [設定] › [プライバシー] › [場所] で、天気と場所のコンテキストを追加します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación fue apagada durante la configuración. Hágalo en Ajustes › Privacidad › Ubicación para añadir el clima y el contexto del lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è stata disattivata durante la configurazione. Abilita in Impostazioni › Privacy › Posizione per aggiungere contesto meteo e luogo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja została wyłączona podczas ustawiania. Włącz go w Ustawienia › Prywatność › Lokalizacja, aby dodać kontekst pogody i miejsca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyszínt kikapcsolták a beállítás alatt. Engedélyezze a Beállítások › Privacy › Helyszín hozzáadása időjárás és hely kontextus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijainti oli poissa käytöstä. Ota se käyttöön Asetukset › Yksityisyys › Sijainti lisätä sää ja paikka konteksti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stedet ble slått av under oppsett. Aktiver det i Innstillinger › Personvern › Sted å legge til vær og plasser kontekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeringen blev slukket under opsætningen. Aktivér det i Indstillinger › Privatliv › Placering for at tilføje vejr og sted kontekst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение было выключено во время установки. Включите его в Настройки › Конфиденциальность › Местоположение, чтобы добавить погоду и контекст места."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização foi desligada durante a instalação. Habilite-o em Configurações › Privacidade › Localização para adicionar tempo e colocar contexto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місце було вимкнено під час налаштування. Увімкнути його в налаштуваннях › Конфіденційність › Місцезнаходження для додавання погоди та контексту розміщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement a été désactivé pendant l'installation. Activez-le dans Paramètres › Confidentialité › Emplacement pour ajouter le contexte météo et lieu."
          }
        }
      }
    },
    "Location services are turned off for this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location services are turned off for this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortungsdienste sind für dieses Gerät deaktiviert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報は、このデバイスのためにオフになっています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de ubicación se apagan para este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi di localizzazione sono disattivati per questo dispositivo."
          }
        },
        "pl": {
