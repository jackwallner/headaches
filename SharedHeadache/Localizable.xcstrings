    "%@ of your headaches hit when both occurred together, %@ more often than if they were independent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your headaches hit when both occurred together, %@ more often than if they were independent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ihrer Kopfschmerzen trafen, wenn beide zusammen auftraten, %@ häufiger, als wenn sie unabhängig wären."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は、両方が一緒に発生したとき、あなたの頭痛のヒット, %@は、彼らが独立していたよりも頻繁に."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de sus dolores de cabeza golpeados cuando ambos ocurrieron juntos, %@ más a menudo que si eran independientes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del vostro mal di testa ha colpito quando entrambi si sono verificati insieme, %@ più spesso che se fossero indipendenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ z bólów głowy, które wystąpiły razem, %@ częściej niż gdyby były niezależne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fejfájás hit, amikor mindkettő történt együtt, %@ gyakrabban, mint ha függetlenek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ päänsärkysi osui kun molemmat tapahtuivat yhdessä, %@ useammin kuin jos ne olivat riippumattomia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ av hodepine når begge skjedde sammen, %@ oftere enn om de var uavhengige."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ af dine hovedpine ramt, når begge opstod sammen, %@ oftere, end hvis de var uafhængige."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головные боли %@ возникают, когда оба происходят вместе, %@ чаще, чем если бы они были независимыми."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ das suas dores de cabeça atingem quando ambas ocorreram juntas, %@ mais frequentemente do que se fossem independentes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вашого головного болю вдарив, коли обидва відбулися разом, %@ частіше, ніж якщо вони були незалежними."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de vos maux de tête frappés lorsque les deux se sont produits ensemble, %@ plus souvent que s'ils étaient indépendants."
          }
        }
      }
    },
    "%@ of your headaches occurred when %@ and %@ coincided, %@ the rate expected by chance (%@).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your headaches occurred when %@ and %@ coincided, %@ the rate expected by chance (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ihrer Kopfschmerzen traten auf, als %@ und %@ zusammenfielen, %@ die zufällig erwartete Rate (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ と %@ のキャッシュが発生したとき、%@ は、%@ は、チャンス(%@)で期待されるレートを一致させました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de sus dolores de cabeza ocurrieron cuando %@ y %@ coincidieron, %@ la tasa esperada por casualidad (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del mal di testa si è verificato quando %@ e %@ hanno coinciso, %@ il tasso previsto per caso (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wystąpienia bólów głowy wystąpiły, gdy %@ i %@ zbiegł się w czasie, %@ spodziewany przez przypadek (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fejfájás történt, amikor %@ és %@ egybeesett, %@ a várt sebesség véletlen (%@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päänsäryistä %@ kirjattiin silloin, kun %@ ja %@ esiintyivät yhdessä. Tämä on %@ odotettuun sattumanvaraiseen osuuteen nähden (%@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ av hodepinen din skjedde når %@ og %@ sammenfallet, %@ den forventede hastigheten ved tilfeldighet (%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ af din hovedpine opstod, når %@ og %@ faldt sammen, %@ den forventede sats ved et tilfælde (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ваших головных болей произошел, когда %@ и %@ совпали, %@ скорость, ожидаемая случайно (%@)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ das suas cefaleias ocorreu quando %@ e %@ coincidiram, %@ a taxa esperada por acaso (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вашого головного болю відбувався, коли %@ і %@ збіглися, %@ курс, очікуваний шанс (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de vos maux de tête est survenue lorsque %@ et %@ coïncidaient, %@ le taux attendu par hasard (%@)."
          }
        }
      }
    },
