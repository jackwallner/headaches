            "state": "translated",
            "value": "We'll tell you how many entries are in the file before saving anything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor etwas gespeichert wird, zeigen wir dir, wie viele Einträge die Datei enthält."
          }
        },
        "ja": {
