    "This file may contain events that are already in your history. How would you like to handle them?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file may contain events that are already in your history. How would you like to handle them?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann Ereignisse enthalten, die sich bereits in Ihrer Historie befinden. Wie möchten Sie damit umgehen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは、既にあなたの履歴に存在するイベントを含む場合があります。 どうすればよいですか?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo puede contener eventos que ya están en su historia. ¿Te gustaría manejarlos?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file può contenere eventi che sono già nella tua storia. Come vorresti gestirli?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik ten może zawierać zdarzenia, które są już w Twojej historii. Co ty na to?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl tartalmazhat olyan eseményeket, amelyek már az Ön történetében szerepelnek. Mit szólna hozzá, ha kezelné őket?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto voi sisältää tapahtumia, jotka ovat jo historiassasi. Haluaisitko hoitaa ne?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen kan inneholde hendelser som allerede er i din historie. Hvordan vil du håndtere dem?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil kan indeholde begivenheder, der allerede er i din historie. Hvad siger du til at håndtere dem?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл может содержать события, которые уже есть в вашей истории. Как бы вы хотели с ними справиться?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo pode conter eventos que já estão em seu histórico. Gostaria de lidar com eles?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл може містити події, які вже в історії. Яким чином ви хочете працювати?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier peut contenir des événements qui sont déjà dans votre historique. Comment voulez-vous les gérer ?"
          }
        }
      }
    },
