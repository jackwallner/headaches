    "A weather heads-up based on your logs, 12 to 24 hours ahead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A weather heads-up based on your logs, 12 to 24 hours ahead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wetterhinweis auf Grundlage deiner Einträge, 12 bis 24 Stunden im Voraus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に基づく12～24時間先の天気のお知らせ"
          }
        },
        "es": {
