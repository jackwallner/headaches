    "One-page report covering the last 90 days: headache count, severity mix, calendar heatmap, and your top patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-page report covering the last 90 days: headache count, severity mix, calendar heatmap, and your top patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einseitiger Bericht über die letzten 90 Tage: Anzahl der Kopfschmerzen, Schweregrad, Kalender-Heatmap und Ihre Top-Muster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の90日間をカバーするワンページレポート:頭痛カウント、重症度ミックス、カレンダーヒートマップ、およびトップパターン。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe de una página que cubre los últimos 90 días: cuenta de dolor de cabeza, mezcla de severidad, mapa de calor del calendario, y sus patrones superiores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporto di una pagina che copre gli ultimi 90 giorni: il conteggio di mal di testa, la miscela di gravità, la mappa di calore del calendario e i tuoi modelli top."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport z ostatniej strony z ostatnich 90 dni: liczba bólów głowy, mieszanka dotkliwości, mapa termiczna kalendarza i najlepsze wzorce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy oldalas jelentés az elmúlt 90 napról: fejfájás, súlyosság, naptár hőtérkép, és a legjobb minták."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhden sivun raportti kattaa viimeiset 90 päivää: päänsärkyä, vakavuus seka, kalenteri lämpökartta, ja top kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En-side rapport som dekker de siste 90 dagene: hodepine teller, alvorlighetsgrad blanding, kalendervarmekart og dine øverste mønstre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One- side rapport dækker de sidste 90 dage: hovedpine tæller, sværhedsgrad mix, kalender heatmap, og dine øverste mønstre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одностраничный отчет, охватывающий последние 90 дней: количество головных болей, смесь тяжести, календарная тепловая карта и ваши лучшие модели."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatório de uma página cobrindo os últimos 90 dias: contagem de dores de cabeça, mistura de gravidade, mapa de calor do calendário, e seus padrões superiores."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Односторінковий звіт, що охоплює останні 90 днів: головний біль, мікс тяжкості, календарна карта та ваші вершини."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport d'une page couvrant les 90 derniers jours : nombre de maux de tête, mélange de gravité, plan thermique du calendrier, et vos modèles supérieurs."
          }
        }
      }
    },
