          "stringUnit": {
            "state": "translated",
            "value": "Speichere alle ausgewählten Einträge als CSV-Datei, die du mit deiner Arztpraxis teilen, in Numbers öffnen oder sichern kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した記録をCSVファイルに保存できます。医師との共有、Numbersでの表示、バックアップに使えます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los registros seleccionados en un CSV para compartirlo con tu médico, abrirlo en Numbers o conservar una copia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le registrazioni selezionate in un file CSV da condividere con il medico, aprire in Numbers o conservare come backup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz wybrane wpisy w pliku CSV, który możesz udostępnić lekarzowi, otworzyć w Numbers lub zachować jako kopię zapasową."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd a kiválasztott bejegyzéseket CSV-fájlba, amelyet megoszthatsz az orvosoddal, megnyithatsz a Numbersben vagy biztonsági mentésként használhatsz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna valitut kirjaukset CSV-tiedostoon, jonka voit jakaa lääkärille, avata Numbersissa tai säilyttää varmuuskopiona."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre alle valgte registreringer i en CSV-fil du kan dele med legen din, åpne i Numbers eller sikkerhetskopiere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem alle valgte registreringer i en CSV-fil, som du kan dele med din læge, åbne i Numbers eller bruge som sikkerhedskopi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохрани выбранные записи в CSV-файл, который можно отправить врачу, открыть в Numbers или оставить как резервную копию."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os registos selecionados num ficheiro CSV que podes partilhar com o médico, abrir no Numbers ou usar como cópia de segurança."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережи вибрані записи у CSV-файл, яким можна поділитися з лікарем, відкрити в Numbers або скористатися як резервною копією."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les notes sélectionnées dans un fichier CSV à partager avec votre médecin, à ouvrir dans Numbers ou à conserver en sauvegarde."
          }
        }
      }
    },
