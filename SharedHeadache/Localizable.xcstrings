    "Alert text includes the probability lift and breakdown so you know why it fired.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert text includes the probability lift and breakdown so you know why it fired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hinweis zeigt, wie oft das Muster in deinen Einträgen vorkam und welche Signale dazu passten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知には、どの信号が一致したかと、記録上の割合が表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso muestra la diferencia de probabilidad observada y el desglose para que sepas por qué apareció."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avviso mostra la variazione osservata nella frequenza e il relativo dettaglio, così puoi capire perché è stato inviato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie pokazuje zaobserwowaną zmianę częstości i jej szczegóły, aby wyjaśnić, dlaczego zostało wysłane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítés megmutatja a gyakoriság növekedését és az adatokat, hogy lásd, miért kaptad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksessa näkyy esiintymistiheyden kasvu ja erittely, jotta tiedät, miksi se lähetettiin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varselteksten viser hvor mye hyppigheten økte og fordelingen, så du ser hvorfor varselet ble sendt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varselsteksten viser stigningen i hyppighed og fordelingen, så du kan se, hvorfor det blev sendt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В уведомлении показаны увеличение частоты и подробные данные, чтобы ты понимал, почему оно пришло."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O alerta mostra a diferença de frequência e os dados em detalhe, para perceberes o motivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сповіщенні наведено різницю частоти та докладні дані, щоб було зрозуміло, чому воно надійшло."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alerte indique la hausse de fréquence et le détail des données pour en expliquer l’envoi."
          }
        }
      }
    },
    "Alert text shows how often headaches appeared on similar days in your logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert text shows how often headaches appeared on similar days in your logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hinweis zeigt, wie oft du an ähnlichen Tagen einen Eintrag erfasst hast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知には、似た条件の日に頭痛を記録した頻度が表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso muestra con qué frecuencia registraste dolor de cabeza en días similares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avviso mostra quanto spesso hai registrato mal di testa in giornate simili."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie pokazuje, jak często w twoich wpisach ból głowy pojawiał się w podobnych dniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítés megmutatja, milyen gyakran szerepel fejfájás hasonló napokon a bejegyzéseidben."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksessa näkyy, kuinka usein kirjauksissasi esiintyi päänsärkyä samankaltaisina päivinä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varselteksten viser hvor ofte hodepine forekom på lignende dager i registreringene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varselsteksten viser, hvor ofte der blev registreret hovedpine på lignende dage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В уведомлении показано, как часто в похожие дни в твоих записях встречается головная боль."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O alerta indica quantas vezes os teus registos incluem dores de cabeça em dias semelhantes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сповіщенні показано, як часто у твоїх записах головний біль траплявся в подібні дні."
          }
