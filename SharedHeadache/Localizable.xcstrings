            "state": "translated",
            "value": "Les services de localisation sont désactivés pour cet appareil."
          }
        }
      }
    },
    "Location permission is required for weather and place context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is required for weather and place context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standorterlaubnis ist für Wetter und Ortskontext erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天候や場所のコンテキストに必要な場所の許可が必要です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de ubicación es necesario para el clima y el contexto del lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso di posizione è richiesto per il contesto meteo e di luogo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla warunków pogodowych i pogodowych wymagane jest zezwolenie na lokalizację."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyszíni engedély szükséges az időjárás és a hely kontextus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintilupa vaaditaan sää- ja paikkayhteyteen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliggenhet er nødvendig for vær og sted kontekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placering er påkrævet for vejr og sted kontekst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на местоположение требуется для погоды и контекста места."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de localização é necessária para o contexto meteorológico e de lugar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на локацію обов’язкове для погодних умов та умов розміщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation d'emplacement est requise pour le contexte météorologique et local."
          }
        }
      }
    },
