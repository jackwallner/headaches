    "Location was turned off during setup. Enable it in Settings › Privacy › Location to add weather and place context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location was turned off during setup. Enable it in Settings › Privacy › Location to add weather and place context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Standortzugriff bei der Einrichtung deaktiviert. Aktiviere ihn unter „Einstellungen“ › „Datenschutz“ › „Ortungsdienste“, um Wetter- und Ortsangaben hinzuzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定時に位置情報をオフにしました。天気や場所の情報を追加するには、「設定」›「プライバシー」›「位置情報サービス」でオンにしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivaste la ubicación durante la configuración. Actívala en Ajustes › Privacidad › Localización para añadir el tiempo y el nombre del lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai disattivato la posizione durante la configurazione. Attivala in Impostazioni › Privacy e sicurezza › Localizzazione per aggiungere meteo e nome del luogo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja została wyłączona podczas konfiguracji. Włącz ją w Ustawieniach › Prywatność i ochrona › Usługi lokalizacji, aby dodać pogodę i nazwę miejsca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítás során kikapcsoltad a helymeghatározást. Az időjárási és helyadatokhoz engedélyezd a Beállítások > Adatvédelem és biztonság > Helymeghatározás alatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistit sijainnin käytöstä käyttöönoton aikana. Ota se käyttöön kohdassa Asetukset > Tietosuoja ja suojaus > Sijaintipalvelut, jotta saat sää- ja paikkatiedot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slo av posisjon under oppsettet. Slå den på under Innstillinger > Personvern og sikkerhet > Stedstjenester for å legge til vær- og stedsinformasjon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slog position fra under opsætningen. Slå den til under Indstillinger > Anonymitet og sikkerhed > Lokalitetstjenester for at tilføje vejr- og stedsoplysninger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты выключил геолокацию при настройке. Включи её в Настройках > Конфиденциальность и безопасность > Службы геолокации, чтобы добавить данные о погоде и месте."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização foi desativada durante a configuração. Ativa-a em Definições › Privacidade › Serviços de localização para acrescentar dados meteorológicos e informações do local."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час налаштування геолокацію було вимкнено. Увімкни її в Параметрах › Приватність › Служби геолокації, щоб додавати дані про погоду й місце."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation a été désactivée pendant la configuration. Activez-la dans Réglages › Confidentialité › Service de localisation pour ajouter la météo et le lieu aux notes."
          }
        }
      }
    },
    "Location-based weather, pressure, air quality, UV, and pollen-style signals when available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location-based weather, pressure, air quality, UV, and pollen-style signals when available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofern verfügbar: standortbezogene Daten zu Wetter, Luftdruck, Luftqualität, UV-Index und Pollen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合、位置情報に基づく天気、気圧、空気質、UV、花粉などの情報を表示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando estén disponibles, se muestran señales locales del tiempo, la presión, la calidad del aire, el índice UV y el polen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando disponibili, segnali locali relativi a meteo, pressione, qualità dell’aria, UV e polline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli są dostępne, lokalne sygnały dotyczą pogody, ciśnienia, jakości powietrza, UV i pyłków."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elérhetők, helyi időjárási, légnyomás-, levegőminőségi, UV- és pollenjelek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatavilla olevat sijaintiin perustuvat sää-, ilmanpaine-, ilmanlaatu-, UV- ja siitepölysignaalit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelige vær-, lufttrykks-, luftkvalitets-, UV- og pollensignaler basert på posisjonen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når de er tilgængelige, bruges positionsbaserede signaler om vejr, lufttryk, luftkvalitet, UV og pollen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если доступны, показываются погодные сигналы по местоположению: давление, качество воздуха, УФ-излучение и пыльца."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando disponíveis, são recolhidos dados meteorológicos locais, pressão atmosférica, qualidade do ar, UV e pólen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За наявності даних можна переглядати місцеву погоду, тиск, якість повітря, UV та рівень пилку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon les données disponibles, les signaux locaux comprennent la météo, la pression, la qualité de l’air, les UV et le pollen."
          }
        }
      }
    },
