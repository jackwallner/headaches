    },
    "Log a headache with a single tap. The app quietly captures time, optional Apple Health context, and optional local weather so you can spot patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a headache with a single tap. The app quietly captures time, optional Apple Health context, and optional local weather so you can spot patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Kopfschmerzen mit einem Tipp. Die App speichert Uhrzeit sowie optional Health-Daten und lokales Wetter, damit du Muster in deinen Einträgen erkennen kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで頭痛を記録できます。時刻に加えて、任意でApple Healthの情報や地域の天気を取得し、記録のパターンを確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un dolor de cabeza con un solo toque. La app guarda la hora y, si lo permites, añade datos de Apple Health y del tiempo local para que puedas observar patrones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un mal di testa con un tocco. L’app salva l’ora e, se lo consenti, aggiunge dati di Apple Health e del meteo locale per aiutarti a osservare gli andamenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ból głowy jednym dotknięciem. Aplikacja zapisze godzinę i, jeśli zezwolisz, doda dane z Apple Health oraz lokalną pogodę, aby ułatwić obserwowanie wzorców."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsd egy érintéssel a fejfájást. Az alkalmazás feljegyzi az időpontot, és engedély esetén hozzáadja az Apple Health adatait és a helyi időjárást, hogy felismerhesd a mintázatokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa päänsärky yhdellä napautuksella. Sovellus tallentaa ajankohdan sekä luvallasi Apple Healthin tiedot ja paikallisen sään, jotta voit huomata kuvioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer hodepine med ett trykk. Appen lagrer tidspunktet og, hvis du gir tilgang, Apple Health-data og lokalt vær, slik at du kan se mønstre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer en hovedpine med ét tryk. Appen gemmer tidspunktet og, hvis du giver adgang, Apple Health-data og lokalt vejr, så du kan se mønstre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши головную боль одним касанием. Приложение сохранит время, а с твоего разрешения добавит данные Apple Health и местную погоду, чтобы ты мог замечать закономерности."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista uma dor de cabeça com um toque. A app guarda a hora e, se autorizares, acrescenta dados da app Saúde e meteorologia local para poderes observar padrões."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши головний біль одним дотиком. Програма збереже час, а за твоїм дозволом додасть дані Здоров’я та місцеву погоду, щоб ти міг помічати закономірності."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez un mal de tête d’une seule touche. L’app enregistre l’heure et, si vous l’autorisez, ajoute les données de Santé et la météo locale pour faire ressortir des tendances."
          }
        }
      }
    },
