    "Export your headache history to a CSV file you can share with a doctor or open in Numbers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your headache history to a CSV file you can share with a doctor or open in Numbers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere deinen Kopfschmerzverlauf als CSV-Datei, die du mit deiner Arztpraxis teilen oder in Numbers öffnen kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛の記録をCSVファイルに書き出して、医師と共有したりNumbersで開いたりできます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tu historial de dolores de cabeza a un archivo CSV para compartirlo con un médico o abrirlo en Numbers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta lo storico dei mal di testa in un file CSV da condividere con il medico o aprire in Numbers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj historię bólów głowy do pliku CSV, który możesz udostępnić lekarzowi lub otworzyć w Numbers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportáld a fejfájás-bejegyzéseid CSV-fájlba, amelyet megoszthatsz az orvosoddal vagy megnyithatsz a Numbersben."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie päänsärkytietosi CSV-tiedostoon, jonka voit jakaa lääkärille tai avata Numbersissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter hodepinehistorikken din til en CSV-fil som du kan dele med legen din eller åpne i Numbers."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter din hovedpinehistorik til en CSV-fil, som du kan dele med din læge eller åbne i Numbers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируй историю головных болей в CSV-файл, который можно отправить врачу или открыть в Numbers."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta o teu histórico de dores de cabeça para um ficheiro CSV que podes partilhar com o médico ou abrir no Numbers."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортуй історію головного болю у CSV-файл, яким можна поділитися з лікарем або відкрити в Numbers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez votre historique de maux de tête dans un fichier CSV à partager avec votre médecin ou à ouvrir dans Numbers."
          }
        }
      }
