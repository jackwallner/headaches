    "Pro analyzes your logged events and surfaces the patterns hiding in the data (sleep, pressure, time of day, weather) with a chart and explanation for each one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analyzes your logged events and surfaces the patterns hiding in the data (sleep, pressure, time of day, weather) with a chart and explanation for each one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro wertet deine Einträge aus und zeigt Muster zu Schlaf, Luftdruck, Tageszeit und Wetter. Zu jedem Muster gibt es eine Grafik und Erklärung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proは頭痛の記録を分析し、睡眠、気圧、時間帯、天気に見られるパターンをグラフと説明で表示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analiza tus registros y muestra patrones en los datos de sueño, presión, horario y tiempo, con un gráfico y una explicación para cada uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analizza i tuoi registri e mostra gli andamenti relativi a sonno, pressione, orari e meteo, con un grafico e una spiegazione per ciascuno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analizuje twoje wpisy i pokazuje wzorce dotyczące snu, ciśnienia, pory dnia i pogody, wraz z wykresem i opisem każdego z nich."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro elemzi a bejegyzéseidet, és diagrammal, valamint magyarázattal mutatja meg az alvásban, a légnyomásban, az időpontokban és az időjárásban látható mintázatokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analysoi kirjauksesi ja nostaa esiin uneen, ilmanpaineeseen, vuorokaudenaikaan ja säähän liittyviä kuvioita kaavioineen ja selityksineen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analyserer registreringene dine og viser mønstre for søvn, lufttrykk, tidspunkt og vær med en graf og forklaring for hvert mønster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analyserer dine registreringer og viser mønstre for søvn, lufttryk, tidspunkt og vejr med en graf og forklaring til hvert mønster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro анализирует твои записи и показывает закономерности сна, давления, времени суток и погоды с графиком и пояснением к каждой."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pro analisa os teus registos e apresenta padrões nos dados de sono, pressão, horário e meteorologia, com um gráfico e uma explicação para cada um."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro аналізує твої записи й показує закономірності у даних про сон, тиск, час доби та погоду, додаючи графік і пояснення до кожної."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analyse vos notes et fait ressortir les tendances dans les données de sommeil, de pression, d’horaire et de météo, avec un graphique et une explication pour chacune."
          }
        }
      }
    },
    "Pro checks your local forecast and only pings when your logs support the pressure, AQI, or timing pattern behind the alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro checks your local forecast and only pings when your logs support the pressure, AQI, or timing pattern behind the alert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro prüft deine lokale Vorhersage und sendet nur dann einen Hinweis, wenn deine Einträge ein Muster zu Luftdruck, AQI oder Uhrzeit erkennen lassen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proは地域の予報を確認し、気圧、AQI、時間帯の信号が記録に見られる場合に通知します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro consulta la previsión local y solo te avisa si tus registros respaldan un patrón de presión, AQI u horario relacionado con el aviso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro controlla le previsioni locali e ti avvisa solo quando i tuoi registri supportano l’andamento di pressione, AQI o orario associato all’avviso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro sprawdza lokalną prognozę i wysyła powiadomienie tylko wtedy, gdy twoje wpisy potwierdzają wzorzec ciśnienia, AQI lub pory dnia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro ellenőrzi a helyi előrejelzést, és csak akkor küld értesítést, ha a bejegyzéseid alátámasztják a légnyomási, AQI- vagy időbeli mintázatot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tarkistaa paikallisen ennusteen ja lähettää ilmoituksen vain, kun kirjauksesi tukevat siihen liittyvää ilmanpaine-, AQI- tai ajankohtakuviota."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro sjekker den lokale værmeldingen og varsler bare når registreringene dine støtter et mønster for lufttrykk, AQI eller tidspunkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tjekker den lokale vejrudsigt og sender kun en meddelelse, når dine registreringer understøtter et mønster for lufttryk, AQI eller tidspunkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro проверяет местный прогноз и отправляет уведомление, только если записи подтверждают закономерность давления, AQI или времени суток."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pro consulta a previsão local e só envia um alerta quando os teus registos sustentam o padrão de pressão, AQI ou horário correspondente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro перевіряє місцевий прогноз і сповіщає лише тоді, коли записи підтверджують закономірність тиску, AQI або часу, на якій ґрунтується сповіщення."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro consulte les prévisions locales et n’envoie une alerte que si vos notes confirment une tendance de pression, d’AQI ou d’horaire."
          }
        }
      }
    },
    "Pro summarizes patterns in your logged sleep, pressure, timing, and weather data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro summarizes patterns in your logged sleep, pressure, timing, and weather data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro fasst Muster zu Schlaf, Luftdruck, Uhrzeit und Wetter in deinen Einträgen zusammen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proは睡眠、気圧、時間帯、天気に関する記録のパターンをまとめます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro resume los patrones de tus registros de sueño, presión, horarios y tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro riassume gli andamenti nei tuoi dati registrati di sonno, pressione, orari e meteo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro podsumowuje wzorce w zapisanych danych dotyczących snu, ciśnienia, pory dnia i pogody."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro összefoglalja az alvás-, légnyomás-, időpont- és időjárási adataidban látható mintázatokat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kokoaa yhteen kirjattuihin uni-, ilmanpaine-, ajankohta- ja säätietoihin liittyvät kuviot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro oppsummerer mønstre i søvn-, lufttrykks-, tids- og værdataene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro opsummerer mønstre i dine registrerede søvn-, lufttryks-, tids- og vejrdata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro обобщает закономерности в записанных данных о сне, давлении, времени и погоде."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pro resume padrões nos dados registados de sono, pressão, horário e meteorologia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro підсумовує закономірності у записах про сон, тиск, час і погоду."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro résume les tendances relevées dans vos données de sommeil, de pression, d’horaire et de météo."
          }
        }
      }
    },
