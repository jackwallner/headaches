    "Bring entries in from a backup or another device, using a CSV file exported from this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring entries in from a backup or another device, using a CSV file exported from this app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Einträge aus einem Backup oder von einem anderen Gerät mit einer CSV-Datei aus dieser App."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリから書き出したCSVファイルを使って、バックアップや別のデバイスから記録を取り込みます。"
          }
        },
        "es": {
