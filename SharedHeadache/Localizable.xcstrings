          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első %@ ingyenes, utána %@. Automatikusan megújul. A Beállításokban bármikor lemondhatod, legalább 24 órával a lejárat előtt."
          }
        },
        "fi": {
