    "Unlock every Headache Pro feature. Private, on-device, no accounts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock every Headache Pro feature. Private, on-device, no accounts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte alle Funktionen von Headache Pro frei. Privat, direkt auf deinem Gerät, ohne Konto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Headache Proのすべての機能を利用できます。プライベートな端末内処理で、アカウントは不要です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a todas las funciones de Headache Pro. Tus datos son privados y se procesan en el dispositivo. No necesitas una cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca tutte le funzioni di Headache Pro. I dati restano privati sul dispositivo. Non serve un account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj wszystkie funkcje Headache Pro. Dane są prywatne i pozostają na urządzeniu. Konto nie jest potrzebne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldd fel a Headache Pro összes funkcióját. Az adatok az eszközödön maradnak, fiók nélkül."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kaikki Headache Pron ominaisuudet. Tiedot pysyvät laitteellasi, eikä tiliä tarvita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp alle Headache Pro-funksjonene. Dataene forblir på enheten, uten konto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås alle Headache Pro-funktioner op. Dine data bliver på enheden, og du behøver ingen konto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой все функции Headache Pro. Данные остаются на устройстве, аккаунт не нужен."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia todas as funcionalidades de Headache Pro. Privadas, no dispositivo e sem conta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуй усі функції Headache Pro. Дані залишаються на пристрої, обліковий запис не потрібен."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez toutes les fonctionnalités Headache Pro. Vos données restent sur l’appareil, sans compte."
          }
        }
      }
    },
