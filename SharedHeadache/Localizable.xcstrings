    "A clearer picture of your headaches": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer picture of your headaches"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klareres Bild deiner Kopfschmerzen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭痛の傾向をより詳しく"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visión más clara de tus dolores de cabeza"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un quadro più chiaro dei tuoi mal di testa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełniejszy obraz twoich bólów głowy"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átfogóbb kép a fejfájásaidról"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selkeämpi kuva päänsäryistäsi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tydeligere bilde av hodepinene dine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tydeligere billede af dine hovedpiner"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более полное представление о твоих головных болях"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visão mais clara das tuas dores de cabeça"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чіткіше уявлення про твої головні болі"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieux comprendre vos maux de tête"
          }
        }
      }
    },
    "A few quick questions help Patterns highlight areas you may want to explore. Take it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few quick questions help Patterns highlight areas you may want to explore. Take it anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar kurze Fragen helfen dir, Bereiche in deinen Einträgen zu entdecken. Du kannst das Quiz jederzeit machen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの質問に答えると、記録の中から確認したい点を見つけやすくなります。いつでも回答できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas preguntas breves ayudan a Patrones a destacar aspectos que quizá quieras explorar. Puedes responderlas cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poche domande aiutano Andamenti a mettere in evidenza gli aspetti che potresti voler approfondire. Puoi rispondere quando vuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka krótkich pytań pomoże wskazać obszary, które możesz chcieć lepiej poznać. Odpowiedz, kiedy chcesz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány rövid kérdés segít kiemelni a mintázatokat, amelyeket érdemes lehet jobban megismerned. Bármikor kitöltheted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama nopea kysymys auttaa nostamaan esiin kuviot, joita voit tutkia tarkemmin. Vastaa milloin vain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen få spørsmål hjelper med å løfte fram mønstre du kanskje vil utforske. Svar når det passer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par korte spørgsmål hjælper med at fremhæve mønstre, du måske vil undersøge nærmere. Svar, når det passer dig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько коротких вопросов помогут выделить закономерности, которые ты сможешь изучить. Ответь в любое время."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas perguntas rápidas ajudam a destacar padrões que talvez queiras explorar. Podes responder quando quiseres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька запитань допоможуть побачити закономірності, які варто дослідити. Відповідай, коли зручно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques questions rapides aident Tendances à faire ressortir des points que vous pourriez vouloir explorer. Répondez quand vous le souhaitez."
          }
        }
      }
    },
    "A few quick questions so Patterns can surface the triggers most relevant to you. Take it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few quick questions so Patterns can surface the triggers most relevant to you. Take it anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar kurze Fragen helfen dir, Muster in deinen Einträgen zu entdecken. Du kannst das Quiz jederzeit machen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの質問に答えると、記録の中からあなたに関係するパターンを見つけやすくなります。いつでも回答できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas preguntas breves ayudan a Patrones a destacar las señales más relevantes para ti. Puedes responderlas cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poche domande aiutano Andamenti a mettere in evidenza i segnali più rilevanti per te. Puoi rispondere quando vuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka krótkich pytań pomoże wskazać sygnały, które mogą być dla ciebie najistotniejsze. Odpowiedz, kiedy chcesz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány rövid kérdés segít kiemelni a számodra legfontosabb jeleket. Bármikor kitöltheted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama nopea kysymys auttaa tunnistamaan sinulle tärkeimmät signaalit. Vastaa milloin vain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen få spørsmål hjelper med å finne signalene som er mest relevante for deg. Svar når det passer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par korte spørgsmål hjælper med at fremhæve de signaler, der er vigtigst for dig. Svar, når det passer dig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько коротких вопросов помогут выделить сигналы, наиболее важные для тебя. Ответь в любое время."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas perguntas rápidas ajudam a destacar os padrões mais relevantes para ti. Podes responder quando quiseres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька запитань допоможуть виділити найважливіші закономірності. Відповідай, коли зручно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques questions rapides aident Tendances à faire ressortir les tendances les plus pertinentes pour vous. Répondez quand vous le souhaitez."
          }
        }
      }
    },
