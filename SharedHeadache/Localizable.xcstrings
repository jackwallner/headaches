    "Found %@ event%@ in the file. How would you like to handle events that already exist?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %@ event%@ in the file. How would you like to handle events that already exist?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält %@ Eintrag%@. Wie möchtest du mit Einträgen umgehen, die bereits vorhanden sind?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに%@件の記録%@が見つかりました。すでにある記録はどのように扱いますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %@ registro%@ en el archivo. ¿Cómo quieres gestionar los que ya existen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel file ci sono %@ registrazion%@. Come vuoi gestire quelle già presenti?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pliku znaleziono %@ wpis%@. Jak chcesz postąpić z wpisami, które już istnieją?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlban %@ bejegyzés%@ található. Mit tegyünk a már meglévő bejegyzésekkel?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostosta löytyi %@ tapahtuma%@. Miten käsittelemme jo olemassa olevat kirjaukset?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant %@ registrering%@ i filen. Hva vil du gjøre med registreringer som allerede finnes?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandt %@ registrering%@ i filen. Hvad vil du gøre med registreringer, der allerede findes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле найдено %@ запис%@. Что делать с уже существующими записями?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contém %@ registo%@. Como queres tratar os registos que já existem?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі знайдено %@ запис%@. Як обробити записи, що вже існують?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient %@ note%@. Comment souhaitez-vous traiter les notes déjà présentes ?"
          }
        }
      }
    },
