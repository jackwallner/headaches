    "Thanks! Your answers help us improve future versions of Patterns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks! Your answers help us improve future versions of Patterns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Deine Antworten helfen uns, künftige Versionen von „Muster“ zu verbessern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご回答ありがとうございます。今後のパターン機能の改善に役立てます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Tus respuestas nos ayudan a mejorar futuras versiones de Patrones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie! Le tue risposte ci aiutano a migliorare le prossime versioni di Andamenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy! Dzięki twoim odpowiedziom możemy ulepszać funkcję analizy wzorców."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük! A válaszaid segítenek továbbfejleszteni a mintázatelemzést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos! Vastauksesi auttavat kehittämään kuvioiden analysointia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk! Svarene dine hjelper oss med å forbedre mønsteranalysen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak! Dine svar hjælper os med at forbedre mønsteranalysen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо! Твои ответы помогут улучшить анализ закономерностей."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado! As tuas respostas ajudam-nos a melhorar futuras versões de Padrões."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо! Твої відповіді допоможуть покращити майбутні версії розділу «Закономірності»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Vos réponses nous aideront à améliorer les prochaines versions de Tendances."
          }
        }
      }
    },
