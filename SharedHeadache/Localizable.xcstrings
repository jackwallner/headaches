    "# Severity is an optional rating captured when the prompt is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Severity is an optional rating captured when the prompt is enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Der Schweregrad ist eine optionale Bewertung, die erfasst wird, wenn die Abfrage aktiviert ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 重症度は、設定を有効にすると記録できる任意の評価です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# La intensidad es una valoración opcional que se registra si activas esta pregunta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# L’intensità è una valutazione facoltativa, registrata se attivi la relativa domanda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Nasilenie to opcjonalna ocena zapisywana po włączeniu pytania."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# A fájdalom erősségének értékelése opcionális, és csak akkor kerül rögzítésre, ha bekapcsolod a kérdést."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Kivun voimakkuuden arviointi on valinnaista, ja se kirjataan, jos kysymys on käytössä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Alvorlighetsgrad er en valgfri vurdering som registreres hvis spørsmålet er slått på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Vurdering af smerteintensitet er valgfri og registreres, hvis du slår spørgsmålet til."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Оценка интенсивности необязательна и записывается, если включён соответствующий вопрос."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# A intensidade é uma avaliação opcional, registada quando a pergunta está ativa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Інтенсивність можна оцінити за бажанням, якщо ввімкнено відповідне запитання."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# L’intensité peut être évaluée en option si la question est activée."
          }
        }
      }
    },
    "# Status fields show whether capture, Health, and environment context was available. Message fields explain missing context or errors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Status fields show whether capture, Health, and environment context was available. Message fields explain missing context or errors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Die Statusfelder zeigen, ob Eintrag, Health- und Umweltdaten verfügbar waren. Die Meldungsfelder erklären fehlende Daten oder Fehler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 状態欄には記録、Health、環境データが取得できたかが表示されます。メッセージ欄には不足しているデータやエラーの説明が表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de estado indican si se obtuvo información de la entrada, de Salud y del entorno. Los campos de mensaje explican los datos que faltan o los errores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi di stato indicano se erano disponibili i dati della registrazione, di Salute e dell’ambiente. I campi del messaggio spiegano i dati mancanti o gli errori."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola stanu informują, czy udało się zebrać dane o wpisie, zdrowiu i środowisku. Pola wiadomości wyjaśniają brakujące dane lub błędy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Az állapotmezők jelzik, hogy sikerült-e rögzíteni az adatokat, az Egészség-adatokat és a környezeti adatokat. Az üzenetek a hiányzó adatokat vagy hibákat magyarázzák."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tilakentät kertovat, saatiinko kirjaus-, terveys- ja ympäristötiedot talteen. Viestikentissä kerrotaan puuttuvista tiedoista tai virheistä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Statusfeltene viser om registrering, helsedata og miljødata var tilgjengelige. Meldingsfeltene forklarer manglende data eller feil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Statusfelterne viser, om registrering, sundhedsdata og miljødata var tilgængelige. Meddelelsesfelterne forklarer manglende data eller fejl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля состояния показывают, удалось ли получить данные записи, здоровья и окружающей среды. Поля сообщений поясняют, каких данных не хватает или какие ошибки возникли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de estado indicam se estavam disponíveis os dados do registo, da app Saúde e do ambiente. Os campos de mensagem explicam dados em falta ou erros."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля стану показують, чи були доступні запис, дані Здоров’я та дані про довкілля. Поля повідомлень пояснюють, чого бракувало або які виникли помилки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs d’état indiquent si les données de la note, de Santé et de l’environnement étaient disponibles. Les champs de message précisent les données manquantes ou les erreurs."
          }
        }
      }
    },
    "# This export is for personal tracking and sharing. It does not establish medical facts by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# This export is for personal tracking and sharing. It does not establish medical facts by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Dieser Export dient der persönlichen Dokumentation und zum Teilen. Für sich genommen belegt er keine medizinischen Tatsachen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# このデータは個人での記録や共有を目的としています。それだけで医学的な事実を示すものではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Este archivo está pensado para llevar un registro personal y compartirlo. Por sí solo no establece hechos médicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Questo file serve per il monitoraggio personale e la condivisione. Da solo non stabilisce fatti medici."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ten eksport służy do osobistego monitorowania i udostępniania danych. Sam w sobie nie potwierdza faktów medycznych."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ez az export a személyes követést és megosztást szolgálja. Önmagában nem igazol orvosi tényeket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tämä vienti on tarkoitettu henkilökohtaiseen seurantaan ja jakamiseen. Se ei yksinään vahvista lääketieteellisiä tosiasioita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Denne eksporten er for personlig oppfølging og deling. Den fastslår ikke medisinske fakta i seg selv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Denne eksport er til personlig registrering og deling. Den fastslår ikke i sig selv medicinske forhold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Этот файл предназначен для личного наблюдения и обмена данными. Сам по себе он не подтверждает медицинские факты."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Esta exportação destina-se ao acompanhamento pessoal e à partilha. Por si só, não comprova factos médicos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Цей файл призначено для особистого обліку та поширення. Сам по собі він не підтверджує медичних фактів."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Cette exportation sert au suivi personnel et au partage. Elle ne permet pas, à elle seule, d’établir des faits médicaux."
          }
        }
      }
    },
    "# Time fields include the UTC timestamp, timezone ID, weekday name, hour and minute, and the stable part_of_day value.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Time fields include the UTC timestamp, timezone ID, weekday name, hour and minute, and the stable part_of_day value."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Die Zeitangaben umfassen den UTC-Zeitstempel, die Zeitzonen-ID, den Wochentag, Stunde und Minute sowie den unveränderten Wert part_of_day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# 時刻の項目には、UTCタイムスタンプ、タイムゾーンID、曜日、時、分、固定値のpart_of_dayが含まれます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Los campos de hora incluyen la fecha y hora UTC, el identificador de zona horaria, el día de la semana, la hora, los minutos y el valor fijo part_of_day."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# I campi temporali includono data e ora UTC, identificativo del fuso orario, giorno della settimana, ora, minuti e valore stabile part_of_day."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Pola czasu obejmują znacznik czasu UTC, identyfikator strefy czasowej, dzień tygodnia, godzinę i minutę oraz stałą wartość part_of_day."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# Az időadatok közé tartozik az UTC-időbélyeg, az időzóna-azonosító, a hét napja, az óra és a perc, valamint a rögzített part_of_day érték."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Aikatietoihin kuuluvat UTC-aikaleima, aikavyöhykkeen tunniste, viikonpäivä, tunti ja minuutti sekä muuttumaton part_of_day-arvo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tidsfeltene omfatter UTC-tidsstempel, tidssone-ID, ukedag, time og minutt samt den faste verdien part_of_day."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tidsfelterne omfatter UTC-tidsstempel, tidszone-id, ugedag, time og minut samt den faste værdi part_of_day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля времени включают отметку времени UTC, идентификатор часового пояса, день недели, часы и минуты, а также постоянное значение part_of_day."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Os campos de data e hora incluem a data e hora UTC, o identificador do fuso horário, o dia da semana, a hora e os minutos, e o valor estável part_of_day."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# Поля часу містять часову позначку UTC, ідентифікатор часового поясу, день тижня, годину й хвилину, а також незмінне значення part_of_day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Les champs temporels incluent l’horodatage UTC, l’identifiant du fuseau horaire, le jour de la semaine, l’heure, les minutes et la valeur stable part_of_day."
          }
        }
      }
    },
    "# User notes are optional text you can add when logging or later in History.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# User notes are optional text you can add when logging or later in History."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Notizen sind freiwillige Angaben, die du beim Eintragen oder später im Verlauf hinzufügen kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# メモは、記録時や後から履歴に追加できる任意のテキストです。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Las notas son texto opcional que puedes añadir al registrar un dolor de cabeza o más tarde en Historial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Le note sono facoltative e puoi aggiungerle quando registri un mal di testa o in seguito nella Cronologia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Notatki to opcjonalny tekst, który możesz dodać podczas zapisywania bólu głowy lub później w Historii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# A jegyzetek opcionális szövegek, amelyeket rögzítéskor vagy később az Előzményekben adhatsz hozzá."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Voit lisätä vapaaehtoisen muistiinpanon kirjauksen yhteydessä tai myöhemmin Historia-välilehdellä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Du kan legge til et notat når du registrerer hodepine eller senere i Historikk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Du kan tilføje valgfrie noter, når du registrerer en hovedpine eller senere under Historik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ты можешь добавить заметки при записи головной боли или позже в разделе «История»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# As notas são texto opcional que podes acrescentar ao registar uma dor de cabeça ou mais tarde no separador Histórico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# До запису або пізніше в розділі Історія можна додати нотатку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Vous pouvez ajouter une note au moment de noter un mal de tête ou plus tard dans Historique."
          }
        }
      }
    },
    "# What this file is: one row per time you tapped Headache in the app. Each row is a timestamped snapshot of optional context, not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# What this file is: one row per time you tapped Headache in the app. Each row is a timestamped snapshot of optional context, not a diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zu dieser Datei: Jede Zeile entspricht einem Tipp auf „Kopfschmerz“ in der App und enthält einen zeitgestempelten Ausschnitt optionaler Kontextdaten, keine Diagnose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# このファイルについて: アプリで「頭痛を記録」をタップするたびに1行追加されます。各行は任意の関連データを時刻とともに記録したもので、診断ではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Qué contiene este archivo: una fila por cada vez que tocas «Dolor de cabeza» en la app. Cada fila reúne información contextual opcional con fecha y hora, no es un diagnóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# Contenuto del file: una riga per ogni tocco su «Mal di testa» nell’app. Ogni riga raccoglie dati contestuali facoltativi con data e ora, non è una diagnosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# Zawartość pliku: jeden wiersz dla każdego dotknięcia przycisku „Ból głowy”. Każdy wiersz przedstawia opcjonalne dane z danego momentu, nie jest diagnozą."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "# A fájl tartalma: egy sor az alkalmazásban rögzített minden fejfájásról. A sorok időbélyeggel ellátott pillanatképek a kiegészítő adatokról, nem diagnózisok."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "# Tiedoston sisältö: yksi rivi jokaista sovelluksessa kirjattua päänsärkyä kohden. Rivi sisältää aikaleiman ja valinnaisia taustatietoja, ei diagnoosia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# Om filen: én rad for hver gang du trykket på Hodepine i appen. Hver rad viser et tidsstemplet øyeblikksbilde av valgfrie opplysninger, ikke en diagnose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# Om filen: én række for hver gang du trykkede på Hovedpine i appen. Hver række er et tidsstemplet øjebliksbillede af valgfrie oplysninger, ikke en diagnose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# О файле: одна строка для каждой головной боли, записанной в приложении. В каждой строке сохранены отметка времени и дополнительные данные, а не диагноз."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "# Este ficheiro contém uma linha por cada toque em «Dor de cabeça» na app. Cada linha regista o momento e o contexto opcional, não é um diagnóstico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# У файлі один рядок на кожне натискання кнопки «Головний біль» у програмі. Це запис із часовою позначкою та додатковими даними, а не діагноз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Ce fichier contient une ligne par appui sur le bouton Mal de tête. Chaque ligne est un relevé horodaté de données contextuelles facultatives, pas un diagnostic."
          }
        }
      }
    },
