    "Your answers will help us highlight the headache patterns most relevant to you. You can update them anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers will help us highlight the headache patterns most relevant to you. You can update them anytime in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Antworten werden uns helfen, die für Sie wichtigsten Kopfschmerzen hervorzuheben. Sie können sie jederzeit in den Einstellungen aktualisieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの答えは、あなたに最も関連性の高い頭痛パターンを強調するのに役立ちます。 設定でいつでも更新できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus respuestas nos ayudarán a destacar los patrones de dolor de cabeza más relevantes para usted. Puedes actualizarlos en cualquier momento en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vostre risposte ci aiuteranno a evidenziare i modelli di mal di testa più rilevanti per voi. È possibile aggiornarli in qualsiasi momento in Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi pomogą nam podkreślić wzory bólu głowy najbardziej istotne dla Ciebie. Możesz je aktualizować w dowolnym momencie w Ustawieniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszaid segítenek kiemelni a számodra leginkább fontos fejfájást. A Beállítások bármikor frissíthetik őket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi auttavat meitä korostamaan päänsärkyäsi. Voit päivittää niitä milloin tahansa Asetukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar vil hjelpe oss å fremheve hodepine mønstre mest relevant for deg. Du kan oppdatere dem når som helst i Innstillinger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar vil hjælpe os med at fremhæve de hovedpine mønstre mest relevante for dig. Du kan opdatere dem når som helst i Indstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши ответы помогут нам выделить наиболее актуальные для вас модели головной боли. Вы можете обновить их в любое время в настройках."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas nos ajudarão a destacar os padrões de dor de cabeça mais relevantes para você. Você pode atualizá-los a qualquer momento em Configurações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші відповіді допоможуть вам виділити головні візерунки, найбільш актуальні для вас. Ви можете оновити будь-який час у налаштуваннях."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses nous aideront à mettre en évidence les maux de tête les plus pertinents pour vous. Vous pouvez les mettre à jour à tout moment dans Paramètres."
          }
        }
      }
    },
