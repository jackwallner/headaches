    "Billed through Apple. No charge during the trial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed through Apple. No charge during the trial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rechnung gestellt durch Apple. Keine Anklage während des Prozesses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップルを通して請求. トライアル中は無料です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed a través de Apple. Sin cargos durante el juicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E' stata fatturata tramite Apple. Nessun costo durante il processo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłacone przez Apple. Brak zarzutów podczas procesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple-n keresztül számlázták. Nincs vád a tárgyalás alatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omenan kautta. Ei maksua oikeudenkäynnin aikana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed gjennom Apple. Ingen anklage under rettssaken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbildet gennem Apple. Ingen anklage under retssagen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продается через Apple. Никаких обвинений во время суда."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contado pela Apple. De graça durante o julgamento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводиться через Apple. Не стягується плата під час судового розгляду."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturé par Apple. Aucune accusation pendant le procès."
          }
        }
      }
    },
    "All on-device. Your logs never leave your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All on-device. Your logs never leave your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle On-Device. Ihre Logs verlassen Ihr Telefon nie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのオンデバイス。 ログは電話を離れません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en el dispositivo. Tus registros nunca dejan tu teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto pronto. I tuoi registri non lasciano mai il tuo telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko na urządzeniu. Twoje dzienniki nigdy nie zostawiają telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden eszközzel. A naplói sosem hagyják el a telefonját."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite on päällä. Lokitietosi eivät koskaan jätä puhelintasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt på vakt. Loggene dine forlater aldri telefonen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle på-enhed. Dine logfiler forlader aldrig din telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все на устройстве. Ваши журналы никогда не оставляют ваш телефон."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos em serviço. Os registos nunca deixam o telemóvel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Все на-розробці. Ваші журнали ніколи не залишають свого телефону."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous sur l'appareil. Vos registres ne quittent jamais votre téléphone."
          }
        }
      }
    },
