    "After %@ of sleep, headaches were logged on %lld%% of days, compared with %lld%% across days with sleep data. Median sleep before a headache: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %@ of sleep, headaches were logged on %lld%% of days, compared with %lld%% across days with sleep data. Median sleep before a headache: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %@ Schlaf hast du an %lld%% der Tage einen Eintrag erfasst. Über alle Tage mit Schlafdaten waren es %lld%%. Median vor einem Eintrag: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠が%@の日は、%lld%%の日に頭痛を記録しました。睡眠データがある日全体では%lld%%です。頭痛前の睡眠時間の中央値: %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras dormir %@, registraste dolor de cabeza el %lld%% de los días, frente al %lld%% de los días con datos de sueño. Mediana de sueño antes del dolor de cabeza: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo %@ di sonno, hai registrato mal di testa nel %lld%% dei giorni, rispetto al %lld%% dei giorni con dati sul sonno. Mediana del sonno prima del mal di testa: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %@ snu ból głowy zapisano w %lld%% dni, w porównaniu z %lld%% dni z danymi o śnie. Mediana snu przed bólem głowy: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alvás után a napok %lld%%-án rögzítettél fejfájást, szemben az alvásadatokkal rendelkező napok %lld%%-ával. A fejfájás előtti alvás mediánja: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unen jälkeen päänsärky kirjattiin %lld%% päivänä. Kaikkien unetietoja sisältävien päivien osuus oli %lld%%. Päänsärkyä edeltävän unen mediaani: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter %@ søvn ble hodepine registrert på %lld%% av dagene, mot %lld%% av dagene med søvndata. Median søvn før hodepine: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter %@ søvn blev hovedpine registreret på %lld%% af dagene mod %lld%% af dagene med søvndata. Median søvn før hovedpine: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сна продолжительностью %@ головная боль была записана в %lld%% дней против %lld%% среди дней с данными о сне. Медиана сна перед головной болью: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de dormires %@, as dores de cabeça foram registadas em %lld%% dos dias, comparado com %lld%% dos dias com dados de sono. Mediana do sono antes da dor de cabeça: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після сну тривалістю %@ головний біль записували у %lld%% днів, порівняно з %lld%% серед днів із даними про сон. Медіана сну перед головним болем: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une durée de sommeil de %@, des maux de tête ont été notés %lld%% des jours, contre %lld%% des jours avec des données de sommeil. Durée médiane avant un mal de tête : %@."
          }
        }
      }
    },
