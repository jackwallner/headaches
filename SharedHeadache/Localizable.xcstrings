            "value": "パターン検出のために十分に記録された頭痛はまだ(少なくとも%lldが必要)。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes dolores de cabeza registrados para la detección del patrón (necesita por lo menos %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbastanza mal di testa registrato ancora per il rilevamento del modello (necessario almeno %lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewystarczająca ilość zapisanych bólów głowy do wykrycia wzorca (co najmniej %lld)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem volt elég lappangó fejfájás a minta felismeréséhez (legalább %lld)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tarpeeksi kirjautunut päänsärkyä vielä kuvion havaitsemiseen (tarvitsee vähintään %lld)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok logget hodepine ennå for mønsterdeteksjon (treng i det minste %lld)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok logget hovedpine endnu for mønster detektering (har mindst %lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно зарегистрированных головных болей для выявления паттернов (нужно, по крайней мере, %lld)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dores de cabeça registradas suficientes para detecção de padrões (necessidade de pelo menos %lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вистачає з'єднаних головного болю, але для виявлення шаблонів (не менше %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de céphalées enregistrées pour la détection des patrons (besoin d'au moins %lld)."
          }
        }
      }
    },
    "No single signal yet stands out. Continued logging can show patterns over time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No single signal yet stands out. Continued logging can show patterns over time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Signal fällt noch nicht auf. Fortgesetzte Protokollierung kann Muster im Laufe der Zeit zeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単一信号はまだ消えません。 連続したロギングはパターンを時間通りに見せることができます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay señal. El registro continuo puede mostrar patrones con el tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'e' ancora nessun segnale. Logging continuo può mostrare modelli nel tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden sygnał jeszcze się nie wyróżniał. Ciągłe logowanie może pokazywać wzory z czasem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen jel sem tűnik fel. A folyamatos fakitermelés idővel mintákat mutat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksikään signaali ei erotu. Jatkuva hakkuu voi näyttää kuvioita ajan mittaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen eneste signal ennå skiller seg ut. Fortsatt logging kan vise mønstre over tid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet signal endnu skiller sig ud. Fortsat logning kan vise mønstre over tid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один сигнал пока не выделяется. Продолжение лесозаготовок может показать закономерности с течением времени."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum sinal ainda se destaca. O registro contínuo pode mostrar padrões ao longo do tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає єдиного сигналу. Безперервна логістика може показувати візерунки з часом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal ne ressort encore. La poursuite de l'exploitation peut montrer des modèles au fil du temps."
          }
        }
      }
    },
