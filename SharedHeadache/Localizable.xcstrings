    "Proactive Alerts use the forecast signals shown here for a 12 to 24 hour heads-up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactive Alerts use the forecast signals shown here for a 12 to 24 hour heads-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Proaktive Alarme verwenden die hier gezeigten Prognosesignale für ein 12- bis 24-stündiges Heads-up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロアクティブなアラートは、ここで示されている予測信号を12〜24時間のヘッドアップに使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Alertas Proactivas usan las señales de pronóstico mostradas aquí durante un período de 12 a 24 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi proattivi utilizzano i segnali di previsione mostrati qui per un 12 a 24 ore di heads-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactive Alerts używa sygnałów prognozowanych pokazanych tutaj dla 12 do 24 godzin heads- up."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Proaktív riasztók használja az itt látható előrejelzéseket egy 12-24 órás fej-up."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennakoivat hälytykset käyttävät tässä esitettyjä ennustesignaaleja 12-24 tunnin varoituksen varalta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Proaktive alarmer bruker de prognosesignaler som er vist her i en 12 til 24 timers heads-up."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactive Alerts bruger de prognoser, der vises her for en 12 til 24 timers heads- up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проактивные оповещения используют прогнозные сигналы, показанные здесь, в течение 12-24 часов."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas Proativos usam os sinais de previsão mostrados aqui para 12 a 24 horas de antecedência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проактивні Alerts використовують прогнозні сигнали, які показали тут для 12 до 24 годин."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes proactives utilisent les signaux de prévision indiqués ici pour une alerte de 12 à 24 heures."
          }
        }
      }
    },
