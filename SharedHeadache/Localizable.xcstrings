          "stringUnit": {
            "state": "translated",
            "value": "Avviso quando la pressione è prevista per cadere da"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzeżenie, gdy przewiduje się spadek ciśnienia"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztetés, ha a nyomás várhatóan csökken"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytys, kun paineen ennustetaan laskevan"
          }
        },
