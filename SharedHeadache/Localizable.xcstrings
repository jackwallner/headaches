    "Bring entries in from a backup or another device, using a CSV file exported from this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring entries in from a backup or another device, using a CSV file exported from this app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringen Sie Einträge von einem Backup oder einem anderen Gerät mit einer aus dieser App exportierten CSV-Datei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリからエクスポートされたCSVファイルを使用して、バックアップまたは別のデバイスからエントリを持参してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiga entradas de una copia de seguridad u otro dispositivo, utilizando un archivo CSV exportado desde esta aplicación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portare le voci da un backup o da un altro dispositivo, utilizzando un file CSV esportato da questa applicazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź wpisy z kopii zapasowej lub innego urządzenia, używając pliku CSV wywożonego z tej aplikacji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon be bejegyzéseket egy biztonsági mentésről vagy egy másik eszközről, egy CSV fájlt használva, ami ebből az alkalmazásból származik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo tiedot varmuuskopiosta tai muusta laitteesta käyttäen CSV-tiedostoa, joka viedään tästä sovelluksesta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med oppføringer fra en sikkerhetskopi eller en annen enhet, ved hjelp av en CSV-fil eksportert fra denne appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring poster ind fra en backup eller en anden enhed, ved hjælp af en CSV fil eksporteret fra denne app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите записи из резервной копии или другого устройства, используя файл CSV, экспортированный из этого приложения."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga entradas de um backup ou outro dispositivo, usando um arquivo CSV exportado deste aplicativo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Принесіть записи з резервного копіювання або іншого пристрою, використовуючи файл CSV, що експортується з цього додатка."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apportez les entrées d'une sauvegarde ou d'un autre périphérique, en utilisant un fichier CSV exporté depuis cette application."
