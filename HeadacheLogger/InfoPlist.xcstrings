    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker uses your approximate location to fetch local weather and place context when you log an event."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker verwendet deinen ungefähren Standort, um beim Erfassen eines Eintrags lokale Wetter- und Ortsinformationen abzurufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録時に地域の天気や場所の情報を取得するため、おおよその位置情報を使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker usa tu ubicación aproximada para consultar el tiempo local y datos del lugar cuando registras un episodio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker usa la tua posizione approssimativa per ottenere il meteo locale e informazioni sul luogo quando registri un evento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker używa przybliżonej lokalizacji, aby podczas zapisywania wpisu pobrać lokalną pogodę i informacje o miejscu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker a hozzávetőleges helyadatodat használja, hogy bejegyzéskor lekérje a helyi időjárást és a helyszín adatait."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker käyttää likimääräistä sijaintiasi paikallisen sään ja paikkatietojen hakemiseen kirjauksen yhteydessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker bruker den omtrentlige posisjonen din til å hente lokalt vær og stedsinformasjon når du logger en hendelse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker bruger din omtrentlige position til at hente lokalt vejr og stedoplysninger, når du registrerer en hændelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker использует ваше приблизительное местоположение, чтобы получать местный прогноз погоды и сведения о месте во время записи события."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker utiliza a sua localização aproximada para obter a previsão meteorológica local e informações do local quando regista um episódio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker використовує ваше приблизне місцезнаходження, щоб отримувати місцевий прогноз погоди та відомості про місце під час запису події."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker utilise votre position approximative pour obtenir la météo locale et des informations sur le lieu lorsque vous consignez un événement."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker reads motion and activity data from Apple Health, such as step counts and activity levels, to show context alongside logged headaches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker liest Bewegungs- und Aktivitätsdaten aus Apple Health, etwa Schrittzahl und Aktivitätsniveau, um erfassten Kopfschmerzen Kontext hinzuzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録した頭痛の状況を示すため、歩数や活動レベルなどの動作・アクティビティデータをApple Healthから読み取ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lee de Apple Health datos de movimiento y actividad, como los pasos y el nivel de actividad, para añadir contexto a los dolores de cabeza registrados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker legge da Apple Health i dati di movimento e attività, come i passi e il livello di attività, per aggiungere contesto ai mal di testa registrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker odczytuje z Apple Health dane o ruchu i aktywności, takie jak liczba kroków i poziom aktywności, aby dodać kontekst do zapisanych bólów głowy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker mozgási és aktivitási adatokat, például lépésszámot és aktivitási szintet olvas be az Apple Healthből, hogy kiegészítse a rögzített fejfájások adatait."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lukee Apple Healthista liikkumis- ja aktiivisuustietoja, kuten askelmäärän ja aktiivisuustason, lisätäkseen kontekstia kirjattuihin päänsärkyihin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker leser bevegelses- og aktivitetsdata fra Apple Health, som skritt og aktivitetsnivå, for å legge til kontekst rundt loggført hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker læser bevægelses- og aktivitetsdata fra Apple Health, f.eks. antal skridt og aktivitetsniveau, for at føje kontekst til registreret hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker считывает из Apple Health данные о движении и активности, например число шагов и уровень активности, чтобы добавить контекст к записям о головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker lê dados de movimento e atividade da Apple Health, como passos e nível de atividade, para acrescentar contexto às dores de cabeça registadas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker зчитує з Apple Health дані про рух і активність, наприклад кількість кроків і рівень активності, щоб додати контекст до записів про головний біль."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lit dans Apple Health les données de mouvement et d’activité, comme le nombre de pas et le niveau d’activité, pour ajouter du contexte aux maux de tête consignés."
          }
        }
      }
    }
  },
  "version": "1.0"
}
