{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker reads activity, sleep, heart, and related metrics from Apple Health to attach context when you log an event. The app never writes Health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker liest Aktivitäts-, Schlaf-, Herz- und weitere Daten aus Apple Health, um deine Einträge um Kontext zu ergänzen. Die App schreibt keine Daten in Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録に関連する情報を表示するため、Apple Healthから活動、睡眠、心拍などのデータを読み取ります。Healthへの書き込みは行いません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lee datos de actividad, sueño, corazón y otras métricas de Apple Health para añadir contexto cuando registras un dolor de cabeza. La app nunca escribe datos en Salud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker legge da Apple Health dati di attività, sonno, frequenza cardiaca e altre metriche per aggiungere contesto quando registri un mal di testa. L’app non scrive mai dati in Salute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker odczytuje z Apple Health dane o aktywności, śnie, pracy serca i innych parametrach, aby uzupełnić zapisane wpisy o kontekst. Aplikacja nie zapisuje danych w Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker az Apple Health alkalmazásból olvas aktivitási, alvási, szívvel kapcsolatos és más adatokat, hogy kiegészítse a fejfájás-bejegyzéseidet. Az alkalmazás nem ír adatokat az Apple Healthbe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lukee Apple Healthista aktiivisuus-, uni-, sydän- ja muita tietoja lisätäkseen taustatietoja päänsärkymerkintöihisi. Sovellus ei kirjoita tietoja Apple Healthiin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker leser aktivitets-, søvn-, hjerte- og andre data fra Apple Health for å legge til kontekst i hodepineregistreringene dine. Appen skriver aldri data til Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker læser aktivitets-, søvn-, hjerte- og andre data fra Apple Health for at tilføje kontekst til dine hovedpineregistreringer. Appen skriver aldrig data til Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker считывает из Apple Health данные об активности, сне, работе сердца и другие показатели, чтобы дополнить записи о головной боли. Приложение никогда не записывает данные в Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker lê dados de atividade, sono, coração e outras métricas da app Saúde para acrescentar contexto aos registos. A app nunca escreve dados na Saúde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker читає з програми «Здоров’я» дані про активність, сон, роботу серця та інші показники, щоб доповнити записи про головний біль. Програма ніколи не записує дані у «Здоров’я»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lit dans Santé les données d’activité, de sommeil, cardiaques et d’autres mesures pour ajouter du contexte à vos notes. L’app n’écrit jamais de données dans Santé."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
