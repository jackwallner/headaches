          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker uses your approximate location to fetch local weather and place context when you log an event."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker verwendet deinen ungefähren Standort, um beim Eintragen lokales Wetter und Ortsangaben abzurufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録時に地域の天気や場所名を取得するため、おおよその位置情報を使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker usa tu ubicación aproximada para consultar el tiempo local y el nombre del lugar cuando registras un dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker usa la tua posizione approssimativa per ottenere il meteo locale e il nome del luogo quando registri un mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker korzysta z przybliżonej lokalizacji, aby podczas zapisywania wpisu pobrać lokalną pogodę i nazwę miejsca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker a hozzávetőleges helyzetedet használja, hogy rögzítéskor lekérje a helyi időjárást és a hely nevét."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker käyttää likimääräistä sijaintiasi paikallisen sään ja paikan nimen hakemiseen kirjauksen yhteydessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker bruker den omtrentlige posisjonen din til å hente lokalt vær og stedsnavn når du registrerer hodepine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker bruger din omtrentlige position til at hente lokalt vejr og stednavn, når du registrerer hovedpine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker использует примерное местоположение, чтобы получать местный прогноз погоды и название места во время записи головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker usa a tua localização aproximada para obter a previsão meteorológica local e indicar o local quando registas uma dor de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker використовує приблизне місце розташування, щоб отримувати місцевий прогноз погоди й назву місця під час запису головного болю."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker utilise votre position approximative pour obtenir la météo locale et le nom du lieu lorsque vous notez un mal de tête."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker reads motion and activity data from Apple Health, such as step counts and activity levels, to add context to your headache log."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker liest Bewegungs- und Aktivitätsdaten aus Apple Health, etwa Schritte und Aktivitätslevel, und ergänzt damit deine Einträge um Kontext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録に関連する情報を表示するため、Apple Healthから歩数や活動レベルなどの動作・活動データを読み取ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lee datos de movimiento y actividad de Apple Health, como los pasos y el nivel de actividad, para añadir contexto a tu registro de dolor de cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker legge da Apple Health dati di movimento e attività, come i passi e il livello di attività, per aggiungere contesto alla registrazione del mal di testa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker odczytuje z Apple Health dane o ruchu i aktywności, takie jak liczba kroków i poziom aktywności, aby uzupełnić wpis o bólu głowy o kontekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker az Apple Health mozgási és aktivitási adatait, például a lépésszámot és az aktivitási szintet használja a fejfájás-bejegyzéseid kiegészítésére."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lukee Apple Healthista liikkumis- ja aktiivisuustietoja, kuten askelmäärän ja aktiivisuustason, täydentääkseen päänsärkymerkintöjäsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker leser bevegelses- og aktivitetsdata fra Apple Health, som skritt og aktivitetsnivå, for å legge til kontekst i hodepineregistreringene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker læser bevægelses- og aktivitetsdata fra Apple Health, f.eks. antal skridt og aktivitetsniveau, for at tilføje kontekst til dine hovedpineregistreringer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker считывает из Apple Health данные о движении и активности, например количество шагов и уровень активности, чтобы дополнить записи о головной боли."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker lê dados de movimento e atividade da app Saúde, como passos e atividade física, para acrescentar contexto aos registos de dores de cabeça."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker читає з програми «Здоров’я» дані про рух і активність, наприклад кількість кроків та рівень активності, щоб доповнити записи про головний біль."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lit dans Santé les données de mouvement et d’activité, comme le nombre de pas et le niveau d’activité, pour ajouter du contexte à vos notes de maux de tête."
          }
        }
      }
    }
  },
  "version": "1.0"
}
