{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker reads activity, sleep, heart, and related metrics from Apple Health to attach context when you log an event. The app never writes Health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker liest Aktivitäts-, Schlaf-, Herz- und weitere Messwerte aus Apple Health aus, um deinen Einträgen Kontext hinzuzufügen. Die App schreibt keine Daten in Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Trackerは、記録時に状況情報を追加するため、Apple Healthからアクティビティ、睡眠、心拍数などの指標を読み取ります。Healthにデータを書き込むことはありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lee de Apple Health datos de actividad, sueño, corazón y otras métricas para añadir contexto cuando registras un episodio. La app nunca escribe datos en Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker legge da Apple Health i dati relativi ad attività, sonno, cuore e altre metriche per aggiungere contesto alle registrazioni. L’app non scrive mai dati in Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker odczytuje z Apple Health dane o aktywności, śnie, pracy serca i inne pomiary, aby dodać kontekst do zapisanych wpisów. Aplikacja nigdy nie zapisuje danych w Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A One Tap Headache Tracker aktivitási, alvási, szívvel kapcsolatos és egyéb adatokat olvas be az Apple Healthből, hogy kiegészítse a bejegyzéseidet. Az app soha nem ír adatot a Healthbe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lukee Apple Healthista aktiivisuus-, uni-, sydän- ja muita mittaustietoja lisätäkseen kirjauksiin kontekstia. Appi ei koskaan kirjoita tietoja Healthiin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker leser aktivitets-, søvn-, hjerte- og andre målinger fra Apple Health for å legge til kontekst når du logger en hendelse. Appen skriver aldri data til Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker læser aktivitets-, søvn-, hjerte- og andre målinger fra Apple Health for at tilføje kontekst, når du registrerer en hændelse. Appen skriver aldrig data til Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker считывает из Apple Health данные об активности, сне, работе сердца и другие показатели, чтобы добавить контекст к вашим записям. Приложение никогда не записывает данные в Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O One Tap Headache Tracker lê dados de atividade, sono, coração e outras métricas da Apple Health para acrescentar contexto aos registos. A app nunca escreve dados na Health."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker зчитує з Apple Health дані про активність, сон, роботу серця та інші показники, щоб додати контекст до ваших записів. Застосунок ніколи не записує дані в Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Tap Headache Tracker lit dans Apple Health les données d’activité, de sommeil, cardiaques et d’autres mesures pour ajouter du contexte à vos saisies. L’app n’écrit jamais de données dans Health."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
